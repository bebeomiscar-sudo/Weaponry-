-- ═══════════════════════════════════════════════════════════════════════
-- TROVE (lightweight connection/instance manager)
-- ═══════════════════════════════════════════════════════════════════════
local Trove = {}
Trove.__index = Trove

function Trove.new(tag)
    return setmetatable({
        _tag    = tag or "Trove",
        _items  = {},
        _conns  = {},
    }, Trove)
end

function Trove:Add(obj)
    table.insert(self._items, obj)
    return obj
end

function Trove:Connect(signal, fn)
    local conn = signal:Connect(fn)
    table.insert(self._conns, conn)
    return conn
end

function Trove:Clean()
    for _, conn in ipairs(self._conns) do
        pcall(function() conn:Disconnect() end)
    end
    self._conns = {}
    for _, item in ipairs(self._items) do
        if type(item) == "function" then
            pcall(item)
        elseif typeof(item) == "Instance" then
            pcall(function() item:Destroy() end)
        elseif type(item) == "table" and item.Destroy then
            pcall(function() item:Destroy() end)
        end
    end
    self._items = {}
end

function Trove:Destroy()
    self:Clean()
end

-- ═══════════════════════════════════════════════════════════════════════
-- GUARDED INSTANCE
-- Watches a Roblox instance and re-applies overrides if game changes them
-- ═══════════════════════════════════════════════════════════════════════
local GuardedInstance = {}
GuardedInstance.__index = GuardedInstance

function GuardedInstance.new(target)
    local self = setmetatable({
        _trove     = Trove.new("GuardedInstance"),
        _target    = target,
        _originals = {},
        _overrides = {},
        _isWriting = false,
    }, GuardedInstance)

    self._trove:Connect(target.Changed, function(prop)
        if self._isWriting then return end
        if self._overrides[prop] == nil then return end
        self._originals[prop] = target[prop]
        self._isWriting = true
        target[prop]    = self._overrides[prop]
        self._isWriting = false
    end)

    return self
end

function GuardedInstance:SetOverride(prop, value)
    local target = self._target
    if self._originals[prop] == nil then
        self._originals[prop] = target[prop]
    end
    self._overrides[prop] = value
    self._isWriting = true
    pcall(function() target[prop] = value end)
    self._isWriting = false
end

function GuardedInstance:ClearOverride(prop)
    local orig = self._originals[prop]
    if orig == nil then return end
    self._originals[prop] = nil
    self._overrides[prop] = nil
    self._isWriting = true
    pcall(function() self._target[prop] = orig end)
    self._isWriting = false
end

function GuardedInstance:ClearAllOverrides()
    self._isWriting = true
    for prop in pairs(self._overrides) do
        local orig = self._originals[prop]
        self._originals[prop] = nil
        self._overrides[prop] = nil
        pcall(function() self._target[prop] = orig end)
    end
    self._isWriting = false
end

function GuardedInstance:Destroy()
    self:ClearAllOverrides()
    self._trove:Destroy()
end

