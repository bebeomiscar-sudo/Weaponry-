local function isHoldingMelee(player)
    local char = player.Character
    if not char then return false, nil end
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            for mw, _ in pairs(meleeWeaponSet) do
                if name:find(mw) then return true, item.Name end
            end
        end
    end
    return false, nil
end

local function distToPlayer(player)
    local myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    local tHRP  = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP or not tHRP then return math.huge end
    return (myHRP.Position - tHRP.Position).Magnitude
end

