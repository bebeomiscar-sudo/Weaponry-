local TCR={enabled=false,color=Color3.fromRGB(255,255,255),duration=3,thickness=1,fadeTime=0.5,lerpSpeed=0,style="Line"}
local tcTracers={};local tcConn=nil;local tcEffectHooked=false;local tcLastCreations={};local TC_DEDUPE_INT=0.1;local TC_DEDUPE_EXPIRY=1.0
local TC_TEXTURES={Line="",Beam="rbxassetid://12781852245",Lightning="rbxassetid://446111271",Heartrate="rbxassetid://5830549480",Chain="rbxassetid://9632168658",Glitch="rbxassetid://8089467613",Swirl="rbxassetid://5638168605",Neon="rbxassetid://6361963422",Plasma="rbxassetid://8993645509",Laser="rbxassetid://14549123968"}
local TC_STYLES={"Line","Beam","Lightning","Heartrate","Chain","Glitch","Swirl","Neon","Plasma","Laser"}
local function tcMuzzlePos() local vms=ws:FindFirstChild("ViewModels"); if not vms then return nil end; local fp=vms:FindFirstChild("FirstPerson"); if not fp then return nil end; for _,mdl in ipairs(fp:GetChildren()) do if mdl:IsA("Model") then local iv=mdl:FindFirstChild("ItemVisual"); if not iv then continue end; local body=iv:FindFirstChild("Body"); if not body then continue end; local bp=body:FindFirstChild("BodyPrimary"); if not bp then continue end; local mz=bp:FindFirstChild("_muzzle"); if mz and mz:IsA("Attachment") then return mz.WorldPosition end end end; return nil end
local function tcDrawEnd(tr,age) if TCR.lerpSpeed<=0 then return tr.endPos end; local dt2=math.max(TCR.lerpSpeed*0.25,0.001); local prog=math.clamp(age/dt2,0,1); return tr.startPos:Lerp(tr.endPos,prog) end
local function tcMakeLine(s,e) local ol=Drawing.new("Line"); ol.Thickness=4*TCR.thickness; ol.Color=Color3.new(0,0,0); ol.Transparency=1; ol.Visible=false; local ln=Drawing.new("Line"); ln.Thickness=2*TCR.thickness; ln.Color=TCR.color; ln.Transparency=1; ln.Visible=false; table.insert(tcTracers,{isLine=true,outline=ol,line=ln,startPos=s,endPos=e,lifetime=TCR.duration,fadeTime=TCR.fadeTime,born=tick()}) end
local function tcMakeBeam(s,e) local a0=Instance.new("Attachment"); a0.Parent=ws.Terrain; local a1=Instance.new("Attachment"); a1.Parent=ws.Terrain; local beam=Instance.new("Beam"); beam.Attachment0=a0; beam.Attachment1=a1; beam.Color=ColorSequence.new(TCR.color); local bw=TCR.style=="Laser" and 0.02 or 0.15; beam.Width0=bw*TCR.thickness; beam.Width1=bw*TCR.thickness; beam.Transparency=NumberSequence.new(0); beam.FaceCamera=true; beam.LightEmission=0.8; beam.LightInfluence=0.2; local tex=TC_TEXTURES[TCR.style]; if tex and tex~="" then beam.Texture=tex; beam.TextureLength=4; beam.TextureSpeed=1 else beam.Texture=""; beam.TextureLength=1; beam.TextureSpeed=0 end; beam.Parent=ws.Terrain; a0.WorldPosition=s; a1.WorldPosition=e; table.insert(tcTracers,{isLine=false,beam=beam,a0=a0,a1=a1,startPos=s,endPos=e,lifetime=TCR.duration,fadeTime=TCR.fadeTime,born=tick()}) end
local function tcSpawn(s,e) if not TCR.enabled or not s or not e then return end; local kx=math.floor(s.X*5+0.5);local ky=math.floor(s.Y*5+0.5);local kz=math.floor(s.Z*5+0.5);local ex=math.floor(e.X*5+0.5);local ey=math.floor(e.Y*5+0.5);local ez=math.floor(e.Z*5+0.5);local key=kx*1e9+ky*1e6+kz*1e3+ex+ey*1e-3+ez*1e-6;local now=tick();local last=tcLastCreations[key];if last and(now-last)<TC_DEDUPE_INT then return end;tcLastCreations[key]=now;if TCR.style=="Line" then tcMakeLine(s,e) else tcMakeBeam(s,e) end end
local function tcDestroy(t) if t.isLine then if t.outline then t.outline:Remove() end; if t.line then t.line:Remove() end else if t.beam then t.beam:Destroy() end; if t.a0 then t.a0:Destroy() end; if t.a1 then t.a1:Destroy() end end end
local tcFrame=0
local function tcUpdate() if #tcTracers==0 then return end; tcFrame+=1; local now=tick(); if tcFrame%120==0 then for k,t in next,tcLastCreations do if(now-t)>TC_DEDUPE_EXPIRY then tcLastCreations[k]=nil end end end; local i=#tcTracers; while i>=1 do local tr=tcTracers[i];local age=now-tr.born;if age>=tr.lifetime then tcDestroy(tr);tcTracers[i]=tcTracers[#tcTracers];tcTracers[#tcTracers]=nil else local fadeAlpha;local fs=tr.lifetime-tr.fadeTime;if age>=fs then fadeAlpha=1-math.clamp((age-fs)/tr.fadeTime,0,1) else fadeAlpha=1 end;local de=tcDrawEnd(tr,age);if tr.isLine then local s2,onS=cam:WorldToViewportPoint(tr.startPos);local e2,onE=cam:WorldToViewportPoint(de);if onS and onE then local dx=e2.X-s2.X;local dy=e2.Y-s2.Y;local len=math.sqrt(dx*dx+dy*dy);if len>0.1 and len<3000 then local fs2=Vector2.new(s2.X,s2.Y);local fe2=Vector2.new(e2.X,e2.Y);tr.outline.From=fs2;tr.outline.To=fe2;tr.outline.Transparency=fadeAlpha;tr.outline.Visible=true;tr.line.From=fs2;tr.line.To=fe2;tr.line.Transparency=fadeAlpha;tr.line.Visible=true else tr.outline.Visible=false;tr.line.Visible=false end else tr.outline.Visible=false;tr.line.Visible=false end else if tr.a0 then tr.a0.WorldPosition=tr.startPos end;if tr.a1 then tr.a1.WorldPosition=de end;tr.beam.Transparency=NumberSequence.new(1-fadeAlpha) end end;i-=1 end end
local function tcHookEffect() if tcEffectHooked then return end; pcall(function() local TE=require(lp.PlayerScripts.Modules.TracerEffect);local origPlay=TE.Play;TE.Play=function(self,tracerData,config2,extraData) if TCR.enabled and tracerData and tracerData.IsLocal and tracerData.RaycastResults then local mPos=tcMuzzlePos();if mPos then for _,hit in ipairs(tracerData.RaycastResults) do if hit.Position then tcSpawn(mPos,hit.Position) end end end end;return origPlay(self,tracerData,config2,extraData) end;tcEffectHooked=true end) end
local function tcStart() tcHookEffect(); if not tcConn then tcConn=rs.RenderStepped:Connect(tcUpdate) end end
local function tcStop() if tcConn then tcConn:Disconnect();tcConn=nil end;for _,t in ipairs(tcTracers) do tcDestroy(t) end;tcTracers={} end
task.defer(function() tcStart();for _=1,30 do if tcEffectHooked then break end;tcHookEffect();task.wait(0.5) end end)

