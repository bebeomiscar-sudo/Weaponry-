-- CORNER OUTLINE (box ESP corner-bracket style)
-- ═══════════════════════════════════════════════════════════════════════
local CornerOutline = {}
CornerOutline.__index = CornerOutline

function CornerOutline.new(parent)
    local self = setmetatable({
        _corners     = {},
        _enabled     = false,
        _innerColor  = Color3.new(1,1,1),
        _outlineColor= Color3.new(0,0,0),
        _look        = LookEnum.None,
    }, CornerOutline)

    local THICK = 3
    local INSET = 1
    local INNER = THICK - 2 * INSET

    local positions = {
        { hAnchor = Vector2.new(0,0), vAnchor = Vector2.new(0,0),
          hPos = UDim2.fromOffset(0,0),    vPos = UDim2.fromOffset(0,0) },
        { hAnchor = Vector2.new(1,0), vAnchor = Vector2.new(1,0),
          hPos = UDim2.fromScale(1,0),     vPos = UDim2.fromScale(1,0) },
        { hAnchor = Vector2.new(1,1), vAnchor = Vector2.new(1,1),
          hPos = UDim2.fromScale(1,1),     vPos = UDim2.fromScale(1,1) },
        { hAnchor = Vector2.new(0,1), vAnchor = Vector2.new(0,1),
          hPos = UDim2.fromScale(0,1),     vPos = UDim2.fromScale(0,1) },
    }

    local BRACKET_LEN = 0.25 -- 25% of box width/height

    for i, pos in ipairs(positions) do
        local function makeFrame(isHoriz)
            local f = Instance.new("Frame")
            f.BorderSizePixel       = 0
            f.BackgroundTransparency = 1
            f.Interactable          = false
            f.ZIndex                = 10
            f.AnchorPoint           = isHoriz and pos.hAnchor or pos.vAnchor
            f.Position              = isHoriz and pos.hPos    or pos.vPos
            f.Size                  = isHoriz
                and UDim2.new(BRACKET_LEN, 0, 0, INNER)
                or  UDim2.new(0, INNER, BRACKET_LEN, 0)
            f.Parent = parent
            return f
        end

        local hColor = makeFrame(true)
        local vColor = makeFrame(false)
        local hBacker = makeFrame(true)
        local vBacker = makeFrame(false)

        hColor.BackgroundTransparency  = 1
        vColor.BackgroundTransparency  = 1
        hBacker.BackgroundTransparency = 1
        vBacker.BackgroundTransparency = 1

        hBacker.ZIndex = 9
        vBacker.ZIndex = 9
        hBacker.BackgroundColor3 = Color3.new(0,0,0)
        vBacker.BackgroundColor3 = Color3.new(0,0,0)

        self._corners[i] = {
            horizontalColor  = hColor,
            verticalColor    = vColor,
            horizontalBacker = hBacker,
            verticalBacker   = vBacker,
        }
    end

    return self
end

function CornerOutline:SetEnabled(state)
    self._enabled = state
    for _, corner in ipairs(self._corners) do
        local vis = state
        corner.horizontalColor.Visible  = vis
        corner.verticalColor.Visible    = vis
        corner.horizontalBacker.Visible = vis
        corner.verticalBacker.Visible   = vis
    end
end

function CornerOutline:SetOutlineColor(color)
    self._outlineColor = color
    for _, corner in ipairs(self._corners) do
        corner.horizontalBacker.BackgroundColor3 = color
        corner.verticalBacker.BackgroundColor3   = color
    end
end

function CornerOutline:SetLook(color, look)
    self._innerColor = color
    self._look       = look or LookEnum.None
    for _, corner in ipairs(self._corners) do
        corner.horizontalColor.BackgroundColor3 = color
        corner.verticalColor.BackgroundColor3   = color
        corner.horizontalColor.BackgroundTransparency = 0
        corner.verticalColor.BackgroundTransparency   = 0
        corner.horizontalBacker.BackgroundTransparency = 0
        corner.verticalBacker.BackgroundTransparency   = 0
    end
end

function CornerOutline:Destroy()
    for _, corner in ipairs(self._corners) do
        for _, f in pairs(corner) do f:Destroy() end
    end
end

-- ═══════════════════════════════════════════════════════════════════════
-- STROKE OUTLINE (UIStroke based)
-- ═══════════════════════════════════════════════════════════════════════
local StrokeOutline = {}
StrokeOutline.__index = StrokeOutline

function StrokeOutline.new(parent)
    local self = setmetatable({
        _enabled     = false,
        _innerColor  = Color3.new(1,1,1),
        _outlineColor= Color3.new(0,0,0),
        _look        = LookEnum.None,
    }, StrokeOutline)

    -- Outer stroke (dark border)
    local outerStroke = Instance.new("UIStroke")
    outerStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    outerStroke.LineJoinMode    = Enum.LineJoinMode.Miter
    outerStroke.Thickness       = 3
    outerStroke.Color           = Color3.new(0,0,0)
    outerStroke.Enabled         = false
    outerStroke.Parent          = parent
    self._outerStroke = outerStroke

    -- Inner frame
    local inner = Instance.new("Frame")
    inner.BackgroundTransparency = 1
    inner.BorderSizePixel        = 0
    inner.Interactable           = false
    inner.Size                   = UDim2.fromScale(1,1)
    inner.Parent                 = parent
    self._inner = inner

    -- Inner stroke (colored line)
    local innerStroke = Instance.new("UIStroke")
    innerStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    innerStroke.LineJoinMode    = Enum.LineJoinMode.Miter
    innerStroke.Thickness       = 1
    innerStroke.Color           = Color3.new(1,1,1)
    innerStroke.Enabled         = false
    innerStroke.Parent          = inner
    self._innerStroke = innerStroke

    -- Gradient for shimmer
    local grad = Instance.new("UIGradient")
    grad.Enabled = false
    grad.Parent  = innerStroke
    self._innerStrokeGradient = grad

    return self
end

function StrokeOutline:SetEnabled(state)
    self._enabled = state
    self._outerStroke.Enabled = state
    self._innerStroke.Enabled = state
end

function StrokeOutline:SetOutlineColor(color)
    self._outlineColor   = color
    self._outerStroke.Color = color
end

function StrokeOutline:SetLook(color, look)
    self._innerColor     = color
    self._look           = look or LookEnum.None
    local kind           = self._look.kind
    local grad           = self._innerStrokeGradient

    if kind == "Shimmer" then
        local shimmer = look.shimmerColor or Color3.new(1,1,1)
        grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   shimmer),
            ColorSequenceKeypoint.new(0.5, color),
            ColorSequenceKeypoint.new(1,   shimmer),
        })
        grad.Rotation = 45
        grad.Enabled  = true
        self._innerStroke.Color = Color3.new(1,1,1)
    else
        grad.Enabled = false
        self._innerStroke.Color = color
    end

    self._innerStroke.Transparency = 0
end

function StrokeOutline:Destroy()
    self._inner:Destroy()
    self._outerStroke:Destroy()
end

-- ═══════════════════════════════════════════════════════════════════════
-- BOUNDING BOX (per-player ESP box)
-- ═══════════════════════════════════════════════════════════════════════
local BoundingBox = {}
BoundingBox.__index = BoundingBox

function BoundingBox.new(screenGui)
    local self = setmetatable({
        _visible      = false,
        _style        = "Full",
        _outline      = nil,
        _innerColor   = Color3.fromRGB(255,50,50),
        _outlineColor = Color3.fromRGB(0,0,0),
        _look         = LookEnum.None,
        _screenGui    = screenGui,
    }, BoundingBox)

    local outer = Instance.new("Frame")
    outer.Visible                = false
    outer.BackgroundTransparency = 1
    outer.BorderSizePixel        = 0
    outer.Interactable           = false
    outer.Parent                 = screenGui
    self._outer = outer

    self:SetStyle("Full")
    return self
end

function BoundingBox:SetStyle(style)
    if style == self._style and self._outline ~= nil then return end
    if self._outline then self._outline:Destroy() end

    local outline
    if style == "Corner" then
        outline = CornerOutline.new(self._outer)
    else
        outline = StrokeOutline.new(self._outer)
    end

    self._outline = outline
    self._style   = style
    outline:SetOutlineColor(self._outlineColor)
    outline:SetEnabled(self._visible)
    outline:SetLook(self._innerColor, self._look)
end

function BoundingBox:SetEnabled(state)
    self._visible = state
    self._outer.Visible = state
    if self._outline then self._outline:SetEnabled(state) end
end

function BoundingBox:SetLook(color, look)
    self._innerColor = color
    self._look       = look or LookEnum.None
    if self._outline then
        self._outline:SetLook(color, self._look)
    end
end

function BoundingBox:SetOutlineColor(color)
    self._outlineColor = color
    if self._outline then self._outline:SetOutlineColor(color) end
end

--[[
    Update: repositions the box to wrap the character's bounding box
    called every RenderStep while player is visible
]]
function BoundingBox:Update(character)
    if not self._visible or not character then return end

    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local anyOnScreen = false

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and SKELETON_PARTS[part.Name] then
            local sp, onScreen = cam:WorldToViewportPoint(part.Position)
            if onScreen and sp.Z > 0 then
                anyOnScreen = true
                minX = math.min(minX, sp.X - part.Size.X * 30)
                maxX = math.max(maxX, sp.X + part.Size.X * 30)
                minY = math.min(minY, sp.Y - part.Size.Y * 30)
                maxY = math.max(maxY, sp.Y + part.Size.Y * 30)
            end
        end
    end

    if not anyOnScreen then
        self._outer.Visible = false
        return
    end

    self._outer.Visible  = true
    self._outer.Position = UDim2.fromOffset(minX, minY)
    self._outer.Size     = UDim2.fromOffset(maxX - minX, maxY - minY)
end

function BoundingBox:Destroy()
    if self._outline then self._outline:Destroy() end
    self._outer:Destroy()
end

