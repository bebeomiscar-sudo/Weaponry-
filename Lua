    VoidState.priorityConn = RunService.Heartbeat:Connect(function()
        if not PriorityCfg.enabled then return end
        pcall(updatePriorityScores)
        if HvHCfg.standoffEnabled or HvHCfg.rejectDesyncJump or HvHCfg.rejectJitter then
            for _, p in ipairs(Players:GetPlayers()) do
                if p == lp then continue end
                if not p.Character then continue end
                pcall(function()
                    if HvHCfg.rejectDesyncJump and detectDesyncJump(p) then
                        getOrCreateHistory(p).score += HvHCfg.standoffWeight * 0.5
                    end
                    if HvHCfg.rejectJitter and detectJitter(p) then
                        getOrCreateHistory(p).score += HvHCfg.standoffWeight * 0.3
                    end
                end)
            end
        end
    end)
end

