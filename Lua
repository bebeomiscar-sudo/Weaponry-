local function startVoidSpam()
    stopVoidSpam()
    VoidState.hbConn = RunService.Heartbeat:Connect(function()
        if not VoidState.enabled then return end
        local hrp = getHRP()
        if not hrp then return end
        VoidState.hrp      = hrp
        VoidState.clientCF = hrp.CFrame
        VoidState.clientLV = hrp.AssemblyLinearVelocity
        VoidState.clientAV = hrp.AssemblyAngularVelocity

        pcall(function()
            if VoidState.adaptEnabled and VoidState.adaptTarget then
                local tChar = VoidState.adaptTarget.Character
                local tHRP  = tChar and tChar:FindFirstChild("HumanoidRootPart")
                if tHRP then
                    VoidState.orbitAngle = (
                        VoidState.orbitAngle + ORBIT_SPEED * 0.016
                    ) % (math.pi * 2)
                    local ox = math.cos(VoidState.orbitAngle) * ORBIT_RADIUS
                    local oz = math.sin(VoidState.orbitAngle) * ORBIT_RADIUS
                    hrp.CFrame = CFrame.new(
                        tHRP.Position.X + ox,
                        VOID_HEIGHT,
                        tHRP.Position.Z + oz
                    ) * CFrame.Angles(math.pi, math.pi, math.pi)
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        betterRandom(-500, 500, -100, 100),
                        betterRandom(-500, 500, -100, 100),
                        betterRandom(-500, 500, -100, 100)
                    )
                    hrp.AssemblyAngularVelocity = Vector3.new(
                        betterRandom(-50, 50, -10, 10),
                        betterRandom(-50, 50, -10, 10),
                        betterRandom(-50, 50, -10, 10)
                    )
                    if VoidState.teleDesync then
                        pcall(function()
                            tHRP.CFrame = CFrame.new(tHRP.Position.X, VOID_HEIGHT, tHRP.Position.Z)
                        end)
                    end
                else
                    VoidState.adaptTarget = getBestTarget()
                end
            else
                hrp.CFrame = CFrame.new(
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H),
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H),
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H)
                ) * CFrame.Angles(math.pi, math.pi, math.pi)
                hrp.AssemblyLinearVelocity = Vector3.new(
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H),
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H),
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H)
                )
                hrp.AssemblyAngularVelocity = Vector3.new(
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H),
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H),
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H)
                )
            end
        end)
    end)

    RunService:BindToRenderStep(
        "__vsSync",
        Enum.RenderPriority.First.Value,
        function()
            if not VoidState.enabled then return end
            local hrp = VoidState.hrp
            if not hrp then return end
            pcall(function()
                hrp.CFrame                  = VoidState.clientCF
                hrp.AssemblyLinearVelocity  = VoidState.clientLV
                hrp.AssemblyAngularVelocity = VoidState.clientAV
            end)
        end
    )
end

