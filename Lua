-- SILENT AIM
-- ============================================================

local SilentAimController = {}
SilentAimController.__index = SilentAimController

function SilentAimController.new()
    local self  = setmetatable({}, SilentAimController)
    self._trove = Trove.new("silentaim")
    self._hook  = nil

    self:_HookRemote()
    return self
end

function SilentAimController:_GetBestTarget()
    local cam     = workspace.CurrentCamera
    local vp      = cam.ViewportSize
    local cx, cy  = vp.X / 2, vp.Y / 2
    local maxDist = Config.SilentAim.FOV
    local bone    = Config.SilentAim.Bone
    local best, bestDist = nil, math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then continue end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end
        local part = char:FindFirstChild(bone) or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end
        local s, visible = cam:WorldToViewportPoint(part.Position)
        if not visible or s.Z <= 0 then continue end
        local dist = math.sqrt((s.X - cx)^2 + (s.Y - cy)^2)
        if dist < maxDist and dist < bestDist then
            bestDist = dist
            best     = part
        end
    end
    return best
end

-- Hook the camera to redirect bullets.
-- This approach patches the Camera CFrame read so that the
-- game thinks it's aiming at the target.
function SilentAimController:_HookRemote()
    -- We hook FireServer on all RemoteEvents in the char's tool
    -- to redirect the direction argument.
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    self._trove:Connect(LocalPlayer.CharacterAdded, function(newChar)
        self:_HookRemote()
    end)

    self._trove:Connect(RunService.PreRender, function()
        if not Config.SilentAim.Enabled then return end
        local target = self:_GetBestTarget()
        if not target then return end

        -- Nudge camera slightly toward target each frame
        -- (silent redirect: server receives adjusted direction)
        local cam     = workspace.CurrentCamera
        local origin  = cam.CFrame.Position
        local aimDir  = (target.Position - origin).Unit
        local pitch   = math.asin(-aimDir.Y)
        local yaw     = math.atan2(-aimDir.X, -aimDir.Z)
        -- Store for use in shot injection — does not move the visible camera
        self._aimCFrame = CFrame.new(origin)
            * CFrame.Angles(0, yaw, 0)
            * CFrame.Angles(pitch, 0, 0)
    end)
end

function SilentAimController:Destroy()
    self._trove:Destroy()
end

