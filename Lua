                .."\nv3Free: "..(AntiKiciaCfg.v3FreeDetected and "YES" or "no")
                .." | v3Prem: "..(AntiKiciaCfg.v3PremDetected and "YES" or "no")
            )
            or (#lines>0 and table.concat(lines,"\n") or "No KiciaHook detected")
        )
    end)
end)

