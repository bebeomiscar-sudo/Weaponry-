-- =============================================

local function stopTeleDesync()
    VoidState.teleDesync=false
    if VoidState.teleDesyncConn then VoidState.teleDesyncConn:Disconnect(); VoidState.teleDesyncConn=nil end
end

local function startTeleDesync()
    stopTeleDesync(); VoidState.teleDesync=true
    VoidState.teleDesyncConn = RunService.Heartbeat:Connect(function()
        if not VoidState.teleDesync then return end
        local hrp = getHRP()
        if not hrp then return end
        local tgt = VoidState.adaptTarget or getBestTarget()
        if not tgt then return end
        local tChar = tgt.Character
        if not tChar then return end
        local tHRP = tChar:FindFirstChild("HumanoidRootPart")
        if not tHRP then return end
        pcall(function()
            local angle = VoidState.orbitAngle
            tHRP.CFrame = hrp.CFrame * CFrame.new(math.cos(angle)*(ORBIT_RADIUS*0.5), 0, math.sin(angle)*(ORBIT_RADIUS*0.5))
        end)
    end)
end

-- =============================================
--   FIRETOUCH
-- =============================================

local function stopFireTouch()
    VoidState.fireTouchEnabled=false
    if VoidState.ftLoopConn then VoidState.ftLoopConn:Disconnect(); VoidState.ftLoopConn=nil end
end

local function startFireTouch()
    stopFireTouch()
    if not firetouchinterest then
        notify("FireTouch","firetouchinterest not available!",5)
        VoidState.fireTouchEnabled=false; return
    end
    VoidState.fireTouchEnabled=true
    VoidState.ftLoopConn = RunService.Heartbeat:Connect(function()
        if not VoidState.fireTouchEnabled then return end
        local hrp = getHRP()
        if not hrp then return end
        local tP = VoidState.adaptTarget or getBestTarget()
        if not tP then return end
        local tChar = tP.Character
        if not tChar then return end
        local useUE, realHBPos = false, nil
        if UECfg.counterEnabled then
            local isUE, hbPos = detectUEPattern(tP)
            if isUE then useUE=true; realHBPos=hbPos end
        end
        local realCF=hrp.CFrame; local realLV=hrp.AssemblyLinearVelocity; local realAV=hrp.AssemblyAngularVelocity
        pcall(function() hrp.CFrame = CFrame.new(hrp.Position.X, VOID_HEIGHT, hrp.Position.Z) end)
        task.wait(0.05)
        local projectiles=scanProjectiles(); local hitboxes=getHitboxes(tChar)
        if #projectiles > 0 and #hitboxes > 0 then
            local offsets={
                Vector3.new(0,0,0),Vector3.new(5,0,0),Vector3.new(-5,0,0),
                Vector3.new(0,5,0),Vector3.new(0,-5,0),Vector3.new(10,0,0),Vector3.new(-10,0,0),
            }
            for _, proj in ipairs(projectiles) do
                for _, hbox in ipairs(hitboxes) do
                    for _, off in ipairs(offsets) do
                        pcall(function()
                            hrp.CFrame = CFrame.new((useUE and realHBPos or hrp.Position)+off)
                            fireTouchOnPart(proj, hbox)
                        end)
                    end
                end
            end
        end
        pcall(function() hrp.CFrame=realCF; hrp.AssemblyLinearVelocity=realLV; hrp.AssemblyAngularVelocity=realAV end)
    end)
end

