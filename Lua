-- MODULE: EvasionSystem
-- ═══════════════════════════════════════════════════════════════════════
local EvasionSystem = {}
EvasionSystem.__index = EvasionSystem

function EvasionSystem.new(oobKiller)
    return setmetatable({
        _oobKiller        = oobKiller,
        _lastReposition   = 0,
        _anchorPos        = nil,
    }, EvasionSystem)
end

function EvasionSystem:_GetEnvironmentID()
    local id = nil
    pcall(function()
        id = lp:GetAttribute("EnvironmentID")
    end)
    return id
end

function EvasionSystem:ComputeEvasionCFrame(myHRP, targetHRP)
    local mode = RagebotConfig.Evasion.Mode
    local cfg  = RagebotConfig.Evasion

    if mode == "Random" then
        return self:_RandomEvasion(myHRP, cfg.Random)

    elseif mode == "ProjectileBreaker" then
        return self:_ProjectileBreakerEvasion(myHRP, targetHRP, cfg.ProjectileBreaker)

    elseif mode == "Translocate" then
        local envID = self:_GetEnvironmentID()
        local killPos = self._oobKiller:GetKillPosition(
            envID,
            cfg.Translocate.Offset
        )
        return CFrame.new(killPos)
    end

    -- Fallback: stay in place
    return myHRP.CFrame
end

function EvasionSystem:_RandomEvasion(myHRP, cfg)
    local now = os.clock()
    local interval = RagebotConfig.Evasion.ProjectileBreaker.RepositionInterval

    if now - self._lastReposition < interval then
        -- Return last computed position
        if self._anchorPos then
            return CFrame.new(self._anchorPos)
        end
    end

    self._lastReposition = now

    local anchor = cfg.AnchorFromCharacter
        and myHRP.Position
        or Vector3.zero

    local radius = cfg.BaseRadius
        * (1 + (math.random() - 0.5) * cfg.RadiusRandomFactor * 2)

    local angle = math.random() * math.pi * 2
    local offset = Vector3.new(
        math.cos(angle) * radius,
        0,
        math.sin(angle) * radius
    )

    self._anchorPos = anchor + offset
    return CFrame.new(self._anchorPos)
end

function EvasionSystem:_ProjectileBreakerEvasion(myHRP, targetHRP, cfg)
    local now = os.clock()

    if now - self._lastReposition < cfg.RepositionInterval then
        if self._anchorPos then
            return CFrame.new(self._anchorPos)
        end
    end

    self._lastReposition = now

    -- Try to position behind cover relative to target
    local hasTarget = targetHRP ~= nil
    if hasTarget then
        local toTarget = (targetHRP.Position - myHRP.Position)
        local dist = toTarget.Magnitude

        if dist > 0.01 then
            local dir     = toTarget.Unit
            local upDir   = Vector3.new(0, 1, 0)
            local sideDir = dir:Cross(upDir).Unit

            -- Position above + forward relative to target direction
            local newPos = myHRP.Position
                + upDir    * cfg.DepthUp
                + dir      * cfg.DepthForward

            -- Raycast to check if position is valid
            local rpParams = RaycastParams.new()
            rpParams.FilterType = Enum.RaycastFilterType.Exclude
            rpParams.FilterDescendantsInstances = {
                lp.Character
            }
            local hit = Workspace:Raycast(
                myHRP.Position,
                (newPos - myHRP.Position),
                rpParams
            )

            if not hit then
                self._anchorPos = newPos
                return CFrame.new(newPos)
            end
        end
    end

    -- Fallback: random position in radius at height
    local angle  = math.random() * math.pi * 2
    local radius = cfg.FallbackRadius
    local pos    = myHRP.Position + Vector3.new(
        math.cos(angle) * radius,
        cfg.FallbackHeight,
        math.sin(angle) * radius
    )

    self._anchorPos = pos
    return CFrame.new(pos)
end

