--   HVH CONFIG
-- =============================================

local HvHCfg = {
    standoffEnabled  = false,
    standoffWeight   = 5000,
    rejectDesyncJump = false,
    desyncSpeed      = 800,
    rejectJitter     = false,
    jitterRadius     = 15,
}

local hvhOpponents = {}

local function getOrCreateHvH(p)
    if not hvhOpponents[p] then
        hvhOpponents[p] = {
            lastPos=Vector3.zero, posHistory={},
            jitterDetected=false, desyncJumps=0, lastTick=tick(),
        }
    end
    return hvhOpponents[p]
end

local function detectDesyncJump(player)
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local opp   = getOrCreateHvH(player)
    local now   = tick()
    local dt    = now - opp.lastTick
    if dt <= 0 then return false end
    local speed = (hrp.Position - opp.lastPos).Magnitude / dt
    opp.lastPos = hrp.Position; opp.lastTick = now
    if speed > HvHCfg.desyncSpeed then opp.desyncJumps += 1; return true end
    return false
end

local function detectJitter(player)
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local opp = getOrCreateHvH(player)
    local now = tick()
    table.insert(opp.posHistory, {pos=hrp.Position, t=now})
    local trimmed = {}
    for _, e in ipairs(opp.posHistory) do
        if now - e.t <= 0.3 then table.insert(trimmed, e) end
    end
    opp.posHistory = trimmed
    if #trimmed < 3 then return false end
    local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
    for _, e in ipairs(trimmed) do
        minX=math.min(minX,e.pos.X); maxX=math.max(maxX,e.pos.X)
        minZ=math.min(minZ,e.pos.Z); maxZ=math.max(maxZ,e.pos.Z)
    end
    local isJitter = (maxX-minX)<HvHCfg.jitterRadius and (maxZ-minZ)<HvHCfg.jitterRadius and #trimmed>=4
    opp.jitterDetected = isJitter
    return isJitter
end

