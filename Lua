-- MODULE: OOBKiller — FIXED (stale _processedParts, no env validation)
-- ═══════════════════════════════════════════════════════════════════════
local OOBKiller = {}
OOBKiller.__index = OOBKiller

function OOBKiller.new()
    return setmetatable({
        --[[
            FIX: Use weak keys so destroyed parts
            are auto-removed from processedParts
        ]]
        _processedParts    = setmetatable({}, { __mode = "k" }),
        _pool              = {},
        _poolEnvironmentID = nil,
        _nextCooldown      = -1,
    }, OOBKiller)
end

--[[
    FIX: Validate environment ID before using cached pool
    Clears pool if environment changed (map reload/new round)
]]
function OOBKiller:_ValidatePool(environmentID)
    if self._poolEnvironmentID ~= environmentID then
        table.clear(self._pool)
        table.clear(self._processedParts)
        self._poolEnvironmentID = environmentID
    end
end

function OOBKiller:_ScanParts(environmentID)
    self:_ValidatePool(environmentID)
    if #self._pool > 0 then return end

    -- Scan workspace for OutOfBoundsPart with KillDelay == 0
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v.Name == "OutOfBoundsPart"
        and v:IsA("BasePart")
        and not self._processedParts[v] then
            local kd = v:GetAttribute("KillDelay")
            if kd == 0 then
                self._processedParts[v] = true
                table.insert(self._pool, v)
            end
        end
    end
end

function OOBKiller:GetKillPosition(environmentID, offset)
    self:_ScanParts(environmentID)

    if #self._pool > 0 then
        local part     = self._pool[math.random(1, #self._pool)]
        local safeOffset = offset or RagebotConfig.Evasion.Translocate.Offset
        return part.Position + safeOffset
    end

    -- Fallback: random ring at ±1073741824
    local axes    = { Vector3.xAxis, Vector3.zAxis }
    local chosen  = axes[math.random(1, #axes)]
    local sign    = math.random(0,1) == 0 and 1 or -1
    return chosen * (1073741824 * sign)
end

