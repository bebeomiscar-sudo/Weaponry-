local RagebotService = {}

function RagebotService:Init()
    self.active    = false
    self.debounce  = false
    self.lastShot  = os.clock()
    self.connection= nil
    self.orbitTheta= 0
    self.orbitPos  = nil
    self.orbitConn = nil
end

function RagebotService:IsValid(player)
    if not (player and player.Character
        and player.Character:FindFirstChild("Humanoid")
        and player.Character.Humanoid.Health > 0
        and player:GetAttribute("EnvironmentID") == local_player:GetAttribute("EnvironmentID")) then
        return false
    end
    if CFG.ragebot.ffa_mode then return true end
    return local_player:GetAttribute("TeamID") ~= player:GetAttribute("TeamID")
end

function RagebotService:GetClosest()
    local closest, best = nil, math.huge
    for _, p in next, players:GetPlayers() do
        if p ~= local_player and self:IsValid(p) then
            local rootpos = p.Character.HumanoidRootPart.Position
            local mag = local_player:DistanceFromCharacter(rootpos)
            if mag < best then closest,best=p,mag end
        end
    end
    return closest
end

function RagebotService:StartOrbit(target)
    if self.orbitConn then self.orbitConn:Disconnect(); self.orbitConn=nil end
    self.orbitTheta = 0
    self.orbitConn = run_service.Heartbeat:Connect(function(dt)
        if not CFG.ragebot.enable or not target or not target.Character then
            self.orbitConn:Disconnect(); self.orbitConn=nil; return
        end
        local root = target.Character:FindFirstChild("HumanoidRootPart")
        if not root then return end
        self.orbitTheta = self.orbitTheta + dt * 6
        local ox = CFG.ragebot.offset_x
        local oy = CFG.ragebot.offset_y
        local oz = CFG.ragebot.offset_z
        local orbitPos = root.Position
            + Vector3.new(math.cos(self.orbitTheta) * ox, oy, math.sin(self.orbitTheta) * oz)
        self.orbitPos = orbitPos
        -- teleport local HRP to orbit position (server-side position desync)
        local myChar = local_player.Character
        local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myHRP then
            pcall(function() myHRP.CFrame = CFrame.new(orbitPos) end)
        end
    end)
end

function RagebotService:FireWeapon(target)
    if not target or not target.Character then return end
    if not fighter_controller or not enum_lib or not utility_lib then return end
    local fighter = fighter_controller.LocalFighter; if not fighter then return end
    local item = fighter.EquippedItem; if not item then return end

    local head = target.Character:FindFirstChild("HitboxHead")
        or target.Character:FindFirstChild("HitboxTorso")
        or target.Character:FindFirstChild("HumanoidRootPart")
    if not head then return end

    local myChar = local_player.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end

    local shootPos = self.orbitPos or myChar.HumanoidRootPart.Position
    local aimPos   = head.Position

    if CFG.ragebot.prediction then
        local troot = target.Character:FindFirstChild("HumanoidRootPart")
        if troot then
            local ping = 0.05
            pcall(function() ping = local_player:GetNetworkPing() end)
            local lead = math.clamp(ping, 0, 0.4) * (CFG.ragebot.prediction_amt or 1.2)
            aimPos = aimPos + troot.AssemblyLinearVelocity * lead
        end
    end

    local oid = item:Get("ObjectID"); if not oid then return end
    local data = {
        [utf8.char(1)] = {
            [utf8.char(0)] = utility_lib:EncodeCFrame(CFrame.new(shootPos, aimPos)),
            [utf8.char(1)] = utility_lib:EncodeCFrame(CFrame.new(shootPos, aimPos)),
            [utf8.char(2)] = head,
            [utf8.char(3)] = utility_lib:EncodeCFrame(CFrame.new(shootPos, aimPos)),
        },
    }

    pcall(function()
        rep_storage.Remotes.Replication.Fighter.UseItem:FireServer(
            oid, enum_lib:ToEnum("StartShooting"), data, nil
        )
    end)
end

function RagebotService:Start()
    if self.connection then return end
    self.active = true

    -- slingshot projectile handler
    workspace_.DescendantAdded:Connect(function(child)
        if not CFG.ragebot.enable then return end
        if child:IsA("BasePart") or child:IsA("Model") then
            if child.Name=="Slingshot" or child.Name=="CoreProjectile" or child.Name=="OuterProjectile" then
                task.spawn(function()
                    task.wait(0.03)
                    local proj = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
                    if not proj then return end
                    proj.CanTouch = true
                    for i=1,45 do
                        if not CFG.ragebot.enable then break end
                        local t = self:GetClosest()
                        if t and t.Character then
                            local hp = t.Character:FindFirstChild("HitboxHead") or t.Character:FindFirstChild("HumanoidRootPart")
                            if hp and hp:IsA("BasePart") and hp.Parent and proj.Parent
                                and hp:IsDescendantOf(workspace_) and proj:IsDescendantOf(workspace_) then
                                pcall(firetouchinterest, hp, proj, 0)
                                pcall(firetouchinterest, hp, proj, 1)
                            end
                        end
                        task.wait()
                    end
                end)
            end
        end
    end)

    self.connection = run_service.Heartbeat:Connect(function()
        if not CFG.ragebot.enable then self:Stop(); return end
        if not fighter_controller or not enum_lib or not utility_lib then return end

        local target = self:GetClosest()
        if not target then
            if self.orbitConn then self.orbitConn:Disconnect(); self.orbitConn=nil end
            return
        end

        local fighter = fighter_controller.LocalFighter; if not fighter then return end
        local item = fighter.EquippedItem; if not item then return end

        -- check ammo
        local ammo = nil
        pcall(function() ammo = item:Get("CurrentAmmo") or item:Get("Ammo") end)
        local outOfAmmo = ammo ~= nil and ammo <= 0

        if outOfAmmo then
            -- trigger reload
            pcall(function()
                setthreadidentity(2)
                item:Input("StartReloading")
                setthreadidentity(7)
            end)
            if self.orbitConn then self.orbitConn:Disconnect(); self.orbitConn=nil end
            return
        end

        -- start orbit if not running
        if not self.orbitConn then
            self:StartOrbit(target)
        end

        -- debounce: wait 0.5s on first lock before shooting
        if self.debounce == false then
            self.debounce = os.clock() + 0.5; return
        end
        if typeof(self.debounce)=="number" and os.clock() < self.debounce then return end
        if typeof(self.debounce)=="number" then self.debounce = true end

        if self.orbitPos then
            self.lastShot = os.clock()
            self:FireWeapon(target)
        end
    end)
end

function RagebotService:Stop()
    if self.connection then self.connection:Disconnect(); self.connection=nil end
    if self.orbitConn  then self.orbitConn:Disconnect();  self.orbitConn=nil  end
    self.active   = false
    self.debounce = false
    self.orbitPos = nil
    -- restore HRP position
    pcall(function()
        local myChar = local_player.Character
        local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myHRP and myChar:FindFirstChild("SpawnLocation") == nil then
            -- let physics restore naturally — don't force a bad position
        end
    end)
end

