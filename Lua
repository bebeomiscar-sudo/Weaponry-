--[[
    HOW VOID LURE WORKS:

    Step 1 — PHANTOM BEACON
    We CS-teleport ourselves to appear near the enemy
    On their screen: we look like we're standing still
    On our screen: we're safe in void
    Result: They try to teleport/aim at our "position"

    Step 2 — BAIT POSITION
    We place a fake "bait" position near us
    The enemy's ragebot/voidspam adapt locks onto it
    (They orbit our bait position thinking we're there)

    Step 3 — SNAP TRAP
    When we detect the enemy HRP has teleported
    CLOSE to our real position (within snap radius):
    → Instantly fire FireTouchInterest on them
    → Instant kill before they can shoot

    Step 4 — RESET
    Move bait position, repeat
]]

local LureCfg = {
    enabled        = false,
    baitEnabled    = false,
    snapEnabled    = false,
    phantomEnabled = false,

    -- Bait position offset from real position
    baitOffsetX    = 0,
    baitOffsetY    = 0,
    baitOffsetZ    = 0,

    -- How close enemy must be to trigger snap trap
    snapRadius     = 15,

    -- How long to wait after snap before firing
    snapDelay      = 0.05,

    -- Phantom beacon broadcast rate
    beaconRate     = 0.1,

    -- Lure target
    lureTarget     = nil,

    -- State
    snapTriggered  = false,
    snapCount      = 0,
    lastSnapTick   = 0,
    baitPosition   = Vector3.zero,

    -- Connections
    lureConn       = nil,
    snapConn       = nil,
    phantomConn    = nil,
    beaconConn     = nil,
}

-- Real position storage (where we actually are)
local realPosition = Vector3.zero
local baitPart     = nil -- Invisible part used as bait anchor

-- Create invisible bait anchor part
local function createBaitPart()
    if baitPart then
        pcall(function() baitPart:Destroy() end)
    end
    local part = Instance.new("Part")
    part.Name         = "VoidBait"
    part.Size         = Vector3.new(0.1, 0.1, 0.1)
    part.Transparency = 1
    part.CanCollide   = false
    part.Anchored     = true
    part.CastShadow   = false
    part.Parent       = Workspace
    baitPart = part
    return part
end

-- Update bait position relative to real position
local function updateBaitPosition()
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    realPosition = hrp.Position
    local baitPos = realPosition + Vector3.new(
        LureCfg.baitOffsetX,
        LureCfg.baitOffsetY,
        LureCfg.baitOffsetZ
    )
    LureCfg.baitPosition = baitPos
    if baitPart then
        pcall(function() baitPart.CFrame = CFrame.new(baitPos) end)
    end
end

-- Phantom Beacon:
-- CS-broadcast our bait position to enemy
-- Makes us appear to be at bait spot on their screen
local function startPhantomBeacon()
    if LureCfg.phantomConn then
        LureCfg.phantomConn:Disconnect()
        LureCfg.phantomConn = nil
    end

    LureCfg.phantomConn = RunService.Heartbeat:Connect(function()
        if not LureCfg.phantomEnabled then return end

        local tgt = LureCfg.lureTarget
        if not tgt then return end
        local tChar = tgt.Character
        if not tChar then return end
        local tHRP = tChar:FindFirstChild("HumanoidRootPart")
        if not tHRP then return end

        -- Move their HRP to bait position ON THEIR SCREEN
        -- (client side teleport)
        -- From their perspective: we appear at bait position
        -- From our perspective: they are moving toward bait
        pcall(function()
            -- We CS teleport the enemy to appear near bait
            -- This tricks their adapt/ragebot to lock onto bait
            tHRP.CFrame = CFrame.new(LureCfg.baitPosition)
        end)
    end)
end

local function stopPhantomBeacon()
    LureCfg.phantomEnabled = false
    if LureCfg.phantomConn then
        LureCfg.phantomConn:Disconnect()
        LureCfg.phantomConn = nil
    end
end

-- SNAP TRAP:
-- Watch for enemy HRP to enter snap radius
-- When they get close: INSTANT kill
local function startSnapTrap()
    if LureCfg.snapConn then
        LureCfg.snapConn:Disconnect()
        LureCfg.snapConn = nil
    end

    LureCfg.snapConn = RunService.Heartbeat:Connect(function()
        if not LureCfg.snapEnabled then return end
        local now = tick()
        if now - LureCfg.lastSnapTick < 0.5 then return end

        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        -- Check all enemies
        for _, p in ipairs(Players:GetPlayers()) do
            if p == lp then continue end
            local char = p.Character
            if not char then continue end
            local tHRP = char:FindFirstChild("HumanoidRootPart")
            if not tHRP then continue end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end

            -- Check distance to our REAL position
            local distToReal = (tHRP.Position - realPosition).Magnitude
            -- Check distance to bait position
            local distToBait = (tHRP.Position - LureCfg.baitPosition).Magnitude

            local triggered = distToReal < LureCfg.snapRadius
                           or distToBait < LureCfg.snapRadius

            if triggered then
                LureCfg.snapTriggered = true
                LureCfg.snapCount    += 1
                LureCfg.lastSnapTick  = now
                LureCfg.lureTarget    = p

                notify("SNAP TRAP", "TRIGGERED on " .. p.Name .. "! Firing...", 2)

                -- INSTANT FIRE SEQUENCE
                task.spawn(function()
                    -- Step 1: Save real position
                    local savedCF = hrp.CFrame
                    local savedLV = hrp.AssemblyLinearVelocity
                    local savedAV = hrp.AssemblyAngularVelocity

                    -- Step 2: CS teleport US to them
                    -- (appear right on top of them)
                    pcall(function()
                        hrp.CFrame = tHRP.CFrame
                    end)

                    task.wait(LureCfg.snapDelay)

                    -- Step 3: Lift to void for FireTouch
                    pcall(function()
                        hrp.CFrame = CFrame.new(
                            tHRP.Position.X,
                            VOID_HEIGHT,
                            tHRP.Position.Z
                        )
                    end)

                    task.wait(0.05)

                    -- Step 4: Fire on all hitboxes
                    if firetouchinterest then
                        local projs = {}
                        for _, v in ipairs(Workspace:GetChildren()) do
                            if v.Name == "CoreProjectile" then
                                table.insert(projs, v)
                            end
                        end

                        local hitboxes = {}
                        local hbPriority = {
                            "HitBoxHeadSmall","HitBoxHead",
                            "HitBoxBody","Head","UpperTorso"
                        }
                        for _, name in ipairs(hbPriority) do
                            local part = char:FindFirstChild(name)
                            if part then table.insert(hitboxes, part) end
                        end

                        -- Fire multiple times for reliability
                        for attempt = 1, 3 do
                            for _, proj in ipairs(projs) do
                                for _, hbox in ipairs(hitboxes) do
                                    pcall(function()
                                        local ti = nil
                                        for _, child in ipairs(proj:GetChildren()) do
                                            if child.ClassName == "TouchTransmitter"
                                            or child.ClassName == "TouchInterest" then
                                                ti = child; break
                                            end
                                        end
                                        if ti then
                                            pcall(firetouchinterest, hbox, ti, 0)
                                            pcall(firetouchinterest, hbox, ti, 1)
                                        end
                                    end)
                                end
                            end
                            task.wait(0.02)
                        end
                    end

                    -- Step 5: Restore real position
                    pcall(function()
                        hrp.CFrame                  = savedCF
                        hrp.AssemblyLinearVelocity  = savedLV
                        hrp.AssemblyAngularVelocity = savedAV
                    end)
                end)
            end
        end
    end)
end

local function stopSnapTrap()
    LureCfg.snapEnabled = false
    if LureCfg.snapConn then
        LureCfg.snapConn:Disconnect()
        LureCfg.snapConn = nil
    end
end

-- LURE MAIN LOOP
-- Continuously update bait position + monitor enemy positions
local function startLureLoop()
    if LureCfg.lureConn then
        LureCfg.lureConn:Disconnect()
        LureCfg.lureConn = nil
    end

    createBaitPart()

    LureCfg.lureConn = RunService.Heartbeat:Connect(function()
        if not LureCfg.enabled then return end

        -- Update bait position
        pcall(updateBaitPosition)

        -- Auto-select lure target if none
        if not LureCfg.lureTarget or not LureCfg.lureTarget.Character then
            LureCfg.lureTarget = nil
            -- Pick a void player or nearest
            local best, bd = nil, math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p == lp then continue end
                local char = p.Character
                if not char then continue end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then continue end
                local tHRP = char:FindFirstChild("HumanoidRootPart")
                if not tHRP then continue end
                -- Prefer void players
                local pos  = tHRP.Position
                local dist = math.sqrt(pos.X^2 + pos.Y^2 + pos.Z^2)
                local score = dist > 10000 and 1 or 0 -- void players score 1
                local nearDist = (realPosition - tHRP.Position).Magnitude
                if score > 0 or nearDist < bd then
                    bd   = nearDist
                    best = p
                end
            end
            LureCfg.lureTarget = best
        end
    end)
end

local function stopLureLoop()
    if LureCfg.lureConn then
        LureCfg.lureConn:Disconnect()
        LureCfg.lureConn = nil
    end
    stopPhantomBeacon()
    stopSnapTrap()
    if baitPart then
        pcall(function() baitPart:Destroy() end)
        baitPart = nil
    end
    LureCfg.enabled = false
end

-- =============================================
--   PRIORITY CONFIG
-- =============================================

local PriorityCfg = {
    enabled         = false,
    voidWeight      = 500,
    voidDistance    = 2000,
    historyWindow   = 1.0,
    timeDecay       = 0.5,
    outlierZThresh  = 2.0,
    confidenceScale = 10,
}

local playerHistory = {}

local function getOrCreateHistory(p)
    if not playerHistory[p] then
        playerHistory[p] = {
            score      = 0,
            lastSeen   = tick(),
            voidEvents = {},
            inVoid     = false,
            confidence = 0,
            isOutlier  = false,
        }
    end
    return playerHistory[p]
end

local function isInVoid(player)
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local pos  = hrp.Position
    return math.sqrt(pos.X^2 + pos.Y^2 + pos.Z^2) > PriorityCfg.voidDistance
end

local function updatePriorityScores()
    local now = tick()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        local hist = getOrCreateHistory(p)
        local dt   = now - hist.lastSeen
        hist.lastSeen = now

        hist.score = math.max(hist.score * (1 - PriorityCfg.timeDecay * dt), 0)

        if isInVoid(p) then
            if not hist.inVoid then
                hist.inVoid = true
                hist.score  = hist.score + PriorityCfg.voidWeight
                table.insert(hist.voidEvents, now)
            else
                hist.score = hist.score + PriorityCfg.voidWeight * 0.01
            end
        else
            hist.inVoid = false
        end

        local newEvents = {}
        for _, t in ipairs(hist.voidEvents) do
            if now - t <= PriorityCfg.historyWindow then
                table.insert(newEvents, t)
            end
        end
        hist.voidEvents = newEvents
        hist.confidence = math.clamp(#hist.voidEvents * PriorityCfg.confidenceScale, 0, 100)

        local scores = {}
        for _, ph in pairs(playerHistory) do
            table.insert(scores, ph.score)
        end
        local mean, variance = 0, 0
        for _, s in ipairs(scores) do mean += s end
        mean = mean / math.max(#scores, 1)
        for _, s in ipairs(scores) do variance += (s - mean)^2 end
        variance = variance / math.max(#scores, 1)
        local std = math.sqrt(variance)
        local z   = std > 0 and (hist.score - mean) / std or 0
        hist.isOutlier = z >= PriorityCfg.outlierZThresh
    end
end

local function getVoidPriorityTarget()
    local best, bestScore = nil, -1
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        local hist = playerHistory[p]
        if hist and hist.score > bestScore then
            bestScore = hist.score
            best      = p
        end
    end
    return best
end

-- =============================================
--   HVH CONFIG
-- =============================================

local HvHCfg = {
    standoffEnabled  = false,
    standoffWeight   = 5000,
    rejectDesyncJump = false,
    desyncSpeed      = 800,
    rejectJitter     = false,
    jitterRadius     = 15,
}

local hvhOpponents = {}

local function getOrCreateHvH(p)
    if not hvhOpponents[p] then
        hvhOpponents[p] = {
            lastPos        = Vector3.zero,
            posHistory     = {},
            jitterDetected = false,
            desyncJumps    = 0,
            lastTick       = tick(),
        }
    end
    return hvhOpponents[p]
end

local function detectDesyncJump(player)
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local opp   = getOrCreateHvH(player)
    local now   = tick()
    local dt    = now - opp.lastTick
    if dt <= 0 then return false end
    local speed = (hrp.Position - opp.lastPos).Magnitude / dt
    opp.lastPos  = hrp.Position
    opp.lastTick = now
    if speed > HvHCfg.desyncSpeed then
        opp.desyncJumps += 1
        return true
    end
    return false
end

local function detectJitter(player)
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local opp = getOrCreateHvH(player)
    local now = tick()
    table.insert(opp.posHistory, {pos = hrp.Position, t = now})
    local trimmed = {}
    for _, entry in ipairs(opp.posHistory) do
        if now - entry.t <= 0.3 then table.insert(trimmed, entry) end
    end
    opp.posHistory = trimmed
    if #trimmed < 3 then return false end
    local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
    for _, entry in ipairs(trimmed) do
        minX = math.min(minX, entry.pos.X); maxX = math.max(maxX, entry.pos.X)
        minZ = math.min(minZ, entry.pos.Z); maxZ = math.max(maxZ, entry.pos.Z)
    end
    local isJitter = (maxX-minX) < HvHCfg.jitterRadius
                 and (maxZ-minZ) < HvHCfg.jitterRadius
                 and #trimmed >= 4
    opp.jitterDetected = isJitter
    return isJitter
end

