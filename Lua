                    EXPLOSIVE BULLETS
    ═══════════════════════════════════════════════════════
]]

Connections.Explosive = RunService.Heartbeat:Connect(function()
    if not Config.Special.Explosive then return end
    
    pcall(function()
        for _, obj in pairs(Workspace:GetChildren()) do
            if obj.Name == "Bullet" or obj.Name == "Projectile" then
                obj.Touched:Connect(function(hit)
                    if hit.Parent:FindFirstChild("Humanoid") then
                        local explosion = Instance.new("Explosion")
                        explosion.Position = hit.Position
                        explosion.BlastRadius = Config.Special.ExplosionRadius
                        explosion.BlastPressure = Config.Special.ExplosionDamage * 1000
                        explosion.Parent = Workspace
                    end
                end)
            end
        end
    end)
end)

