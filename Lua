-- ═══════════════════════════════════════════
-- ANTI-CHEAT BYPASS
-- 1. setmetatable weak table poison
-- 2. ClientAlert spoof + namecall intercept
-- 3. Kick block (namecall + direct hookfunction)
-- 4. getgc filter (hide LC3/MiscCtrl from AC scans)
-- 5. LC3 + MiscellaneousController function neutering
-- 6. GC function staller
-- 7. Descriptor scan (disable AC-named scripts)
-- NOTE: challenge-response layer disabled — was causing
--       race condition on load (Error 267). Layers 1-6
--       handle detection without echoing heartbeats.
-- ═══════════════════════════════════════════
pcall(function()
    local _cr = cloneref or function(o) return o end
    local _plr = _cr(game:GetService("Players"))
    local _rep = _cr(game:GetService("ReplicatedStorage"))
    local _rf  = _cr(game:GetService("ReplicatedFirst"))
    local _lp  = _plr.LocalPlayer

    local _targets = {"LocalScript3", "MiscellaneousController"}
    local _ban_consts = {
        "TakeTheL","ban","kick","Kick","Shutdown",
        "ClientAlert","MiscellaneousController"
    }

    -- 1. setmetatable weak table poison
    local _old_setmt; _old_setmt = hookfunction(getrenv().setmetatable, newcclosure(function(tbl, mt)
        if mt and typeof(mt) == "table" and rawget(mt, "__mode") == "kv" then
            local tr = debug.traceback()
            for _, t in ipairs(_targets) do
                if tr:find(t) then
                    return _old_setmt({1,2,3}, {})
                end
            end
        end
        return _old_setmt(tbl, mt)
    end))

    -- 2. ClientAlert spoof
    local _fakeAlert = Instance.new("RemoteEvent")
    _fakeAlert.Name   = "ClientAlert"
    _fakeAlert.Parent = _lp

    local _lpmt = getrawmetatable(_lp)
    local _old_lp_nc = _lpmt.__namecall
    setreadonly(_lpmt, false)
    _lpmt.__namecall = newcclosure(function(self, ...)
        local m = getnamecallmethod()
        if m == "WaitForChild" or m == "FindFirstChild" then
            if select(1, ...) == "ClientAlert" then return _fakeAlert end
        end
        return _old_lp_nc(self, ...)
    end)
    setreadonly(_lpmt, true)

    -- 3. Kick block via namecall
    local _gmt = getrawmetatable(game)
    local _old_game_nc = _gmt.__namecall
    setreadonly(_gmt, false)
    _gmt.__namecall = newcclosure(function(self, ...)
        local m  = getnamecallmethod()
        local ml = m:lower()
        if (self == _lp or ml == "shutdown") and (ml == "kick" or ml == "shutdown") then
            return
        end
        if m == "FireServer" and self == _fakeAlert then
            return
        end
        return _old_game_nc(self, ...)
    end)
    setreadonly(_gmt, true)

    -- Kick block via direct hookfunction (belt + suspenders)
    for _, name in ipairs({"Kick", "kick"}) do
        pcall(function()
            local fn = _lp[name]
            if type(fn) ~= "function" then return end
            local _old_kick; _old_kick = hookfunction(fn, newcclosure(function(self, ...)
                if self == _lp then return nil end
                return _old_kick(self, ...)
            end))
        end)
    end

    -- 4. getgc filter
    local _old_getgc = getgc
    getgc = function(...)
        local gc = _old_getgc(...)
        local out = {}
        for _, v in ipairs(gc) do
            if typeof(v) == "function" then
                local src = debug.info(v, "s")
                local hide = false
                if src then
                    for _, t in ipairs(_targets) do
                        if src:find(t) then hide = true; break end
                    end
                end
                if not hide then table.insert(out, v) end
            else
                table.insert(out, v)
            end
        end
        return out
    end

    -- 5. LC3 + MiscellaneousController neutering via getgc
    local _ac_script = _rf:WaitForChild("LocalScript3", 10)
    local _neutered  = 0

    for _, f in ipairs(_old_getgc(false)) do
        if typeof(f) ~= "function" then continue end
        local ok_e, env = pcall(getfenv, f)
        if not ok_e or type(env) ~= "table" then continue end
        local scr = rawget(env, "script")
        if not scr or typeof(scr) ~= "Instance" then continue end
        local sname = tostring(scr)
        local is_target = (scr == _ac_script)
            or sname:find("LoadingScreen")
            or sname:find("MiscellaneousController")
        if not is_target then continue end
        local ok_c, consts = pcall(debug.getconstants, f)
        if not ok_c or type(consts) ~= "table" then continue end
        for _, k in ipairs(consts) do
            if typeof(k) == "string" then
                for _, b in ipairs(_ban_consts) do
                    if k:find(b) then
                        pcall(function()
                            hookfunction(f, newcclosure(function() return nil end))
                            _neutered += 1
                        end)
                        break
                    end
                end
            end
        end
    end

    -- 6. GC function staller
    for _, v in ipairs(getgc()) do
        if typeof(v) ~= "function" then continue end
        local src = debug.info(v, "s")
        if not src then continue end
        for _, t in ipairs(_targets) do
            if src:find(t) then
                pcall(function()
                    hookfunction(v, newcclosure(function() return task.wait(9e9) end))
                end)
            end
        end
    end

    -- 7. Challenge-response layer — DISABLED
    -- Caused Error 267 race condition: client_id empty on first heartbeat,
    -- malformed echo = server kick. Layers 1-6 neuter LC3 before it can
    -- run the challenge loop anyway. Re-enable if Rivals patches neuter layer.
    -- task.spawn(function() ... end)

    -- 8. Descriptor scan — disable AC-named scripts
    coroutine.wrap(function()
        local _ac_tags = {
            "anticheat","ac","detection","ban","kick","security","moderation"
        }
        local function _proc(o)
            pcall(function()
                if o:IsA("LocalScript") or o:IsA("ModuleScript") then
                    local nm = o.Name:lower()
                    for _, tag in ipairs(_ac_tags) do
                        if nm:find(tag) then
                            pcall(function() o.Disabled = true end)
                            break
                        end
                    end
                end
            end)
        end
        pcall(function()
            for _, v in ipairs(game:GetDescendants()) do _proc(v) end
            game.DescendantAdded:Connect(_proc)
        end)
    end)()

    print("[v3] AC Bypass: " .. _neutered .. " funcs neutered — all 8 layers active")
end)

