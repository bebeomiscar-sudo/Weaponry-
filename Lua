-- MODULE: WeaponAction — FIXED (infinite OnEmpty swap loop)
-- ═══════════════════════════════════════════════════════════════════════
local WeaponAction = {}
WeaponAction.__index = WeaponAction

function WeaponAction.new(mFig, mEnum, rUseItem)
    return setmetatable({
        _mFig     = mFig,
        _mEnum    = mEnum,
        _rUseItem = rUseItem,
    }, WeaponAction)
end

--[[
    Gets current equipped item from LocalFighter
    Returns: item, objectID, type ("Gun"|"Melee"|"Other")
]]
function WeaponAction:GetItem()
    local lf = nil
    pcall(function()
        if self._mFig then lf = self._mFig.LocalFighter end
    end)
    if not lf then return nil, nil, nil end

    local item = lf.EquippedItem
    if not item then return nil, nil, nil end

    local oid  = nil
    local itype = "Other"

    pcall(function() oid = item:Get("ObjectID") end)

    -- Determine type from item properties
    local ok, isGun = pcall(function()
        return item:Get("IsGun") or item.IsGun
    end)
    if ok and isGun then itype = "Gun" end

    local ok2, isMelee = pcall(function()
        return item:Get("IsMelee") or item.IsMelee
    end)
    if ok2 and isMelee then itype = "Melee" end

    return item, oid, itype
end

--[[
    FIX: OnEmpty Swap tracked with attempt counter
    to prevent infinite loop when all weapons empty
]]
function WeaponAction:HandleOnEmpty(lf, oid)
    local onEmpty = RagebotConfig.Weapons.OnEmpty
    if onEmpty == "None" then return false end

    if onEmpty == "Reload" then
        pcall(function()
            self._rUseItem:FireServer(
                oid,
                self._mEnum:ToEnum("Reload"),
                {}, nil
            )
        end)
        return true
    end

    if onEmpty == "Swap" then
        local items = {}
        pcall(function()
            if lf.Items then
                for _, it in pairs(lf.Items) do
                    table.insert(items, it)
                end
            end
        end)

        --[[
            FIX: Track attempts — if all items empty
            give up instead of infinite swap
        ]]
        local attempts = 0
        local maxAttempts = #items

        for _, it in ipairs(items) do
            attempts += 1
            if attempts > maxAttempts then
                return false -- all empty, give up
            end
            local ammo = nil
            pcall(function() ammo = it:Get("CurrentAmmo") end)
            if ammo == nil or ammo > 0 then
                -- This item has ammo — equip it
                local swapOid = nil
                pcall(function() swapOid = it:Get("ObjectID") end)
                if swapOid then
                    pcall(function()
                        self._rUseItem:FireServer(
                            swapOid,
                            self._mEnum:ToEnum("Equip"),
                            {}, nil
                        )
                    end)
                    return true
                end
            end
        end
        return false -- nothing to swap to
    end

    return false
end

