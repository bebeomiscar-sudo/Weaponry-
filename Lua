-- MODULE: ShootLock — FIXED (p169 was undefined)
-- ═══════════════════════════════════════════════════════════════════════
local ShootLock = {}
ShootLock.__index = ShootLock

function ShootLock.new()
    return setmetatable({ _lockedUntil = nil }, ShootLock)
end

--[[
    FIX: Original had p169 undefined in 2-param function
    Added lockDuration as proper 3rd parameter
    Added nil guard on lockDuration before arithmetic
]]
function ShootLock:ShouldFire(shouldLock, lockDuration)
    local now       = os.clock()
    local isLocked  = self._lockedUntil ~= nil
                      and now < self._lockedUntil

    -- Only set lock if both params valid
    if shouldLock and type(lockDuration) == "number" then
        self._lockedUntil = now + lockDuration
    end

    return isLocked or (shouldLock == true)
end

function ShootLock:Reset()
    self._lockedUntil = nil
end

function ShootLock:IsLocked()
    if self._lockedUntil == nil then return false end
    return os.clock() < self._lockedUntil
end

