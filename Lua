sections.ft_main:CreateLabel("Requires firetouchinterest in executor")
sections.ft_main:CreateDivider()

local ft_toggle = sections.ft_main:CreateToggle("Enable FireTouch", false, function(v)
    VoidState.fireTouchEnabled = v
    if v then startFireTouch(); notify("FireTouch","Active!",3)
    else stopFireTouch(); notify("FireTouch","Off",2) end
end)
ft_toggle:CreateKeybind("B", function()
    VoidState.fireTouchEnabled = not VoidState.fireTouchEnabled
    if VoidState.fireTouchEnabled then startFireTouch() else stopFireTouch() end
    notify("FireTouch", VoidState.fireTouchEnabled and "Active!" or "Off", 2)
end, "Toggle")

sections.ft_main:CreateButton("Check Executor Support", function()
    notify("Executor","firetouchinterest: "..(firetouchinterest and "Available" or "NOT available"),4)
end)

sections.ft_main:CreateButton("Scan Projectiles Now", function()
    local projs = scanProjectiles()
    local tgt   = VoidState.adaptTarget or getNearestEnemy()
    local boxes = tgt and getHitboxes(tgt.Character) or {}
    notify("Scan",
        "Projectiles: "..#projs
        .." | Hitboxes: "..#boxes
        .." | FTI: "..(firetouchinterest and "Yes" or "No")
        .." | Target: "..(tgt and tgt.Name or "None"),
        5
    )
end)

