local UECfg = {
    enabled        = false,
    counterEnabled = false,
}

local function detectUEPattern(player)
    local char = player.Character
    if not char then return false, nil end
    local hrp    = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false, nil end
    local hbHead = char:FindFirstChild("HitBoxHeadSmall")
              or  char:FindFirstChild("HitBoxHead")
    if not hbHead then return false, nil end
    local hrpPos = hrp.Position
    local hbPos  = hbHead.Position
    local hrpD   = math.sqrt(hrpPos.X^2 + hrpPos.Y^2 + hrpPos.Z^2)
    local hbD    = math.sqrt(hbPos.X^2 + hbPos.Y^2 + hbPos.Z^2)
    if hrpD > 50000 and hbD < 10000 then return true, hbPos end
    return false, nil
end

