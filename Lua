    local motor = getHeadMotor6D()
    if motor and GodmodeCfg.savedMotor6D then
        pcall(function() motor.C0 = GodmodeCfg.savedMotor6D end)
        GodmodeCfg.savedMotor6D = nil
    end
    for _, conn in ipairs(GodmodeCfg.multiConns) do
        pcall(function() conn:Disconnect() end)
    end
    GodmodeCfg.multiConns = {}
    pcall(function() RunService:UnbindFromRenderStep("__godmodeRestore") end)
    local _,_,_,cam = getGodmodeCharParts()
    if cam then
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                cam.CFrame = CFrame.new(hrp.Position + Vector3.new(0,1.5,0))
            end)
        end
    end
    GodmodeCfg.isActive = false
end

local function enableGodmode()
    GodmodeCfg.enabled = true
    local m = GodmodeCfg.method
    if m=="HeadWeldOffset"  then applyHeadWeldOffset()
    elseif m=="CameraDesync"   then startCameraDesync()
    elseif m=="HRPSeparation"  then startHRPSeparation()
    elseif m=="MultiLayer"     then startMultiLayerGodmode()
    end
    notify("Godmode","ACTIVE ["..m.."]",3)
end

local function disableGodmode()
    local m = GodmodeCfg.method
    if m=="HeadWeldOffset"  then restoreHeadWeld()
    elseif m=="CameraDesync"   then stopCameraDesync()
    elseif m=="HRPSeparation"  then stopHRPSeparation()
    elseif m=="MultiLayer"     then stopMultiLayerGodmode()
    end
    GodmodeCfg.enabled  = false
    GodmodeCfg.isActive = false
end

local function detectViewmodelGodmode(player)
    local char = player.Character
    if not char then return false,nil,0 end
    local head = char:FindFirstChild("Head")
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if not head or not hrp then return false,nil,0 end
    local headToHRP = (head.Position - hrp.Position).Magnitude
    if headToHRP > 10 then return true,"HeadWeldOffset",headToHRP end
    local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if torso then
        local headToTorso = (head.Position - torso.Position).Magnitude
        if headToTorso > 5 then return true,"WeldSeparation",headToTorso end
    end
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("Motor6D") and (v.Name=="Neck" or v.Part1==head) then
            if v.C0.Position.Magnitude > 100 then
                return true,"Motor6DOffset",v.C0.Position.Magnitude
            end
        end
    end
    return false,nil,0
end

local function startGodmodeCounter()
    if GodmodeCfg.counterConn then
        GodmodeCfg.counterConn:Disconnect()
        GodmodeCfg.counterConn = nil
    end
    GodmodeCfg.counterConn = RunService.Heartbeat:Connect(function()
        if not GodmodeCfg.counterEnabled then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p == lp then continue end
            local isGM, method, dist = detectViewmodelGodmode(p)
            if isGM then
                if not GodmodeCfg.detections[p] then
                    GodmodeCfg.detections[p] = {method=method, firstSeen=tick(), count=0}
                    notify("GM Detected!",p.Name.." using "..method,4)
                end
                GodmodeCfg.detections[p].count += 1
                if firetouchinterest then
                    local char = p.Character
                    if not char then continue end
                    local realTargets = {}
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then table.insert(realTargets, hrp) end
                    local hbBody = char:FindFirstChild("HitBoxBody")
                    if hbBody then table.insert(realTargets, hbBody) end
                    local projs = scanProjectiles()
                    for _, proj in ipairs(projs) do
                        for _, target in ipairs(realTargets) do
                            pcall(function()
                                local ti = nil
                                for _, child in ipairs(proj:GetChildren()) do
                                    if child.ClassName=="TouchTransmitter"
                                    or child.ClassName=="TouchInterest" then
                                        ti=child; break
                                    end
                                end
                                if ti then
                                    firetouchinterest(target, ti, 0)
                                    firetouchinterest(target, ti, 1)
                                end
                            end)
                        end
                    end
                end
            end
        end
    end)
end

local function stopGodmodeCounter()
    GodmodeCfg.counterEnabled = false
    if GodmodeCfg.counterConn then
        GodmodeCfg.counterConn:Disconnect()
        GodmodeCfg.counterConn = nil
    end
end

