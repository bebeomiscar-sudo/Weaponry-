-- MODULE: SpatialLimitGate — FIXED (expectedDuration logic)
-- ═══════════════════════════════════════════════════════════════════════
local SpatialLimitGate = {}
SpatialLimitGate.__index = SpatialLimitGate

local SPATIAL_BOUND = 4194304  -- original v100 constant

function SpatialLimitGate.new()
    return setmetatable({ _measurements = {} }, SpatialLimitGate)
end

--[[
    FIX: Original had no nil-check on measurements
    Added position validity check before inserting
    Added cleanup of old measurements (sliding window)
]]
function SpatialLimitGate:Check(character)
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return true end -- allow if no HRP

    local pos = hrp.Position
    local now = os.clock()

    -- Check bounds
    if  math.abs(pos.X) > SPATIAL_BOUND
    or  math.abs(pos.Y) > SPATIAL_BOUND
    or  math.abs(pos.Z) > SPATIAL_BOUND then
        return false -- out of valid space
    end

    -- Record measurement
    table.insert(self._measurements, { t = now, pos = pos })

    -- Clean old measurements (keep last 2 seconds)
    local cutoff = now - 2
    local fresh  = {}
    for _, m in ipairs(self._measurements) do
        if m.t >= cutoff then
            table.insert(fresh, m)
        end
    end
    self._measurements = fresh

    -- Stability check: if moved too fast recently → unstable
    local stability = RagebotConfig.Stability
    if #fresh >= 2 then
        local oldest  = fresh[1]
        local elapsed = now - oldest.t
        if elapsed > 0 and elapsed < stability then
            local dist = (pos - oldest.pos).Magnitude
            if dist > 500 then
                return false -- teleported too recently
            end
        end
    end

    return true
end

function SpatialLimitGate:Reset()
    table.clear(self._measurements)
end

