--   MONITOR
-- =============================================

local MonitorData = {projectileHistory = {}}
local monitorConn = nil

local function startMonitor()
    if monitorConn then monitorConn:Disconnect(); monitorConn=nil end
    monitorConn = Workspace.ChildAdded:Connect(function(child)
        if child.Name ~= "CoreProjectile" then return end
        local projData = {
            instance  = child,
            spawnPos  = child:FindFirstChild("Handle")
                    and child.Handle.Position
                    or  Vector3.zero,
            spawnTime = tick(),
            hit       = false,
            hitPos    = nil,
        }
        table.insert(MonitorData.projectileHistory, projData)
        if #MonitorData.projectileHistory > 50 then
            table.remove(MonitorData.projectileHistory, 1)
        end
        child.ChildAdded:Connect(function(c)
            if c.Name == "Hit" or c.Name == "HitEffect" then
                projData.hit    = true
                projData.hitPos = c.WorldPosition or Vector3.zero
                OffsetFixer.hitCount += 1
                if OffsetFixer.autoCalibrate and projData.spawnPos ~= Vector3.zero then
                    pcall(function()
                        addCalibrationSample(projData.spawnPos, projData.hitPos)
                    end)
                end
            end
        end)
    end)
end

local function stopMonitor()
    if monitorConn then monitorConn:Disconnect(); monitorConn=nil end
end

local function startOffsetFixerSystem()
    OffsetFixer.enabled = true
    if LocalFixer.enabled  then startLocalFixer()  end
    if FriendFixer.enabled then startFriendFixer()  end
    startMonitor()
end

local function stopOffsetFixerSystem()
    OffsetFixer.enabled = false
    stopLocalFixer()
    stopFriendFixer()
    stopMonitor()
end

local function getOffsetStatus()
    local lines = {
        "Fixer: "..(OffsetFixer.enabled and "ON" or "OFF"),
        "Local: "..(LocalFixer.enabled and "ON" or "off"),
        "Friends: "..(FriendFixer.enabled and "ON" or "off"),
        "Fixed: "..OffsetFixer.fixCount.." shots",
        "Calibrated: "..(CalibrationData.isCalibrated and "YES ✅" or "Collecting..."),
    }
    if CalibrationData.isCalibrated then
        table.insert(lines, string.format(
            "Err X:%.0f Y:%.0f Z:%.0f",
            CalibrationData.errorX,
            CalibrationData.errorY,
            CalibrationData.errorZ
        ))
    end
    local fc = 0
    for _ in pairs(FriendFixer.fixedPlayers) do fc += 1 end
    table.insert(lines, "Helping: "..fc.." players")
    return table.concat(lines, "\n")
end

