-- MODULE: PartGlue — FIXED (no destroy guard, refCount leak)
-- ═══════════════════════════════════════════════════════════════════════
local PartGlue = {}
PartGlue.__index = PartGlue

function PartGlue.new()
    return setmetatable({ _glued = {} }, PartGlue)
end

--[[
    FIX: Added Instance:IsDescendantOf check before
    restoring weld — prevents error on destroyed parts
    FIX: refCount was never bounds-checked (could go negative)
]]
function PartGlue:Acquire(part, hitboxRef)
    if not part or not part.Parent then return CFrame.identity end

    local entry = self._glued[part]
    if entry then
        entry.refCount += 1
        return part.CFrame
    end

    -- Find existing weld
    local weld = nil
    for _, v in ipairs(part:GetChildren()) do
        if v:IsA("WeldConstraint") or v:IsA("Weld") then
            weld = v; break
        end
    end

    -- Detach weld Part1, anchor part
    local originalPart1 = nil
    if weld then
        originalPart1   = weld.Part1
        weld.Part1      = nil
    end

    local ok = pcall(function()
        part.Anchored = true
    end)

    if not ok then
        -- Part is locked/read-only — skip
        if weld and originalPart1 then
            weld.Part1 = originalPart1
        end
        return part.CFrame
    end

    self._glued[part] = {
        refCount     = 1,
        weld         = weld,
        originalPart1 = originalPart1,
    }

    return part.CFrame
end

function PartGlue:Release(part)
    if not part then return end
    local entry = self._glued[part]
    if not entry then return end

    entry.refCount = math.max(0, entry.refCount - 1)
    if entry.refCount > 0 then return end

    --[[
        FIX: Check part AND weld still exist in workspace
        before attempting to restore — prevents nil index error
    ]]
    local weld         = entry.weld
    local origPart1    = entry.originalPart1

    if weld and weld.Parent
    and origPart1 and origPart1.Parent then
        pcall(function()
            weld.Part1          = origPart1
            origPart1.Anchored  = false
        end)
    end

    -- Unanchor the glued part if still valid
    if part.Parent then
        pcall(function() part.Anchored = false end)
    end

    self._glued[part] = nil
end

function PartGlue:ReleaseAll()
    for part, _ in pairs(self._glued) do
        self:Release(part)
    end
    table.clear(self._glued)
end

