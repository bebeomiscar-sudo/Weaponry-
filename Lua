local RG = {
    on        = false,
    dist      = 999,
    team      = false,
    vis       = false,
    part      = "Head",
    fov       = 0,
    priority  = "Closest",
    ffa       = false,
}

local rgConn    = nil
local rgCD      = 0
local rgRunning = false

local rgRp = RaycastParams.new()
rgRp.FilterType = Enum.RaycastFilterType.Exclude

local rgCirc = Drawing.new("Circle")
rgCirc.NumSides=64; rgCirc.Filled=false
rgCirc.Color=Color3.fromRGB(255,80,80)
rgCirc.Thickness=1.5; rgCirc.Transparency=0.7; rgCirc.Visible=false

local function rgValid(p)
    if p == lp then return false end
    if not RG.ffa and RG.team and sameTm(p) then return false end
    local chr = p.Character; if not chr then return false end
    local hm = chr:FindFirstChildOfClass("Humanoid")
    return hm and hm.Health > 0
end

local function rgInFov(pt)
    if RG.fov <= 0 then return true end
    return inFov(pt, RG.fov)
end

local function rgFindTarget()
    local myH = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myH then return nil,nil,nil end
    local candidates = {}
    for _, p in ipairs(plr:GetPlayers()) do
        if not rgValid(p) then continue end
        local chr = p.Character
        local pt  = bPart(chr, RG.part); if not pt then continue end
        if not rgInFov(pt) then continue end
        local dist = (myH.Position - pt.Position).Magnitude; if dist > RG.dist then continue end
        if RG.vis then
            rgRp.FilterDescendantsInstances = {lp.Character, chr}
            local dir = pt.Position - cam.CFrame.Position
            local h   = ws:Raycast(cam.CFrame.Position, dir, rgRp)
            if h and not h.Instance:IsDescendantOf(chr) then continue end
        end
        local hm = chr:FindFirstChildOfClass("Humanoid"); local hp = hm and hm.Health or 0
        table.insert(candidates, {player=p, char=chr, part=pt, dist=dist, hp=hp})
    end
    if #candidates == 0 then return nil,nil,nil end
    if     RG.priority == "LowHP"   then table.sort(candidates, function(a,b) return a.hp   < b.hp   end)
    elseif RG.priority == "HighHP"  then table.sort(candidates, function(a,b) return a.hp   > b.hp   end)
    elseif RG.priority == "Closest" then table.sort(candidates, function(a,b) return a.dist < b.dist end)
    elseif RG.priority == "Random"  then
        for i=#candidates,2,-1 do
            local j=math.random(i); candidates[i],candidates[j]=candidates[j],candidates[i]
        end
    end
    local best = candidates[1]; return best.player, best.char, best.part
end

