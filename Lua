local anchorKillConn = nil

local function startVoidPull()
    if VoidPullCfg.pullConn then
        VoidPullCfg.pullConn:Disconnect()
        VoidPullCfg.pullConn = nil
    end
    VoidPullCfg.pullConn = RunService.Heartbeat:Connect(function()
        if not VoidPullCfg.enabled then return end
        local myHRP = getHRP()
        if not myHRP then return end
        if VoidPullCfg.autoTarget then
            local voidEnemy = getNearestVoidEnemy()
            if voidEnemy then VoidPullCfg.pullTarget = voidEnemy end
        end
        local target = VoidPullCfg.pullTarget
        if not target then return end
        local char = target.Character
        if not char then return end
        local tHRP = char:FindFirstChild("HumanoidRootPart")
        if not tHRP then return end
        local pullDest = myHRP.Position + VoidPullCfg.pullOffset
        pcall(function()
            if VoidPullCfg.pullStrength >= 1.0 then
                tHRP.CFrame = CFrame.new(pullDest)
                tHRP.AssemblyLinearVelocity  = Vector3.zero
                tHRP.AssemblyAngularVelocity = Vector3.zero
            else
                tHRP.CFrame = CFrame.new(tHRP.Position:Lerp(pullDest, VoidPullCfg.pullStrength))
            end
        end)
        VoidPullCfg.totalPulls += 1
        if not VoidPullCfg.voidPlayersDetected[target] then
            VoidPullCfg.voidPlayersDetected[target] = {firstSeen=tick(), pullCount=0}
            notify("Void Pull","Pulling "..target.Name.." to you!",2)
        end
        VoidPullCfg.voidPlayersDetected[target].pullCount += 1
    end)
end

local function stopVoidPull()
    VoidPullCfg.enabled = false
    if VoidPullCfg.pullConn then
        VoidPullCfg.pullConn:Disconnect()
        VoidPullCfg.pullConn = nil
    end
end

local function startVoidAnchor()
    if VoidPullCfg.anchorConn then
        VoidPullCfg.anchorConn:Disconnect()
        VoidPullCfg.anchorConn = nil
    end
    if anchorKillConn then anchorKillConn:Disconnect(); anchorKillConn=nil end
    pcall(function() RunService:UnbindFromRenderStep("__voidAnchor") end)

    RunService:BindToRenderStep(
        "__voidAnchor",
        Enum.RenderPriority.Last.Value + 100,
        function()
            if not VoidPullCfg.anchorEnabled then return end
            local myHRP = getHRP()
            if not myHRP then return end
            local target = VoidPullCfg.anchorTarget or VoidPullCfg.pullTarget
            if not target then
                target = getNearestVoidEnemy()
                VoidPullCfg.anchorTarget = target
            end
            if not target then return end
            local char = target.Character
            if not char then return end
            local tHRP = char:FindFirstChild("HumanoidRootPart")
            if not tHRP then return end
            local anchorPos = myHRP.Position + Vector3.new(0,0,VoidPullCfg.anchorRadius)
            pcall(function()
                tHRP.CFrame                  = CFrame.new(anchorPos)
                tHRP.AssemblyLinearVelocity  = Vector3.zero
                tHRP.AssemblyAngularVelocity = Vector3.zero
            end)
            VoidPullCfg.totalAnchors += 1
        end
    )

    if VoidPullCfg.anchorKillOnLock then
        anchorKillConn = RunService.Heartbeat:Connect(function()
            if not VoidPullCfg.anchorEnabled then return end
            if not firetouchinterest then return end
            local target = VoidPullCfg.anchorTarget or VoidPullCfg.pullTarget
            if not target then return end
            local char = target.Character
            if not char then return end
            local myHRP = getHRP()
            if not myHRP then return end
            local tHRP = char:FindFirstChild("HumanoidRootPart")
            if not tHRP then return end
            local projs    = scanProjectiles()
            local hitboxes = getHitboxes(char)
            if #projs > 0 and #hitboxes > 0 then
                local savedCF = myHRP.CFrame
                local savedLV = myHRP.AssemblyLinearVelocity
                local savedAV = myHRP.AssemblyAngularVelocity
                pcall(function()
                    myHRP.CFrame = CFrame.new(
                        tHRP.Position.X,
                        tHRP.Position.Y + VOID_HEIGHT,
                        tHRP.Position.Z
                    )
                end)
                for _, proj in ipairs(projs) do
                    for _, hbox in ipairs(hitboxes) do
                        pcall(function()
                            local ti = nil
                            for _, child in ipairs(proj:GetChildren()) do
                                if child.ClassName=="TouchTransmitter"
                                or child.ClassName=="TouchInterest" then
                                    ti=child; break
                                end
                            end
                            if ti then
                                firetouchinterest(hbox, ti, 0)
                                firetouchinterest(hbox, ti, 1)
                            end
                        end)
                    end
                end
                pcall(function()
                    myHRP.CFrame                  = savedCF
                    myHRP.AssemblyLinearVelocity  = savedLV
                    myHRP.AssemblyAngularVelocity = savedAV
                end)
                VoidPullCfg.successfulKills += 1
            end
        end)
    end
end

local function stopVoidAnchor()
    VoidPullCfg.anchorEnabled = false
    VoidPullCfg.anchorTarget  = nil
    pcall(function() RunService:UnbindFromRenderStep("__voidAnchor") end)
    if anchorKillConn then anchorKillConn:Disconnect(); anchorKillConn=nil end
end

local function forceDesyncBreak(target)
    if not target then return end
    local char = target.Character
    if not char then return end
    local tHRP = char:FindFirstChild("HumanoidRootPart")
    if not tHRP then return end
    local myHRP = getHRP()
    if not myHRP then return end
    task.spawn(function()
        for i = 1, VoidPullCfg.breakIterations do
            pcall(function()
                local angle = (i / VoidPullCfg.breakIterations) * math.pi * 2
                tHRP.CFrame = CFrame.new(
                    myHRP.Position + Vector3.new(
                        math.cos(angle) * 2,
                        VOID_HEIGHT * (i % 2 == 0 and 1 or -1),
                        math.sin(angle) * 2
                    )
                )
                tHRP.AssemblyLinearVelocity = Vector3.new(
                    VOID_MAX * (math.random() > 0.5 and 1 or -1),
                    VOID_MAX * (math.random() > 0.5 and 1 or -1),
                    VOID_MAX * (math.random() > 0.5 and 1 or -1)
                )
            end)
            task.wait(VoidPullCfg.breakInterval)
        end
        pcall(function()
            tHRP.CFrame                  = CFrame.new(myHRP.Position)
            tHRP.AssemblyLinearVelocity  = Vector3.zero
            tHRP.AssemblyAngularVelocity = Vector3.zero
        end)
        notify("Desync Break","Broke "..target.Name.."'s desync!",2)
    end)
end

local function startForceBreakLoop()
    if VoidPullCfg.breakConn then
        VoidPullCfg.breakConn:Disconnect()
        VoidPullCfg.breakConn = nil
    end
    VoidPullCfg.breakConn = RunService.Heartbeat:Connect(function()
        if not VoidPullCfg.forceBreakEnabled then return end
        local target = VoidPullCfg.breakTarget
                    or VoidPullCfg.pullTarget
                    or getNearestVoidEnemy()
        if not target then return end
        local char = target.Character
        if not char then return end
        local tHRP = char:FindFirstChild("HumanoidRootPart")
        if not tHRP then return end
        if math.abs(tHRP.Position.Y) > 50000 then
            forceDesyncBreak(target)
        end
    end)
end

local function stopForceBreakLoop()
    VoidPullCfg.forceBreakEnabled = false
    if VoidPullCfg.breakConn then
        VoidPullCfg.breakConn:Disconnect()
        VoidPullCfg.breakConn = nil
    end
end

