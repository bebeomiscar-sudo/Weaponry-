                        tHRP.Position.X + math.cos(VoidState.orbitAngle)*ORBIT_RADIUS,
                        VOID_HEIGHT,
                        tHRP.Position.Z + math.sin(VoidState.orbitAngle)*ORBIT_RADIUS
                    ) * CFrame.Angles(math.pi, math.pi, math.pi)
                    hrp.AssemblyLinearVelocity   = Vector3.new(betterRandom(-500,500,-100,100),betterRandom(-500,500,-100,100),betterRandom(-500,500,-100,100))
                    hrp.AssemblyAngularVelocity  = Vector3.new(betterRandom(-50,50,-10,10),betterRandom(-50,50,-10,10),betterRandom(-50,50,-10,10))
                    if VoidState.teleDesync then
                        pcall(function() tHRP.CFrame = CFrame.new(tHRP.Position.X, VOID_HEIGHT, tHRP.Position.Z) end)
                    end
                else
                    VoidState.adaptTarget = getBestTarget()
                end
            else
                hrp.CFrame = CFrame.new(
                    betterRandom(-VOID_MAX,VOID_MAX,VOID_AVOID_L,VOID_AVOID_H),
                    betterRandom(-VOID_MAX,VOID_MAX,VOID_AVOID_L,VOID_AVOID_H),
                    betterRandom(-VOID_MAX,VOID_MAX,VOID_AVOID_L,VOID_AVOID_H)
                ) * CFrame.Angles(math.pi, math.pi, math.pi)
                hrp.AssemblyLinearVelocity   = Vector3.new(betterRandom(-VOID_MAX,VOID_MAX,VOID_AVOID_L,VOID_AVOID_H),betterRandom(-VOID_MAX,VOID_MAX,VOID_AVOID_L,VOID_AVOID_H),betterRandom(-VOID_MAX,VOID_MAX,VOID_AVOID_L,VOID_AVOID_H))
                hrp.AssemblyAngularVelocity  = Vector3.new(betterRandom(-VOID_MAX,VOID_MAX,VOID_AVOID_L,VOID_AVOID_H),betterRandom(-VOID_MAX,VOID_MAX,VOID_AVOID_L,VOID_AVOID_H),betterRandom(-VOID_MAX,VOID_MAX,VOID_AVOID_L,VOID_AVOID_H))
            end
        end)
    end)
    RunService:BindToRenderStep("__vsSync", Enum.RenderPriority.First.Value, function()
        if not VoidState.enabled then return end
        local hrp = VoidState.hrp
        if not hrp then return end
        pcall(function()
            hrp.CFrame=VoidState.clientCF; hrp.AssemblyLinearVelocity=VoidState.clientLV; hrp.AssemblyAngularVelocity=VoidState.clientAV
        end)
    end)
end

