local HackerDetector = {}
HackerDetector.__index = HackerDetector

function HackerDetector.new()
    local self = setmetatable({}, HackerDetector)
    self._trove   = Trove.new("hacker_detector")
    self._flagged = {}
    local SPEED_THRESHOLD = 200

    self._trove:Connect(RunService.Heartbeat, function(dt)
        if not Config.Misc.HackerDetector then return end
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if self._flagged[player] then continue end
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then continue end
            local speed = root.AssemblyLinearVelocity.Magnitude
            if speed > SPEED_THRESHOLD then
                self._flagged[player] = true
                warn("[Kicia] Possible hacker: " .. player.Name .. " speed=" .. math.floor(speed))
            end
        end
    end)

    self._trove:Connect(Players.PlayerRemoving, function(p)
        self._flagged[p] = nil
    end)

    return self
end

function HackerDetector:Destroy()
    self._trove:Destroy()
end

