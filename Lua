-- ESP CONTROLLER
-- Maintains one ESP entry per visible enemy player.
-- Updates each frame in PreRender.
-- ============================================================

local ESPController = {}
ESPController.__index = ESPController

function ESPController.new()
    local self = setmetatable({}, ESPController)
    self._trove     = Trove.new("esp")
    self._entries   = {}
    self._screenGui = Instance.new("ScreenGui")
    self._chams     = Chams.new()

    local sg = self._screenGui
    sg.Name              = "KiciaESP"
    sg.ResetOnSpawn      = false
    sg.IgnoreGuiInset    = true
    sg.DisplayOrder      = 999
    sg.ZIndexBehavior    = Enum.ZIndexBehavior.Sibling
    sg.Parent            = LocalPlayer.PlayerGui

    -- watch players joining/leaving
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then self:_AddPlayer(p) end
    end
    self._trove:Connect(Players.PlayerAdded, function(p)
        if p ~= LocalPlayer then self:_AddPlayer(p) end
    end)
    self._trove:Connect(Players.PlayerRemoving, function(p)
        self:_RemovePlayer(p)
    end)

    -- update each frame
    self._trove:Connect(RunService.PreRender, function()
        self:_Update()
    end)

    return self
end

function ESPController:_AddPlayer(player)
    self._entries[player] = {
        player   = player,
        box      = BoundingBox.new(self._screenGui),
        skeleton = Skeleton.new(self._screenGui),
        tracer   = Tracer.new(self._screenGui),
    }
    self._entries[player].box:SetStyle(Config.ESP.Style)
end

function ESPController:_RemovePlayer(player)
    local e = self._entries[player]
    if e then
        e.box:Destroy()
        e.skeleton:Destroy()
        e.tracer:Destroy()
        self._chams:Remove(player.Character)
        self._entries[player] = nil
    end
end

-- _GetBoundingBox2D: compute screen-space bounding box for a character.
-- Returns topLeft, bottomRight as Vector2, or nil if off-screen.
local function getCharacterScreenBounds(character)
    local cam    = workspace.CurrentCamera
    local minX, minY =  math.huge,  math.huge
    local maxX, maxY = -math.huge, -math.huge
    local anyOnScreen = false

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            local s, visible = cam:WorldToViewportPoint(part.Position)
            if visible and s.Z > 0 then
                anyOnScreen = true
                minX = math.min(minX, s.X)
                minY = math.min(minY, s.Y)
                maxX = math.max(maxX, s.X)
                maxY = math.max(maxY, s.Y)
            end
        end
    end

    if not anyOnScreen then return nil end
    return Vector2.new(minX - 4, minY - 4), Vector2.new(maxX + 4, maxY + 4)
end

function ESPController:_Update()
    if not Config.ESP.Enabled then
        for _, e in pairs(self._entries) do
            e.box:SetEnabled(false)
            e.skeleton:Hide()
            e.tracer:Hide()
        end
        return
    end

    local cam = workspace.CurrentCamera

    for player, e in pairs(self._entries) do
        local char = player.Character
        if not char then
            e.box:SetEnabled(false)
            e.skeleton:Hide()
            e.tracer:Hide()
            self._chams:Remove(nil)
            goto continue
        end

        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            e.box:SetEnabled(false)
            e.skeleton:Hide()
            e.tracer:Hide()
            goto continue
        end

        local topLeft, bottomRight = getCharacterScreenBounds(char)
        if not topLeft then
            e.box:SetEnabled(false)
            e.skeleton:Hide()
            e.tracer:Hide()
            goto continue
        end

        -- Box
        if Config.ESP.ShowBox then
            e.box:SetStyle(Config.ESP.Style)
            e.box:SetColors(Config.ESP.BoxColor, Config.ESP.OutlineColor)
            e.box:Update(topLeft, bottomRight)
            e.box:SetEnabled(true)
        else
            e.box:SetEnabled(false)
        end

        -- Skeleton
        if Config.ESP.ShowSkeleton then
            e.skeleton:Update(char, Config.ESP.BoxColor)
        else
            e.skeleton:Hide()
        end

        -- Tracer
        if Config.ESP.ShowTracer then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local s, visible = cam:WorldToViewportPoint(root.Position)
                if visible and s.Z > 0 then
                    e.tracer:Update(Vector2.new(s.X, s.Y), Config.ESP.TracerColor)
                else
                    e.tracer:Hide()
                end
            end
        else
            e.tracer:Hide()
        end

        -- Chams
        if Config.ESP.ShowChams then
            self._chams:Apply(char, Config.ESP.ChamsColor)
        else
            self._chams:Remove(char)
        end

        ::continue::
    end
end

function ESPController:Destroy()
    self._chams:Destroy()
    self._screenGui:Destroy()
    self._trove:Destroy()
end

-- ============================================================
-- AIMBOT CORE
-- ============================================================

local AimbotController = {}
AimbotController.__index = AimbotController

function AimbotController.new()
    local self        = setmetatable({}, AimbotController)
    self._trove       = Trove.new("aimbot")
    self._currentTarget = nil

    self._trove:Connect(RunService.PreRender, function()
        self:_Update()
    end)
    return self
end

-- _GetBestTarget: find nearest enemy to screen center within FOV.
function AimbotController:_GetBestTarget()
    local cam       = workspace.CurrentCamera
    local vp        = cam.ViewportSize
    local centerX   = vp.X / 2
    local centerY   = vp.Y / 2
    local maxDist   = Config.Aimbot.FOV
    local best      = nil
    local bestDist  = math.huge
    local bone      = Config.Aimbot.Bone

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then continue end

        -- team check
        if Config.Aimbot.TeamCheck and player.Team == LocalPlayer.Team then continue end

        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        local part = char:FindFirstChild(bone) or char:FindFirstChild("HumanoidRootPart")
        if not part then continue end

        -- wall check
        if Config.Aimbot.WallCheck then
            local origin = cam.CFrame.Position
            local dir    = (part.Position - origin)
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { LocalPlayer.Character, cam }
            local result = workspace:Raycast(origin, dir, params)
            if result and not char:IsAncestorOf(result.Instance) then continue end
        end

        local s, visible = cam:WorldToViewportPoint(part.Position)
        if not visible or s.Z <= 0 then continue end

        local dx   = s.X - centerX
        local dy   = s.Y - centerY
        local dist = math.sqrt(dx * dx + dy * dy)
        if dist < maxDist and dist < bestDist then
            bestDist = dist
            best     = { part = part, screen = Vector2.new(s.X, s.Y) }
        end
    end

    return best
end

function AimbotController:_Update()
    if not Config.Aimbot.Enabled then
        self._currentTarget = nil
        return
    end

    local best = self:_GetBestTarget()
    self._currentTarget = best

    if not best then return end

    -- lerp camera toward target
    local cam    = workspace.CurrentCamera
    local vp     = cam.ViewportSize
    local cx, cy = vp.X / 2, vp.Y / 2
    local dx     = best.screen.X - cx
    local dy     = best.screen.Y - cy
    local speed  = math.clamp(Config.Aimbot.Smoothing, 0.01, 1)

    local newX   = cx + dx * speed
    local newY   = cy + dy * speed
    local dir    = cam:ViewportPointToRay(newX, newY).Direction
    local pitch  = math.asin(-dir.Y)
    local yaw    = math.atan2(-dir.X, -dir.Z)

    cam.CFrame   = CFrame.new(cam.CFrame.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
end

function AimbotController:GetCurrentTarget()
    return self._currentTarget
end

function AimbotController:Destroy()
    self._trove:Destroy()
end

