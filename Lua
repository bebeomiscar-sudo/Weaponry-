local function restoreMinimize()
    local char = lp.Character
    if not char then return end
    restoreOriginalSizes(char)
    for _, acc in ipairs(char:GetChildren()) do
        if acc:IsA("Accessory") then
            local handle = acc:FindFirstChild("Handle")
            if handle then
                pcall(function()
                    handle.Transparency = 0
                    handle.CastShadow   = true
                end)
            end
        end
    end
    notify("Minimize","Restored!",2)
end

local minimizeRespawnConn = nil

local function startMinimizeLoop()
    for _, conn in ipairs(MinimizeCfg.connections) do
        pcall(function() conn:Disconnect() end)
    end
    MinimizeCfg.connections = {}
    local char = lp.Character
    if not char then return end
    local conn = char.DescendantAdded:Connect(function(desc)
        if not MinimizeCfg.enabled then return end
        task.wait(0.1)
        pcall(function()
            if desc:IsA("BasePart") and desc.Name ~= "HumanoidRootPart" then
                if MinimizeCfg.mode == "HeadOnly" and desc.Name ~= "Head" then
                    desc.Transparency = 1
                    desc.Size         = Vector3.new(0.05,0.05,0.05)
                    desc.CanCollide   = false
                    desc.CastShadow   = false
                elseif MinimizeCfg.mode == "Invisible" then
                    desc.Transparency = 1
                    desc.CastShadow   = false
                end
            end
            if desc:IsA("Accessory") then
                local handle = desc:FindFirstChild("Handle")
                if handle then
                    handle.Transparency = 1
                    handle.CastShadow   = false
                end
            end
        end)
    end)
    table.insert(MinimizeCfg.connections, conn)
end

