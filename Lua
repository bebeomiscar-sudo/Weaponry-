local function stopAll()
    stopVoidSpam(); stopAdapt(); stopTeleDesync(); stopFireTouch()
    stopKiciaCounter(); stopLureLoop(); stopDetection()
    stopMultiLayerDesync(); stopFakeHistory(); stopInstantCounter()
    if AntiKiciaCfg.counterConn then AntiKiciaCfg.counterConn:Disconnect(); AntiKiciaCfg.counterConn=nil end
    VoidState.enabled=false
    if VoidState.priorityConn then VoidState.priorityConn:Disconnect(); VoidState.priorityConn=nil end
    print("[VoidSpam] All stopped")
end

local function startAll()
    VoidState.enabled=true; startVoidSpam(); startPrioritySystem()
    if VoidState.adaptEnabled     then startAdapt()        end
    if VoidState.teleDesync       then startTeleDesync()    end
    if VoidState.fireTouchEnabled then startFireTouch()     end
    if KiciaCfg.enabled           then startKiciaCounter()  end
    if LureCfg.enabled            then startLureLoop()      end
    if AntiKiciaCfg.enabled       then startDetection()     end
    if AntiKiciaCfg.multiLayerDesync then startMultiLayerDesync() end
    if AntiKiciaCfg.fakeHistoryOn then startFakeHistory()   end
    if AntiKiciaCfg.instantCounter then startInstantCounter() end
    if AntiKiciaCfg.predictionCounter then startPredictionCounter() end
    print("[VoidSpam] All started")
end

