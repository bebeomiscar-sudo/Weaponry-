--   CONSTANTS
-- =============================================

local VOID_MAX     =  2147483646
local VOID_AVOID_L = -1147483646
local VOID_AVOID_H =  1147483646
local VOID_HEIGHT  =  100000
local ORBIT_RADIUS =  3
local ORBIT_SPEED  =  8

-- =============================================
--   STATE
-- =============================================

local VoidState = {
    enabled          = false,
    adaptEnabled     = false,
    teleDesync       = false,
    fireTouchEnabled = false,

    clientCF = CFrame.identity,
    clientLV = Vector3.zero,
    clientAV = Vector3.zero,

    hrp         = nil,
    adaptTarget = nil,
    orbitAngle  = 0,

    hbConn           = nil,
    adaptRefreshConn = nil,
    teleDesyncConn   = nil,
    ftLoopConn       = nil,
}

-- =============================================
--   HELPERS
-- =============================================

local function getHRP()
    local char = lp.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function betterRandom(mi, ma, dmi, dma)
    local val    = math.random(mi, ma)
    local safety = 0
    repeat
        val    = math.random(mi, ma)
        safety += 1
        if safety > 100 then break end
    until val < dmi or val > dma
    return val
end

local function getNearestEnemy()
    local hrp = getHRP()
    if not hrp then return nil end
    local best, bd = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        local char = p.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local tHRP = char:FindFirstChild("HumanoidRootPart")
        if not tHRP then continue end
        local d = (hrp.Position - tHRP.Position).Magnitude
        if d < bd then
            bd   = d
            best = p
        end
    end
    return best
end

local function scanProjectiles()
    local found = {}
    for _, v in ipairs(Workspace:GetChildren()) do
        if v.Name == "CoreProjectile" then
            table.insert(found, v)
        end
        for _, child in ipairs(v:GetChildren()) do
            if child.Name == "CoreProjectile" then
                table.insert(found, child)
            end
        end
    end
    return found
end

local function getHitboxes(char)
    if not char then return {} end
    local boxes    = {}
    local priority = {
        "HitBoxHeadSmall",
        "HitBoxHead",
        "HitBoxBody",
        "HitBoxBodySmall",
        "Head",
        "UpperTorso",
        "HumanoidRootPart",
    }
    for _, name in ipairs(priority) do
        local part = char:FindFirstChild(name)
        if part then
            table.insert(boxes, part)
        end
    end
    return boxes
end

local function fireTouchOnPart(projectile, hitPart)
    if not projectile or not hitPart then return false end
    local ti = nil
    for _, child in ipairs(projectile:GetChildren()) do
        if child.ClassName == "TouchTransmitter"
        or child.ClassName == "TouchInterest" then
            ti = child
            break
        end
    end
    if not ti then return false end
    local ok = pcall(firetouchinterest, hitPart, ti, 0)
    if not ok then
        pcall(firetouchinterest, hitPart, ti, 1)
    end
    return ok
end

-- =============================================
--   VOIDSPAM CORE
-- =============================================

local function stopVoidSpam()
    if VoidState.hbConn then
        VoidState.hbConn:Disconnect()
        VoidState.hbConn = nil
    end
    pcall(function()
        RunService:UnbindFromRenderStep("__vsSync")
    end)
    local hrp = getHRP()
    if hrp then
        pcall(function()
            hrp.CFrame                  = VoidState.clientCF
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

local function startVoidSpam()
    stopVoidSpam()

    VoidState.hbConn = RunService.Heartbeat:Connect(function()
        if not VoidState.enabled then return end

        local hrp = getHRP()
        if not hrp then return end
        VoidState.hrp = hrp

        VoidState.clientCF = hrp.CFrame
        VoidState.clientLV = hrp.AssemblyLinearVelocity
        VoidState.clientAV = hrp.AssemblyAngularVelocity

        pcall(function()
            if VoidState.adaptEnabled and VoidState.adaptTarget then
                local tChar = VoidState.adaptTarget.Character
                local tHRP  = tChar and tChar:FindFirstChild("HumanoidRootPart")

                if tHRP then
                    VoidState.orbitAngle = (
                        VoidState.orbitAngle + ORBIT_SPEED * 0.016
                    ) % (math.pi * 2)

                    local ox = math.cos(VoidState.orbitAngle) * ORBIT_RADIUS
                    local oz = math.sin(VoidState.orbitAngle) * ORBIT_RADIUS

                    hrp.CFrame = CFrame.new(
                        tHRP.Position.X + ox,
                        VOID_HEIGHT,
                        tHRP.Position.Z + oz
                    ) * CFrame.Angles(math.pi, math.pi, math.pi)

                    hrp.AssemblyLinearVelocity = Vector3.new(
                        betterRandom(-500, 500, -100, 100),
                        betterRandom(-500, 500, -100, 100),
                        betterRandom(-500, 500, -100, 100)
                    )
                    hrp.AssemblyAngularVelocity = Vector3.new(
                        betterRandom(-50, 50, -10, 10),
                        betterRandom(-50, 50, -10, 10),
                        betterRandom(-50, 50, -10, 10)
                    )

                    if VoidState.teleDesync then
                        pcall(function()
                            tHRP.CFrame = CFrame.new(
                                tHRP.Position.X,
                                VOID_HEIGHT,
                                tHRP.Position.Z
                            )
                        end)
                    end
                else
                    VoidState.adaptTarget = getNearestEnemy()
                end
            else
                hrp.CFrame = CFrame.new(
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H),
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H),
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H)
                ) * CFrame.Angles(math.pi, math.pi, math.pi)

                hrp.AssemblyLinearVelocity = Vector3.new(
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H),
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H),
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H)
                )
                hrp.AssemblyAngularVelocity = Vector3.new(
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H),
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H),
                    betterRandom(-VOID_MAX, VOID_MAX, VOID_AVOID_L, VOID_AVOID_H)
                )
            end
        end)
    end)

    RunService:BindToRenderStep(
        "__vsSync",
        Enum.RenderPriority.First.Value,
        function()
            if not VoidState.enabled then return end
            local hrp = VoidState.hrp
            if not hrp then return end
            pcall(function()
                hrp.CFrame                  = VoidState.clientCF
                hrp.AssemblyLinearVelocity  = VoidState.clientLV
                hrp.AssemblyAngularVelocity = VoidState.clientAV
            end)
        end
    )
end

-- =============================================
--   ADAPT SYSTEM
-- =============================================

local function stopAdapt()
    VoidState.adaptEnabled = false
    VoidState.adaptTarget  = nil
    VoidState.orbitAngle   = 0
    if VoidState.adaptRefreshConn then
        VoidState.adaptRefreshConn:Disconnect()
        VoidState.adaptRefreshConn = nil
    end
end

local function startAdapt()
    stopAdapt()
    VoidState.adaptEnabled = true
    VoidState.adaptTarget  = getNearestEnemy()

    VoidState.adaptRefreshConn = RunService.Heartbeat:Connect(function()
        if not VoidState.adaptEnabled then return end
        local cur = VoidState.adaptTarget
        if not cur
        or not cur.Character
        or not cur.Character:FindFirstChild("HumanoidRootPart") then
            local newTgt = getNearestEnemy()
            if newTgt ~= VoidState.adaptTarget then
                VoidState.adaptTarget = newTgt
                VoidState.orbitAngle  = 0
                if newTgt then
                    notify("Adapt", "Auto-switched to: " .. newTgt.Name, 3)
                end
            end
        end
    end)
end

-- =============================================
--   TELEPORT DESYNC
-- =============================================

local function stopTeleDesync()
    VoidState.teleDesync = false
    if VoidState.teleDesyncConn then
        VoidState.teleDesyncConn:Disconnect()
        VoidState.teleDesyncConn = nil
    end
end

local function startTeleDesync()
    stopTeleDesync()
    VoidState.teleDesync = true

    VoidState.teleDesyncConn = RunService.Heartbeat:Connect(function()
        if not VoidState.teleDesync then return end
        local hrp = getHRP()
        if not hrp then return end
        local tgt = VoidState.adaptTarget or getNearestEnemy()
        if not tgt then return end
        local tChar = tgt.Character
        if not tChar then return end
        local tHRP = tChar:FindFirstChild("HumanoidRootPart")
        if not tHRP then return end
        pcall(function()
            local angle = VoidState.orbitAngle
            local ox    = math.cos(angle) * (ORBIT_RADIUS * 0.5)
            local oz    = math.sin(angle) * (ORBIT_RADIUS * 0.5)
            tHRP.CFrame = hrp.CFrame * CFrame.new(ox, 0, oz)
        end)
    end)
end

-- =============================================
--   FIRETOUCH INTEREST
-- =============================================

local function stopFireTouch()
    VoidState.fireTouchEnabled = false
    if VoidState.ftLoopConn then
        VoidState.ftLoopConn:Disconnect()
        VoidState.ftLoopConn = nil
    end
end

local function startFireTouch()
    stopFireTouch()

    if not firetouchinterest then
        notify(
            "FireTouch",
            "firetouchinterest not available in this executor!",
            5
        )
        VoidState.fireTouchEnabled = false
        return
    end

    VoidState.fireTouchEnabled = true

    VoidState.ftLoopConn = RunService.Heartbeat:Connect(function()
        if not VoidState.fireTouchEnabled then return end

        local hrp = getHRP()
        if not hrp then return end

        local tP    = VoidState.adaptTarget or getNearestEnemy()
        if not tP then return end
        local tChar = tP.Character
        if not tChar then return end

        local realCF = hrp.CFrame
        local realLV = hrp.AssemblyLinearVelocity
        local realAV = hrp.AssemblyAngularVelocity

        pcall(function()
            hrp.CFrame = CFrame.new(
                hrp.Position.X,
                VOID_HEIGHT,
                hrp.Position.Z
            )
        end)

        task.wait(0.05)

        local projectiles = scanProjectiles()
        local hitboxes    = getHitboxes(tChar)

        if #projectiles > 0 and #hitboxes > 0 then
            local offsets = {
                Vector3.new(0,    0, 0),
                Vector3.new(5,    0, 0),
                Vector3.new(-5,   0, 0),
                Vector3.new(0,    5, 0),
                Vector3.new(0,   -5, 0),
                Vector3.new(10,   0, 0),
                Vector3.new(-10,  0, 0),
            }
            for _, proj in ipairs(projectiles) do
                for _, hbox in ipairs(hitboxes) do
                    for _, off in ipairs(offsets) do
                        pcall(function()
                            hrp.CFrame = CFrame.new(hrp.Position + off)
                            fireTouchOnPart(proj, hbox)
                        end)
                    end
                end
            end
        end

        pcall(function()
            hrp.CFrame                  = realCF
            hrp.AssemblyLinearVelocity  = realLV
            hrp.AssemblyAngularVelocity = realAV
        end)
    end)
end

-- =============================================
--   FULL STOP / START
-- =============================================

local function stopAll()
    stopVoidSpam()
    stopAdapt()
    stopTeleDesync()
    stopFireTouch()
    VoidState.enabled = false
    print("[VoidSpam] All systems stopped")
end

local function startAll()
    VoidState.enabled = true
    startVoidSpam()
    if VoidState.adaptEnabled     then startAdapt()      end
    if VoidState.teleDesync       then startTeleDesync()  end
    if VoidState.fireTouchEnabled then startFireTouch()   end
    print("[VoidSpam] All systems started")
end

