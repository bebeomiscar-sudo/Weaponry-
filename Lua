-- =============================================
--   PRIORITY CONFIG
-- =============================================

local PriorityCfg = {
    enabled         = false,
    voidWeight      = 500,
    voidDistance    = 2000,
    historyWindow   = 1.0,
    timeDecay       = 0.5,
    outlierZThresh  = 2.0,
    confidenceScale = 10,
}

local playerHistory = {}

local function getOrCreateHistory(p)
    if not playerHistory[p] then
        playerHistory[p] = {
            score      = 0,
            lastSeen   = tick(),
            voidEvents = {},
            inVoid     = false,
            confidence = 0,
            isOutlier  = false,
        }
    end
    return playerHistory[p]
end

local function isInVoid(player)
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local pos  = hrp.Position
    local dist = math.sqrt(pos.X^2 + pos.Y^2 + pos.Z^2)
    return dist > PriorityCfg.voidDistance
end

local function updatePriorityScores()
    local now = tick()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        local hist = getOrCreateHistory(p)
        local dt   = now - hist.lastSeen
        hist.lastSeen = now

        hist.score = hist.score * (1 - PriorityCfg.timeDecay * dt)
        hist.score = math.max(hist.score, 0)

        if isInVoid(p) then
            if not hist.inVoid then
                hist.inVoid = true
                hist.score  = hist.score + PriorityCfg.voidWeight
                table.insert(hist.voidEvents, now)
            else
                hist.score = hist.score + PriorityCfg.voidWeight * 0.01
            end
        else
            hist.inVoid = false
        end

        local newEvents = {}
        for _, t in ipairs(hist.voidEvents) do
            if now - t <= PriorityCfg.historyWindow then
                table.insert(newEvents, t)
            end
        end
        hist.voidEvents = newEvents

        local rawConf  = #hist.voidEvents * PriorityCfg.confidenceScale
        hist.confidence = math.clamp(rawConf, 0, 100)

        local scores = {}
        for _, ph in pairs(playerHistory) do
            table.insert(scores, ph.score)
        end
        local mean, variance = 0, 0
        for _, s in ipairs(scores) do mean = mean + s end
        mean = mean / math.max(#scores, 1)
        for _, s in ipairs(scores) do
            variance = variance + (s - mean)^2
        end
        variance = variance / math.max(#scores, 1)
        local std = math.sqrt(variance)
        local z   = std > 0 and (hist.score - mean) / std or 0
        hist.isOutlier = z >= PriorityCfg.outlierZThresh
    end
end

local function getVoidPriorityTarget()
    local best, bestScore = nil, -1
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        local hist = playerHistory[p]
        if not hist then continue end
        if hist.score > bestScore then
            bestScore = hist.score
            best      = p
        end
    end
    return best
end

-- =============================================
--   HVH CONFIG
-- =============================================

local HvHCfg = {
    standoffEnabled  = false,
    standoffWeight   = 5000,
    rejectDesyncJump = false,
    desyncSpeed      = 800,
    rejectJitter     = false,
    jitterRadius     = 15,
}

local hvhOpponents = {}

local function getOrCreateHvH(p)
    if not hvhOpponents[p] then
        hvhOpponents[p] = {
            lastPos        = Vector3.zero,
            posHistory     = {},
            jitterDetected = false,
            desyncJumps    = 0,
            lastTick       = tick(),
        }
    end
    return hvhOpponents[p]
end

local function detectDesyncJump(player)
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local opp   = getOrCreateHvH(player)
    local now   = tick()
    local dt    = now - opp.lastTick
    if dt <= 0 then return false end
    local d     = (hrp.Position - opp.lastPos).Magnitude
    local speed = d / dt
    opp.lastPos  = hrp.Position
    opp.lastTick = now
    if speed > HvHCfg.desyncSpeed then
        opp.desyncJumps += 1
        return true
    end
    return false
end

local function detectJitter(player)
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local opp = getOrCreateHvH(player)
    local now = tick()

    table.insert(opp.posHistory, {pos = hrp.Position, t = now})

    local trimmed = {}
    for _, entry in ipairs(opp.posHistory) do
        if now - entry.t <= 0.3 then
            table.insert(trimmed, entry)
        end
    end
    opp.posHistory = trimmed

    if #trimmed < 3 then return false end

    local minX, maxX = math.huge, -math.huge
    local minZ, maxZ = math.huge, -math.huge
    for _, entry in ipairs(trimmed) do
        minX = math.min(minX, entry.pos.X)
        maxX = math.max(maxX, entry.pos.X)
        minZ = math.min(minZ, entry.pos.Z)
        maxZ = math.max(maxZ, entry.pos.Z)
    end

    local spreadX  = maxX - minX
    local spreadZ  = maxZ - minZ
    local isJitter = spreadX < HvHCfg.jitterRadius
                 and spreadZ < HvHCfg.jitterRadius
                 and #trimmed >= 4

    opp.jitterDetected = isJitter
    return isJitter
end

