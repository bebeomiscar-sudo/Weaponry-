-- ── ShootLock ──
local function krShootLockShouldFire(lockDuration)
    local now = os.clock()
    if KR._shootLockUntil and now < KR._shootLockUntil then
        return false
    end
    KR._shootLockUntil = now + lockDuration
    return true
end
local function krShootLockReset() KR._shootLockUntil = nil end

-- ── PartGlue (weld our part to target hitbox) ──
local krGluedParts = {}
local function krPartGlueAcquire(ourPart, targetPart)
    if krGluedParts[ourPart] then
        krGluedParts[ourPart].refCount = krGluedParts[ourPart].refCount + 1
        return ourPart.CFrame
    end
    local origAnchored = ourPart.Anchored
    ourPart.Anchored = true
    krGluedParts[ourPart] = { refCount = 1, originalPart1 = targetPart, originalAnchored = origAnchored }
    return ourPart.CFrame
end
local function krPartGlueFree(part)
    local entry = krGluedParts[part]
    if not entry then return end
    entry.refCount = entry.refCount - 1
    if entry.refCount > 0 then return end
    part.Anchored = entry.originalAnchored
    krGluedParts[part] = nil
end
local function krPartGlueClear()
    for part, entry in pairs(krGluedParts) do
        if part and part.Parent then part.Anchored = entry.originalAnchored end
    end
    krGluedParts = {}
end

-- ── Helpers ──
local function krGetMyRoot()
    local c = lp.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function krGetEnemyRoot(char)
    return char and char:FindFirstChild("HumanoidRootPart")
end
local function krGetHitboxHead(char)
    if not char then return nil end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end
local function krIsAlive(char)
    if not char or not char.Parent then return false end
    local h = char:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end
local function krGetWeaponType()
    local vms = ws:FindFirstChild("ViewModels")
    if not vms then return "Gun", "Unknown" end
    local fp = vms:FindFirstChild("FirstPerson")
    if not fp then return "Gun", "Unknown" end
    for _, ch2 in ipairs(fp:GetChildren()) do
        local nm = ch2.Name:lower()
        local meleeNames = {"knife","katana","axe","sword","bat","fists","scythe","chainsaw","daggers","gunblade","trowel"}
        for _, mn in ipairs(meleeNames) do
            if nm:find(mn) then return "Melee", ch2.Name end
        end
        return "Gun", ch2.Name
    end
    return "Gun", "Unknown"
end

-- ── Target Selection ──
local function krFindTarget()
    local best, bd = nil, math.huge
    local myRoot = krGetMyRoot()
    local myPos = myRoot and myRoot.Position or Vector3.zero
    for _, p in ipairs(plr:GetPlayers()) do
        if p == lp then continue end
        if sameTm(p) then continue end
        local chr = p.Character
        if not krIsAlive(chr) then continue end
        local root = krGetEnemyRoot(chr)
        if not root then continue end
        local d = (root.Position - myPos).Magnitude
        if d < bd then bd = d; best = chr end
    end
    return best
end

-- ── SpatialLimitGate ──
local KR_LIMIT_BOUNDS = 4194304
local krSpatialMeasurements = {}
local function krSpatialGateTick(targetChar)
    local root = krGetEnemyRoot(targetChar)
    if not root then return false end
    local pos = root.Position
    if math.abs(pos.X) > KR_LIMIT_BOUNDS or math.abs(pos.Y) > KR_LIMIT_BOUNDS or math.abs(pos.Z) > KR_LIMIT_BOUNDS then
        return false
    end
    local key = targetChar
    if not krSpatialMeasurements[key] then
        krSpatialMeasurements[key] = { entryTime = os.clock(), expectedDuration = nil }
    end
    local m = krSpatialMeasurements[key]
    local now = os.clock()
    if m.expectedDuration and m.expectedDuration - KR.stability <= now - m.entryTime then
        return false
    end
    return true
end

-- ── Hitscan Strategy ──
local function krHitscanPlan(dt, targetChar, item)
    local hitboxHead = krGetHitboxHead(targetChar)
    if not hitboxHead then return nil, nil end

    local myRoot = krGetMyRoot()
    if not myRoot then return nil, nil end

    local headPos = hitboxHead.Position
    local myPos = myRoot.Position
    local isAbove = myPos.Y > headPos.Y + 2

    local offsets = { Up = -0.25, Down = 1.75 }
    local offset = isAbove and offsets.Up or offsets.Down

    local aimCFrame
    if isAbove then
        aimCFrame = CFrame.new(myPos + Vector3.new(0, offset, 0), headPos)
    else
        aimCFrame = CFrame.lookAt(myPos + Vector3.new(0, offset, 0), headPos)
    end

    local lockDuration = dt * KR.shootFrames
    if not krShootLockShouldFire(lockDuration) then
        return CFrame.new(math.random(-1e6,1e6), math.random(5000,10000), math.random(-1e6,1e6)), nil
    end

    local function fireWeapon()
        if not mUtil or not mEnum or not rUseItem then return end
        local lf = mFig and mFig.LocalFighter
        if not lf or not lf.EquippedItem then return end
        local oid = lf.EquippedItem:Get("ObjectID")
        if not oid then return end
        local payload = {
            [utf8.char(1)] = {
                [utf8.char(0)] = mUtil:EncodeCFrame(CFrame.new(myRoot.Position, headPos)),
                [utf8.char(1)] = mUtil:EncodeCFrame(CFrame.new(myRoot.Position, headPos)),
                [utf8.char(2)] = hitboxHead,
                [utf8.char(3)] = mUtil:EncodeCFrame(hitboxHead.CFrame:ToObjectSpace(CFrame.new(headPos)))
            }
        }
        for _ = 1, KR.shootAttempts do
            pcall(function()
                rUseItem:FireServer(oid, mEnum:ToEnum("StartShooting"), payload, nil)
            end)
        end
    end

    return aimCFrame, fireWeapon
end

-- ── Melee Strategy (with backstab) ──
local function krMeleePlan(dt, targetChar, item)
    local hitboxHead = krGetHitboxHead(targetChar)
    if not hitboxHead then return nil, nil, nil end

    local myRoot = krGetMyRoot()
    if not myRoot then return nil, nil, nil end

    local headPos = hitboxHead.Position
    local myPos = myRoot.Position
    local isAbove = myPos.Y > headPos.Y + 2
    local offsets = { Up = -4, Down = 4 }
    local offset = isAbove and offsets.Up or offsets.Down

    local aimCFrame
    if isAbove then
        aimCFrame = CFrame.new(myPos + Vector3.new(0, offset, 0), headPos)
    else
        aimCFrame = CFrame.lookAt(myPos + Vector3.new(0, offset, 0), headPos)
    end

    local now = os.clock()

    -- Backstab window active → heavy attack immediately
    if now < KR._hitboxWindowUntil then
        local function heavyAttack()
            if not mUtil or not mEnum or not rUseItem then return end
            local lf = mFig and mFig.LocalFighter
            if not lf or not lf.EquippedItem then return end
            local oid = lf.EquippedItem:Get("ObjectID")
            if not oid then return end
            local payload = {
                [utf8.char(1)] = {
                    [utf8.char(0)] = mUtil:EncodeCFrame(CFrame.new(myRoot.Position, headPos)),
                    [utf8.char(1)] = mUtil:EncodeCFrame(CFrame.new(myRoot.Position, headPos)),
                    [utf8.char(2)] = hitboxHead,
                    [utf8.char(3)] = mUtil:EncodeCFrame(hitboxHead.CFrame:ToObjectSpace(CFrame.new(headPos)))
                }
            }
            pcall(function() rUseItem:FireServer(oid, mEnum:ToEnum("QuickAttack"), payload, nil) end)
        end
        return aimCFrame, aimCFrame, heavyAttack
    end

    -- Shoot lock gate
    local lockDuration = dt * KR.shootFrames
    if not krShootLockShouldFire(lockDuration) then
        local invalidCF = CFrame.new(math.random(-1e6,1e6), math.random(5000,10000), math.random(-1e6,1e6))
        return invalidCF, nil, nil
    end

    -- Attack cooldown gate
    if now < KR._attackCooldownUntil then
        local invalidCF = CFrame.new(math.random(-1e6,1e6), math.random(5000,10000), math.random(-1e6,1e6))
        return invalidCF, nil, nil
    end

    -- Determine weapon name for knife check
    local _, weaponName = krGetWeaponType()
    local isKnife = weaponName and weaponName:lower():find("knife")

    if not isKnife then
        local function normalAttack()
            if not mUtil or not mEnum or not rUseItem then return end
            local lf = mFig and mFig.LocalFighter
            if not lf or not lf.EquippedItem then return end
            local oid = lf.EquippedItem:Get("ObjectID")
            if not oid then return end
            local payload = {
                [utf8.char(1)] = {
                    [utf8.char(0)] = mUtil:EncodeCFrame(CFrame.new(myRoot.Position, headPos)),
                    [utf8.char(1)] = mUtil:EncodeCFrame(CFrame.new(myRoot.Position, headPos)),
                    [utf8.char(2)] = hitboxHead,
                    [utf8.char(3)] = mUtil:EncodeCFrame(hitboxHead.CFrame:ToObjectSpace(CFrame.new(headPos)))
                }
            }
            pcall(function() rUseItem:FireServer(oid, mEnum:ToEnum("QuickAttack"), payload, nil) end)
        end
        return aimCFrame, nil, normalAttack
    end

    -- Knife → backstab heavy attack
    KR._hitboxWindowUntil = now + KR.hitboxWindow
    KR._attackCooldownUntil = now + KR.attackCooldown
    local function backstabAttack()
        if not mUtil or not mEnum or not rUseItem then return end
        local lf = mFig and mFig.LocalFighter
        if not lf or not lf.EquippedItem then return end
        local oid = lf.EquippedItem:Get("ObjectID")
        if not oid then return end
        local payload = {
            [utf8.char(1)] = {
                [utf8.char(0)] = mUtil:EncodeCFrame(CFrame.new(myRoot.Position, headPos)),
                [utf8.char(1)] = mUtil:EncodeCFrame(CFrame.new(myRoot.Position, headPos)),
                [utf8.char(2)] = hitboxHead,
                [utf8.char(3)] = mUtil:EncodeCFrame(hitboxHead.CFrame:ToObjectSpace(CFrame.new(headPos)))
            }
        }
        pcall(function() rUseItem:FireServer(oid, mEnum:ToEnum("QuickAttack"), payload, nil) end)
    end
    return aimCFrame, aimCFrame, backstabAttack
end

-- ── ProjectileBreakerTeleport ──
local PB_ESCAPE = 1073741824
local PB_MIN_POOL = 30
local pbOverlap = OverlapParams.new()
pbOverlap.FilterType = Enum.RaycastFilterType.Exclude
pbOverlap.BruteForceAllSlow = true

local function pbOscillate(rangeMin, rangeMax, freq)
    return rangeMin + (rangeMax - rangeMin) * ((math.sin(os.clock() * (2 * math.pi * freq)) + 1) * 0.5)
end
local function pbSurfaceCFrame(surface, depthUp, depthFwd)
    return CFrame.fromMatrix(
        surface.pos - surface.up * 0.01 - surface.up * depthUp + surface.forward * depthFwd,
        surface.right, surface.up, -surface.forward
    )
end
local function pbBadPart(part)
    if part.Name == "Barriers" then return true end
    if part:HasTag("OutOfBoundsPart") then return true end
    if part:HasTag("KillBrick") then return true end
    return false
end
local function pbOccluded(pos)
    local hits = ws:GetPartBoundsInBox(CFrame.new(pos), Vector3.new(64,64,64), pbOverlap)
    for _, p in ipairs(hits) do
        if pbBadPart(p) then return true end
    end
    return false
end
local function pbRaycastSurface(part)
    local origin = part.Position + Vector3.new(0, part.Size.Y/2 + 5, 0)
    local dir = Vector3.new(0, -(part.Size.Y + 10), 0)
    local res = ws:Raycast(origin, dir)
    if not res or res.Instance ~= part then return nil end
    local up = res.Normal
    local right = up:Cross(Vector3.new(0,1,0))
    if right.Magnitude < 0.001 then right = up:Cross(Vector3.new(1,0,0)) end
    right = right.Unit
    local forward = up:Cross(right).Unit
    return { pos = res.Position, up = up, right = right, forward = forward }
end
local function pbFallbackPosition(myPos)
    local anchor = Vector3.new(0, myPos.Y, 0)
    local jitter = KR.pbFallbackRadius * KR.pbFallbackJitter
    local angle = math.random() * 2 * math.pi
    local radius = KR.pbFallbackRadius + math.random() * jitter
    local x = anchor.X + math.cos(angle) * radius
    local y = anchor.Y
    local z = anchor.Z + math.sin(angle) * radius
    local axis = math.random(1,3)
    if axis == 1 then x = PB_ESCAPE
    elseif axis == 2 then y = PB_ESCAPE
    else z = PB_ESCAPE end
    return CFrame.new(x, y, z)
end
local function pbScanBatch()
    local avgUp = (KR.pbDepthUpMin + KR.pbDepthUpMax) * 0.5
    local avgFwd = (KR.pbDepthFwdMin + KR.pbDepthFwdMax) * 0.5
    for _, part in ipairs(ws:GetDescendants()) do
        if part:IsA("BasePart") and not pbBadPart(part) and not KR._pbProcessed[part] and part.Size.Magnitude > 2 then
            KR._pbProcessed[part] = true
            local surface = pbRaycastSurface(part)
            if surface then
                local test = pbSurfaceCFrame(surface, avgUp, avgFwd)
                if not pbOccluded(test.Position) then
                    table.insert(KR._pbPool, surface)
                end
            end
        end
        if #KR._pbPool >= PB_MIN_POOL * 2 then break end
    end
end
local function pbBreakLine()
    if #KR._pbPool < PB_MIN_POOL then pbScanBatch() end
    if #KR._pbPool < PB_MIN_POOL then return nil end
    KR._pbCooldown = os.clock() + KR.pbRepositionInterval
    return KR._pbPool[math.random(1, #KR._pbPool)]
end
local function pbHasProjectileThreat()
    for _, p in ipairs(plr:GetPlayers()) do
        if p == lp then continue end
        if sameTm(p) then continue end
        local chr = p.Character
        if not krIsAlive(chr) then continue end
        local tool = chr:FindFirstChildOfClass("Tool")
        if tool then
            local nm = tool.Name:lower()
            if nm:find("slingshot") or nm:find("grenade") or nm:find("molotov") or nm:find("throwable") or nm:find("tripmine") then
                return true
            end
        end
    end
    return false
end
local function pbCompute(myPos)
    if os.clock() < KR._pbCooldown and KR._pbLastSurface then
        local dUp = pbOscillate(KR.pbDepthUpMin, KR.pbDepthUpMax, KR.pbDepthUpFreq)
        local dFwd = pbOscillate(KR.pbDepthFwdMin, KR.pbDepthFwdMax, KR.pbDepthFwdFreq)
        return pbSurfaceCFrame(KR._pbLastSurface, dUp, dFwd)
    end
    if not pbHasProjectileThreat() then
        KR._pbLastSurface = nil
        return pbFallbackPosition(myPos)
    end
    local surface = pbBreakLine()
    if not surface then return pbFallbackPosition(myPos) end
    KR._pbLastSurface = surface
    local dUp = pbOscillate(KR.pbDepthUpMin, KR.pbDepthUpMax, KR.pbDepthUpFreq)
    local dFwd = pbOscillate(KR.pbDepthFwdMin, KR.pbDepthFwdMax, KR.pbDepthFwdFreq)
    return pbSurfaceCFrame(surface, dUp, dFwd)
end

-- ── Translocate Evasion ──
local function krTranslocatePosition(myPos, hasTargets)
    if not hasTargets then
        return CFrame.new(myPos + Vector3.new(math.random(-10000,10000), math.random(-10000,10000), math.random(-10000,10000)))
    end
    local taggedParts = cs:GetTagged("OutOfBoundsPart")
    local validPart = nil
    for _, part in ipairs(taggedParts) do
        if part:GetAttribute("KillDelay") == 0 then
            validPart = part
            break
        end
    end
    if validPart == nil then
        return CFrame.new(myPos + Vector3.new(math.random(-10000,10000), 1000000000, math.random(-10000,10000)))
    end
    return validPart.CFrame * CFrame.new(0, -validPart.Size.Y / 2 + KR.translocateOffset, 0)
end

-- ── Main Kicia Ragebot Heartbeat ──
rs.Heartbeat:Connect(function(dt)
    if not KR.enabled then return end

    -- Auto target
    if KR.autoTarget and (not KR.target or not KR.target.Parent or not krIsAlive(KR.target)) then
        KR.target = krFindTarget()
    end
    if not KR.target then
        KR._lastTargetWorld = nil
        krShootLockReset()
        return
    end

    -- SpatialLimitGate
    if not krSpatialGateTick(KR.target) then
        return
    end

    local myRoot = krGetMyRoot()
    if not myRoot then return end

    -- Determine weapon type
    local weaponType, weaponName = krGetWeaponType()

    -- Evasion
    local evasionCF = nil
    if KR.evasionMode == "Translocate" then
        evasionCF = krTranslocatePosition(myRoot.Position, true)
    elseif KR.evasionMode == "ProjectileBreaker" then
        evasionCF = pbCompute(myRoot.Position)
    elseif KR.evasionMode == "Random" then
        evasionCF = CFrame.new(myRoot.Position + Vector3.new(
            math.random(-500,500), math.random(-500,500), math.random(-500,500)
        ))
    end

    -- Apply evasion CFrame
    if evasionCF then
        KR._prevCF = myRoot.CFrame
        pcall(function()
            local lf = mFig and mFig.LocalFighter
            if lf and lf.Entity and lf.Entity.RootPart then
                lf.Entity.RootPart.CFrame = evasionCF
            else
                myRoot.CFrame = evasionCF
            end
        end)
    end

    -- Strategy dispatch
    if KR.autoShoot then
        if weaponType == "Gun" then
            local aimCF, fireAction = krHitscanPlan(dt, KR.target, nil)
            if fireAction then fireAction() end
        elseif weaponType == "Melee" then
            local aimCF, viewAng, weaponAction = krMeleePlan(dt, KR.target, nil)
            if weaponAction then weaponAction() end
        end
    end

    -- Forced crouch
    if KR.forcedCrouch then
        pcall(function()
            local lf = mFig and mFig.LocalFighter
            if lf and lf.Entity then
                -- Attempt to set crouch state
            end
        end)
    end

    KR._lastTargetWorld = krGetEnemyRoot(KR.target) and krGetEnemyRoot(KR.target).Position or nil
end)

