-- =============================================
--   HELPERS
-- =============================================

local function getHRP()
    local char = lp.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function betterRandom(mi, ma, dmi, dma)
    local val    = math.random(mi, ma)
    local safety = 0
    repeat
        val    = math.random(mi, ma)
        safety += 1
        if safety > 100 then break end
    until val < dmi or val > dma
    return val
end

local function getNearestEnemy()
    local hrp = getHRP()
    if not hrp then return nil end
    local best, bd = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        local char = p.Character
        if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local tHRP = char:FindFirstChild("HumanoidRootPart")
        if not tHRP then continue end
        local d = (hrp.Position - tHRP.Position).Magnitude
        if d < bd then bd = d; best = p end
    end
    return best
end

local function getBestTarget()
    if PriorityCfg.enabled then
        local voidTgt = getVoidPriorityTarget()
        if voidTgt then return voidTgt end
    end
    return getNearestEnemy()
end

local function scanProjectiles()
    local found = {}
    for _, v in ipairs(Workspace:GetChildren()) do
        if v.Name == "CoreProjectile" then table.insert(found, v) end
        for _, child in ipairs(v:GetChildren()) do
            if child.Name == "CoreProjectile" then table.insert(found, child) end
        end
    end
    return found
end

local function getHitboxes(char)
    if not char then return {} end
    local boxes    = {}
    local priority = {
        "HitBoxHeadSmall","HitBoxHead",
        "HitBoxBody","HitBoxBodySmall",
        "Head","UpperTorso","HumanoidRootPart",
    }
    for _, name in ipairs(priority) do
        local part = char:FindFirstChild(name)
        if part then table.insert(boxes, part) end
    end
    return boxes
end

local function fireTouchOnPart(projectile, hitPart)
    if not projectile or not hitPart then return false end
    local ti = nil
    for _, child in ipairs(projectile:GetChildren()) do
        if child.ClassName == "TouchTransmitter"
        or child.ClassName == "TouchInterest" then
            ti = child; break
        end
    end
    if not ti then return false end
    local ok = pcall(firetouchinterest, hitPart, ti, 0)
    if not ok then pcall(firetouchinterest, hitPart, ti, 1) end
    return ok
end

