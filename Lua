-- GAME LOOP
-- ═══════════════════════════════════════════════════════════════════════
local GameLoop = {}
GameLoop.__index = GameLoop

function GameLoop.new()
    return setmetatable({
        _trove           = Trove.new("GameLoop"),
        _preCameraRender = nil,
        _preRender       = nil,
        _preSimulation   = nil,
        _heartbeat       = nil,
    }, GameLoop)
end

function GameLoop:SetPreCameraRender(fn) self._preCameraRender = fn end
function GameLoop:SetPreRender(fn)       self._preRender       = fn end
function GameLoop:SetPreSimulation(fn)   self._preSimulation   = fn end
function GameLoop:SetHeartbeat(fn)       self._heartbeat       = fn end

function GameLoop:Start()
    if self._preCameraRender then
        local guid = HttpService:GenerateGUID(false)
        RunService:BindToRenderStep(
            guid,
            Enum.RenderPriority.Camera.Value - 1,
            self._preCameraRender
        )
        self._trove:Add(function()
            RunService:UnbindFromRenderStep(guid)
        end)
    end
    if self._preRender     then self._trove:Connect(RunService.PreRender,     self._preRender)     end
    if self._preSimulation then self._trove:Connect(RunService.PreSimulation, self._preSimulation) end
    if self._heartbeat     then self._trove:Connect(RunService.Heartbeat,     self._heartbeat)     end
end

function GameLoop:Destroy()
    self._trove:Destroy()
end

