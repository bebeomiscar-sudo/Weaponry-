-- =============================================
--   KICIA DETECTION ENGINE
-- =============================================

--[[
    KiciaHook signature detection:
    
    FREE VERSION signs:
    - HRP lifts to ~100k studs
    - Periodic (every ~0.1s)
    - Velocity is zero or near-zero
    - Pattern is predictable
    
    PREMIUM VERSION signs:
    - HRP lifts to variable heights (50k-500k)
    - Much faster cycle (~0.05s or less)
    - Uses velocity manipulation too
    - Position changes are less predictable
    - They have resolver running
]]

local kiciaSignatures = {}
-- { [player] = {
--     lastHRPY = number,
--     liftCount = number,
--     liftTimes = {},
--     avgLiftInterval = number,
--     maxLiftHeight = number,
--     isPremium = bool,
-- }}

local function getOrCreateSig(p)
    if not kiciaSignatures[p] then
        kiciaSignatures[p] = {
            lastHRPY        = 0,
            liftCount       = 0,
            liftTimes       = {},
            avgLiftInterval = 0,
            maxLiftHeight   = 0,
            isPremium       = false,
            lastPos         = Vector3.zero,
            posChanges      = {},
        }
    end
    return kiciaSignatures[p]
end

local function updateKiciaSignature(p)
    local char = p.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local sig = getOrCreateSig(p)
    local pos  = hrp.Position
    local absY = math.abs(pos.Y)
    local now  = tick()

    -- Detect void lift (sudden Y > 50000)
    if absY > 50000 and sig.lastHRPY < 50000 then
        sig.liftCount += 1
        table.insert(sig.liftTimes, now)

        -- Keep last 10 lifts
        if #sig.liftTimes > 10 then
            table.remove(sig.liftTimes, 1)
        end

        sig.maxLiftHeight = math.max(sig.maxLiftHeight, absY)

        -- Calculate average lift interval
        if #sig.liftTimes >= 2 then
            local total = 0
            for i = 2, #sig.liftTimes do
                total += sig.liftTimes[i] - sig.liftTimes[i-1]
            end
            sig.avgLiftInterval = total / (#sig.liftTimes - 1)
        end

        -- Premium detection:
        -- Fast interval (<0.08s) AND variable heights = premium
        local isPremium = sig.avgLiftInterval < 0.08
                       or sig.maxLiftHeight > 200000

        sig.isPremium = isPremium

        if sig.liftCount >= 3 then
            -- This player is using KiciaHook!
            AntiKiciaCfg.detectedKicia = true
            AntiKiciaCfg.kiciaTarget   = p
            AntiKiciaCfg.detectedTick  = now
            AntiKiciaCfg.kiciaVersion  = isPremium and "Premium" or "Free"

            -- Add to history
            if not AntiKiciaCfg.kiciaHistory[p] then
                AntiKiciaCfg.kiciaHistory[p] = {
                    voidLifts = 0,
                    lastLift  = 0,
                    isKicia   = true,
                    isPremium = isPremium,
                }
            end
            AntiKiciaCfg.kiciaHistory[p].voidLifts += 1
            AntiKiciaCfg.kiciaHistory[p].lastLift   = now
            AntiKiciaCfg.kiciaHistory[p].isPremium  = isPremium
        end
    end

    sig.lastHRPY = absY
    sig.lastPos  = pos
end

-- =============================================
--   ANTI-RESOLVER SYSTEM
-- =============================================

--[[
    KiciaHook Premium resolver works by:
    1. Recording your last N positions
    2. Fitting a curve through them
    3. Predicting where you'll be at fire time
    
    To defeat resolver:
    1. FAKE HISTORY: Broadcast fake positions that
       form an impossible pattern (circle, random cloud)
       This makes their curve-fit give wrong prediction
    
    2. SUDDEN DIRECTION CHANGE: Every N ticks,
       instantly reverse movement direction
       Breaks extrapolation
    
    3. MULTI-LAYER: Be in multiple "positions" at once
       (quickly cycle between 3+ positions)
       Resolver cant pick the real one
]]

local fakeHistoryPositions = {}
local fakeHistoryAngle     = 0
local fakeHistoryTimer     = 0

local function generateFakePositions()
    -- Generate a cloud of fake positions around real position
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end

    local real   = hrp.Position
    local radius = AntiKiciaCfg.resolverRadius
    local positions = {}

    -- Circle pattern (confuses linear extrapolation)
    for i = 0, AntiKiciaCfg.resolverLayers - 1 do
        local angle = (fakeHistoryAngle + (i / AntiKiciaCfg.resolverLayers) * math.pi * 2)
        table.insert(positions, Vector3.new(
            real.X + math.cos(angle) * radius,
            real.Y,
            real.Z + math.sin(angle) * radius
        ))
    end

    -- Random scatter positions
    for i = 1, AntiKiciaCfg.resolverLayers do
        table.insert(positions, Vector3.new(
            real.X + math.random(-radius, radius),
            real.Y + math.random(-5, 5),
            real.Z + math.random(-radius, radius)
        ))
    end

    fakeHistoryAngle = (fakeHistoryAngle + AntiKiciaCfg.resolverSpeed) % (math.pi * 2)
    return positions
end

local function startFakeHistory()
    if AntiKiciaCfg.fakeHistoryConn then
        AntiKiciaCfg.fakeHistoryConn:Disconnect()
        AntiKiciaCfg.fakeHistoryConn = nil
    end

    AntiKiciaCfg.fakeHistoryConn = RunService.Heartbeat:Connect(function(dt)
        if not AntiKiciaCfg.fakeHistoryOn then return end

        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local savedCF = hrp.CFrame
        local savedLV = hrp.AssemblyLinearVelocity
        local savedAV = hrp.AssemblyAngularVelocity

        local fakePositions = generateFakePositions()

        -- Flash through fake positions extremely quickly
        for _, fakePos in ipairs(fakePositions) do
            pcall(function()
                hrp.CFrame = CFrame.new(fakePos)
                hrp.AssemblyLinearVelocity = Vector3.new(
                    math.random(-100, 100),
                    math.random(-100, 100),
                    math.random(-100, 100)
                )
            end)
            -- Extremely brief — just enough to register
        end

        -- Restore immediately
        pcall(function()
            hrp.CFrame                  = savedCF
            hrp.AssemblyLinearVelocity  = savedLV
            hrp.AssemblyAngularVelocity = savedAV
        end)
    end)
end

local function stopFakeHistory()
    AntiKiciaCfg.fakeHistoryOn = false
    if AntiKiciaCfg.fakeHistoryConn then
        AntiKiciaCfg.fakeHistoryConn:Disconnect()
        AntiKiciaCfg.fakeHistoryConn = nil
    end
end

-- =============================================
--   MULTI-LAYER DESYNC
-- =============================================

--[[
    Standard desync: 1 void position
    
    Multi-layer desync:
    Layer 1: Random void position (standard)
    Layer 2: Opposite void position (confuses tracker)
    Layer 3: Position near target (for hit registration)
    
    Each layer runs on different RenderStep priorities
    Result: Server sees you in 3 places at once
    KiciaHook premium cant resolve all 3
]]

local multiDesyncLayers = {}

local function startMultiLayerDesync()
    -- Clear existing
    for _, conn in ipairs(multiDesyncLayers) do
        pcall(function() conn:Disconnect() end)
    end
    multiDesyncLayers = {}
    for i = 1, 3 do
        pcall(function()
            RunService:UnbindFromRenderStep("__mlDesync"..i)
        end)
    end

    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local layerPositions = {
        Vector3.zero,
        Vector3.zero,
        Vector3.zero,
    }

    -- Layer generator loop
    local genConn = RunService.Heartbeat:Connect(function()
        if not AntiKiciaCfg.multiLayerDesync then return end
        local h = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if not h then return end

        local tgt = AntiKiciaCfg.kiciaTarget
        local tHRP = tgt and tgt.Character and tgt.Character:FindFirstChild("HumanoidRootPart")

        -- Layer 1: Random void (confuse tracker)
        layerPositions[1] = Vector3.new(
            math.random(-500000, 500000),
            VOID_HEIGHT + math.random(0, 100000),
            math.random(-500000, 500000)
        )

        -- Layer 2: Opposite of layer 1 (break linear resolver)
        layerPositions[2] = Vector3.new(
            -layerPositions[1].X * 0.7,
            VOID_HEIGHT * 1.5,
            -layerPositions[1].Z * 0.7
        )

        -- Layer 3: Near target for hit registration
        if tHRP then
            layerPositions[3] = Vector3.new(
                tHRP.Position.X + math.random(-2, 2),
                tHRP.Position.Y + VOID_HEIGHT,
                tHRP.Position.Z + math.random(-2, 2)
            )
        else
            layerPositions[3] = layerPositions[1]
        end
    end)
    table.insert(multiDesyncLayers, genConn)

    -- Apply layers at different render priorities
    local layerIndex = 1
    RunService:BindToRenderStep("__mlDesync1", 200, function()
        if not AntiKiciaCfg.multiLayerDesync then return end
        local h = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if not h then return end
        pcall(function()
            h.CFrame = CFrame.new(layerPositions[layerIndex])
        end)
        layerIndex = (layerIndex % AntiKiciaCfg.layerCount) + 1
    end)
end

local function stopMultiLayerDesync()
    AntiKiciaCfg.multiLayerDesync = false
    for _, conn in ipairs(multiDesyncLayers) do
        pcall(function() conn:Disconnect() end)
    end
    multiDesyncLayers = {}
    for i = 1, 3 do
        pcall(function() RunService:UnbindFromRenderStep("__mlDesync"..i) end)
    end
end

-- =============================================
--   PREDICTION COUNTER
-- =============================================

--[[
    When KiciaHook premium fires:
    1. We detect their void lift (signature)
    2. We predict exactly when their shot arrives
       (based on their avgLiftInterval)
    3. We fire BEFORE they do
    
    This turns their own timing against them
    We know when they shoot because of their pattern
]]

local predHistory = {}
-- Track enemy projectile creation times

local function predictNextKiciaShot(p)
    local sig = kiciaSignatures[p]
    if not sig or sig.liftCount < 3 then return nil end
    local now = tick()
    -- Next shot = last lift + average interval
    local nextShot = (sig.liftTimes[#sig.liftTimes] or now) + sig.avgLiftInterval
    local timeUntil = nextShot - now
    return timeUntil, nextShot
end

local function startPredictionCounter()
    if AntiKiciaCfg.counterConn then
        AntiKiciaCfg.counterConn:Disconnect()
        AntiKiciaCfg.counterConn = nil
    end

    AntiKiciaCfg.counterConn = RunService.Heartbeat:Connect(function()
        if not AntiKiciaCfg.predictionCounter then return end
        if not AntiKiciaCfg.kiciaTarget then return end

        local p   = AntiKiciaCfg.kiciaTarget
        local sig = kiciaSignatures[p]
        if not sig then return end

        -- Detect their void lift in real time
        pcall(function() updateKiciaSignature(p) end)

        -- Predict next shot
        local timeUntil, _ = predictNextKiciaShot(p)
        if not timeUntil then return end

        -- If shot is imminent (within 50ms) pre-fire
        if timeUntil < 0.05 and timeUntil > -0.1 then
            local char = p.Character
            if not char then return end
            local hrp = getHRP()
            if not hrp then return end

            task.spawn(function()
                -- Pre-emptive FireTouch
                if not firetouchinterest then return end

                local savedCF = hrp.CFrame
                local savedLV = hrp.AssemblyLinearVelocity
                local savedAV = hrp.AssemblyAngularVelocity

                pcall(function()
                    hrp.CFrame = CFrame.new(hrp.Position.X, VOID_HEIGHT, hrp.Position.Z)
                end)

                task.wait(0.02)

                local hitboxes = {}
                local hbPriority = {
                    "HitBoxHeadSmall","HitBoxHead",
                    "HitBoxBody","Head","UpperTorso"
                }
                for _, name in ipairs(hbPriority) do
                    local part = char:FindFirstChild(name)
                    if part then table.insert(hitboxes, part) end
                end

                local projs = {}
                for _, v in ipairs(Workspace:GetChildren()) do
                    if v.Name == "CoreProjectile" then table.insert(projs, v) end
                end

                for _, proj in ipairs(projs) do
                    for _, hbox in ipairs(hitboxes) do
                        local ti = nil
                        for _, child in ipairs(proj:GetChildren()) do
                            if child.ClassName == "TouchTransmitter"
                            or child.ClassName == "TouchInterest" then
                                ti = child; break
                            end
                        end
                        if ti then
                            pcall(firetouchinterest, hbox, ti, 0)
                            pcall(firetouchinterest, hbox, ti, 1)
                        end
                    end
                end

                pcall(function()
                    hrp.CFrame                  = savedCF
                    hrp.AssemblyLinearVelocity  = savedLV
                    hrp.AssemblyAngularVelocity = savedAV
                end)

                notify("Prediction Counter", "Pre-fired on "..p.Name.."! ("..string.format("%.0f",timeUntil*1000).."ms early)",2)
            end)
        end
    end)
end

-- =============================================
--   INSTANT COUNTER (when they lift to void)
-- =============================================

local instantCounterConn = nil
local lastInstantFire     = 0

local function startInstantCounter()
    if instantCounterConn then
        instantCounterConn:Disconnect()
        instantCounterConn = nil
    end

    instantCounterConn = RunService.Heartbeat:Connect(function()
        if not AntiKiciaCfg.instantCounter then return end
        local now = tick()
        if now - lastInstantFire < 0.1 then return end

        for _, p in ipairs(Players:GetPlayers()) do
            if p == lp then continue end
            local char = p.Character
            if not char then continue end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end

            -- Detect void lift signature
            local absY = math.abs(hrp.Position.Y)
            if absY > 50000 then
                -- They are in void RIGHT NOW
                -- This is when KiciaHook fires
                -- We fire back instantly
                lastInstantFire = now

                task.spawn(function()
                    if not firetouchinterest then return end
                    local myHRP = getHRP()
                    if not myHRP then return end

                    local savedCF = myHRP.CFrame
                    local savedLV = myHRP.AssemblyLinearVelocity
                    local savedAV = myHRP.AssemblyAngularVelocity

                    -- Lift to same void height as them
                    pcall(function()
                        myHRP.CFrame = CFrame.new(
                            hrp.Position.X,  -- Go to their void X
                            hrp.Position.Y,  -- Match their void Y
                            hrp.Position.Z   -- Match their void Z
                        )
                    end)

                    task.wait(0.03)

                    -- Fire at their hitboxes
                    local hitboxes = {}
                    local hbPriority = {
                        "HitBoxHeadSmall","HitBoxHead",
                        "HitBoxBody","Head","UpperTorso"
                    }
                    for _, name in ipairs(hbPriority) do
                        local part = char:FindFirstChild(name)
                        if part then table.insert(hitboxes, part) end
                    end

                    local projs = {}
                    for _, v in ipairs(Workspace:GetChildren()) do
                        if v.Name == "CoreProjectile" then table.insert(projs, v) end
                    end

                    -- Fire multiple times
                    for shot = 1, 3 do
                        for _, proj in ipairs(projs) do
                            for _, hbox in ipairs(hitboxes) do
                                local ti = nil
                                for _, child in ipairs(proj:GetChildren()) do
                                    if child.ClassName == "TouchTransmitter"
                                    or child.ClassName == "TouchInterest" then
                                        ti = child; break
                                    end
                                end
                                if ti then
                                    pcall(firetouchinterest, hbox, ti, 0)
                                    pcall(firetouchinterest, hbox, ti, 1)
                                end
                            end
                        end
                        if shot < 3 then task.wait(0.015) end
                    end

                    pcall(function()
                        myHRP.CFrame                  = savedCF
                        myHRP.AssemblyLinearVelocity  = savedLV
                        myHRP.AssemblyAngularVelocity = savedAV
                    end)

                    notify("Instant Counter","Fired back at "..p.Name.." in void!",2)
                end)
            end
        end
    end)
end

local function stopInstantCounter()
    AntiKiciaCfg.instantCounter = false
    if instantCounterConn then
        instantCounterConn:Disconnect()
        instantCounterConn = nil
    end
end

