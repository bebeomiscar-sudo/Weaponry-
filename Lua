-- CHAMS (per-part handle adornments)
-- ═══════════════════════════════════════════════════════════════════════
local GLOW_INTENSITY = 5

local function glowColorFrom(base)
    return Color3.new(
        math.clamp(base.R * GLOW_INTENSITY, 0, 1),
        math.clamp(base.G * GLOW_INTENSITY, 0, 1),
        math.clamp(base.B * GLOW_INTENSITY, 0, 1)
    )
end

local Chams = {}
Chams.__index = Chams

function Chams.new()
    return setmetatable({
        _trove              = Trove.new("Chams"),
        _partAdornments     = {},
        _innerColor         = Color3.fromRGB(255,50,50),
        _outlineColor       = Color3.fromRGB(80,0,0),
        _innerTransparency  = 0,
        _outlineTransparency= 0.5,
        _glowEnabled        = false,
        _glowColor          = Color3.fromRGB(255,50,50),
        _enabled            = false,
        _adormentFolder     = Instance.new("Folder"),
    }, Chams)
end

function Chams:SetLook(innerColor, innerAlpha, outlineColor, outlineAlpha, glowEnabled, glowColor)
    self._innerColor          = innerColor
    self._innerTransparency   = innerAlpha
    self._outlineColor        = outlineColor
    self._outlineTransparency = outlineAlpha
    self._glowEnabled         = glowEnabled
    self._glowColor           = glowColor

    local glowBright = glowColorFrom(glowColor)
    for _, set in pairs(self._partAdornments) do
        set.inner.Color3           = innerColor
        set.inner.Transparency     = innerAlpha
        set.outline.Color3         = outlineColor
        set.outline.Transparency   = outlineAlpha
        set.glow.Color3            = glowBright
        set.glow.Visible           = glowEnabled
    end
end

function Chams:_AddPart(part)
    if self._partAdornments[part] then return end

    local function makeAdorn(cls)
        local a = Instance.new(cls)
        a.Adornee  = part
        a.Visible  = true
        a.Parent   = self._adormentFolder
        return a
    end

    local inner, outline, glow

    if part.Name == "Head" then
        inner   = makeAdorn("CylinderHandleAdornment")
        outline = makeAdorn("CylinderHandleAdornment")
        glow    = makeAdorn("CylinderHandleAdornment")
        local cf = CFrame.Angles(math.pi/2, 0, 0)
        inner.CFrame   = cf; inner.Radius   = 0.54; inner.Height   = 1.12
        outline.CFrame = cf; outline.Radius = 0.62; outline.Height = 1.30
        glow.CFrame    = cf; glow.Radius    = 0.55; glow.Height    = 1.14
    else
        inner   = makeAdorn("BoxHandleAdornment")
        outline = makeAdorn("BoxHandleAdornment")
        glow    = makeAdorn("BoxHandleAdornment")
        inner.Size   = part.Size + Vector3.one * 0.02
        outline.Size = part.Size + Vector3.one * 0.12
        glow.Size    = part.Size + Vector3.one * 0.03
    end

    inner.AlwaysOnTop   = true
    inner.Color3        = self._innerColor
    inner.Transparency  = self._innerTransparency
    inner.ZIndex        = 2

    outline.AlwaysOnTop  = false
    outline.Color3       = self._outlineColor
    outline.Transparency = self._outlineTransparency
    outline.ZIndex       = -1

    glow.AlwaysOnTop  = true
    glow.Color3       = glowColorFrom(self._glowColor)
    glow.Transparency = -1
    glow.ZIndex       = 3
    glow.Visible      = self._glowEnabled

    self._partAdornments[part] = {
        inner   = inner,
        outline = outline,
        glow    = glow,
    }
end

function Chams:_RemovePart(part)
    local set = self._partAdornments[part]
    if not set then return end
    self._partAdornments[part] = nil
    set.inner:Destroy()
    set.outline:Destroy()
    set.glow:Destroy()
end

function Chams:SelectModel(character)
    if not character then return end
    self._adormentFolder.Parent = character

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and SKELETON_PARTS[part.Name] then
            self:_AddPart(part)
        end
    end

    self._trove:Connect(character.DescendantAdded, function(child)
        if child:IsA("BasePart") and SKELETON_PARTS[child.Name] then
            self:_AddPart(child)
        end
    end)
    self._trove:Connect(character.DescendantRemoving, function(child)
        if child:IsA("BasePart") then self:_RemovePart(child) end
    end)
end

function Chams:DeselectModel()
    for part in pairs(self._partAdornments) do
        self:_RemovePart(part)
    end
    self._trove:Clean()
    self._adormentFolder.Parent = nil
end

function Chams:SetEnabled(state)
    self._enabled = state
    for _, set in pairs(self._partAdornments) do
        set.inner.Visible   = state
        set.outline.Visible = state
        set.glow.Visible    = state and self._glowEnabled
    end
end

function Chams:Destroy()
    self:DeselectModel()
    self._trove:Destroy()
    self._adormentFolder:Destroy()
end

-- ═══════════════════════════════════════════════════════════════════════
-- SKELETON (2D lines connecting body parts)
-- ═══════════════════════════════════════════════════════════════════════
local Skeleton = {}
Skeleton.__index = Skeleton

-- Bone connections: [part] → {part0, part1}
local BONE_MAP = {
    { "Head",         "UpperTorso" },
    { "UpperTorso",   "LowerTorso" },
    { "LowerTorso",   "HumanoidRootPart" },
    { "LeftUpperArm", "UpperTorso" },
    { "LeftLowerArm", "LeftUpperArm" },
    { "LeftHand",     "LeftLowerArm" },
    { "RightUpperArm","UpperTorso" },
    { "RightLowerArm","RightUpperArm" },
    { "RightHand",    "RightLowerArm" },
    { "LeftUpperLeg", "LowerTorso" },
    { "LeftLowerLeg", "LeftUpperLeg" },
    { "LeftFoot",     "LeftLowerLeg" },
    { "RightUpperLeg","LowerTorso" },
    { "RightLowerLeg","RightUpperLeg" },
    { "RightFoot",    "RightLowerLeg" },
}

function Skeleton.new(screenGui)
    return setmetatable({
        _trove            = Trove.new("Skeleton"),
        _screenGui        = screenGui,
        _lines            = {},
        _color            = Color3.fromRGB(255,100,100),
        _transparency     = 0,
        _thickness        = 1,
        _enabled          = false,
        _model            = nil,
    }, Skeleton)
end

function Skeleton:_MakeLine()
    local f = Instance.new("Frame")
    f.Visible                = false
    f.BorderSizePixel        = 0
    f.BackgroundColor3       = self._color
    f.BackgroundTransparency = self._transparency
    f.AnchorPoint            = Vector2.new(0.5, 0.5)
    f.Parent                 = self._screenGui
    return f
end

function Skeleton:SelectModel(character)
    self:DeselectModel()
    self._model = character

    for _, bone in ipairs(BONE_MAP) do
        local p0 = character:FindFirstChild(bone[1])
        local p1 = character:FindFirstChild(bone[2])
        if p0 and p1 then
            local line = self:_MakeLine()
            table.insert(self._lines, { line = line, p0 = p0, p1 = p1 })
        end
    end
end

function Skeleton:DeselectModel()
    for _, entry in ipairs(self._lines) do
        entry.line:Destroy()
    end
    self._lines = {}
    self._model = nil
    self._trove:Clean()
end

function Skeleton:SetEnabled(state)
    self._enabled = state
    for _, entry in ipairs(self._lines) do
        entry.line.Visible = false -- update() will show when on-screen
    end
    if not state then
        for _, entry in ipairs(self._lines) do
            entry.line.Visible = false
        end
    end
end

function Skeleton:SetLook(color, transparency, thickness)
    self._color        = color
    self._transparency = transparency
    self._thickness    = thickness
    for _, entry in ipairs(self._lines) do
        entry.line.BackgroundColor3       = color
        entry.line.BackgroundTransparency = transparency
    end
end

--[[
    Update: draws 2D lines between projected bone positions each frame
]]
function Skeleton:Update()
    if not self._enabled or not self._model then return end

    for _, entry in ipairs(self._lines) do
        local p0, p1 = entry.p0, entry.p1
        if not (p0.Parent and p1.Parent) then
            entry.line.Visible = false
            continue
        end

        local sp0, on0 = cam:WorldToViewportPoint(p0.Position)
        local sp1, on1 = cam:WorldToViewportPoint(p1.Position)

        if not (on0 and on1 and sp0.Z > 0 and sp1.Z > 0) then
            entry.line.Visible = false
            continue
        end

        local v0     = Vector2.new(sp0.X, sp0.Y)
        local v1     = Vector2.new(sp1.X, sp1.Y)
        local mid    = (v0 + v1) * 0.5
        local diff   = v1 - v0
        local length = diff.Magnitude
        local angle  = math.atan2(diff.Y, diff.X)

        local line = entry.line
        line.Visible  = true
        line.Position = UDim2.fromOffset(mid.X, mid.Y)
        line.Size     = UDim2.fromOffset(length, self._thickness)
        line.Rotation = math.deg(angle)
    end
end

function Skeleton:Destroy()
    self:DeselectModel()
    self._trove:Destroy()
end

-- ═══════════════════════════════════════════════════════════════════════
-- TRACER (line from screen bottom to target)
-- ═══════════════════════════════════════════════════════════════════════
local Tracer = {}
Tracer.__index = Tracer

function Tracer.new(screenGui)
    local self = setmetatable({
        _screenGui    = screenGui,
        _targetPart   = nil,
        _visible      = false,
        _color        = Color3.fromRGB(255,50,50),
        _transparency = 0,
        _thickness    = 1.5,
        _origin       = "Bottom",  -- "Bottom" | "Center" | "Mouse"
        _target       = "Feet",    -- "Feet" | "Head" | "Center"
        _enabled      = false,
    }, Tracer)

    local outline = Instance.new("Frame")
    outline.Visible                = false
    outline.BorderSizePixel        = 0
    outline.AnchorPoint            = Vector2.new(0.5, 0.5)
    outline.BackgroundColor3       = Color3.new(0,0,0)
    outline.BackgroundTransparency = 0
    outline.ZIndex                 = 0
    outline.Parent                 = screenGui
    self._outline = outline

    local line = Instance.new("Frame")
    line.Visible                = false
    line.BorderSizePixel        = 0
    line.AnchorPoint            = Vector2.new(0.5, 0.5)
    line.BackgroundColor3       = Color3.new(1,1,1)
    line.BackgroundTransparency = 0
    line.ZIndex                 = 1
    line.Parent                 = screenGui
    self._line = line

    return self
end

function Tracer:SetTarget(part)
    self._targetPart = part
end

function Tracer:ClearTarget()
    self._targetPart = nil
    self._line.Visible    = false
    self._outline.Visible = false
end

function Tracer:SetEnabled(state)
    self._enabled = state
    if not state then
        self._line.Visible    = false
        self._outline.Visible = false
    end
end

function Tracer:SetLook(color, transparency, thickness)
    self._color        = color
    self._transparency = transparency
    self._thickness    = thickness
    self._line.BackgroundColor3       = color
    self._line.BackgroundTransparency = transparency
end

function Tracer:Update()
    if not self._enabled or not self._targetPart then
        self._line.Visible    = false
        self._outline.Visible = false
        return
    end

    local sp, onScreen = cam:WorldToViewportPoint(self._targetPart.Position)
    if not onScreen or sp.Z <= 0 then
        self._line.Visible    = false
        self._outline.Visible = false
        return
    end

    local vp    = cam.ViewportSize
    local from  = Vector2.new(vp.X / 2, vp.Y)  -- bottom center
    local to    = Vector2.new(sp.X, sp.Y)
    local diff  = to - from
    local len   = diff.Magnitude
    local angle = math.atan2(diff.Y, diff.X)
    local mid   = (from + to) * 0.5
    local thick = self._thickness

    self._line.Visible   = true
    self._line.Position  = UDim2.fromOffset(mid.X, mid.Y)
    self._line.Size      = UDim2.fromOffset(len, thick)
    self._line.Rotation  = math.deg(angle)

    self._outline.Visible   = true
    self._outline.Position  = UDim2.fromOffset(mid.X, mid.Y)
    self._outline.Size      = UDim2.fromOffset(len, thick + 2)
    self._outline.Rotation  = math.deg(angle)
end

function Tracer:Destroy()
    self._line:Destroy()
    self._outline:Destroy()
end

-- ═══════════════════════════════════════════════════════════════════════
-- HACKER DETECTOR
-- ═══════════════════════════════════════════════════════════════════════
local HackerDetector = {}
HackerDetector.__index = HackerDetector

local HD_SPEED_THRESHOLD = 200
local HD_SPEED_WINDOW    = 0.25
local HD_NOTIFY_COOLDOWN = 10

function HackerDetector.new(screenGui)
    local self = setmetatable({
        _trove         = Trove.new("HackerDetector"),
        _screenGui     = screenGui,
        _enabled       = false,
        _shouldNotify  = true,
        _tagColor      = Color3.fromRGB(255, 50, 50),
        _speedTimers   = {},
        _lastPositions = {},
        _lastPosTime   = {},
        _notified      = {},
        _labels        = {},
        _notifyCooldown= {},
    }, HackerDetector)
    return self
end

function HackerDetector:SetEnabled(state)
    self._enabled = state
    if not state then
        for p, lbl in pairs(self._labels) do
            lbl:Destroy()
            self._labels[p] = nil
        end
    end
end

function HackerDetector:SetNotify(state)
    self._shouldNotify = state
end

function HackerDetector:SetColor(color)
    self._tagColor = color
    for _, lbl in pairs(self._labels) do
        lbl.TextColor3 = color
    end
end

function HackerDetector:_IsMovingTooFast(player)
    local chr = player.Character
    if not chr then return false end
    local hrp = chr:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local now = os.clock()
    local pos = hrp.Position
    local lastPos  = self._lastPositions[player]
    local lastTime = self._lastPosTime[player]

    self._lastPositions[player] = pos
    self._lastPosTime[player]   = now

    if not lastPos or not lastTime then return false end

    local dt    = now - lastTime
    local dist  = (pos - lastPos).Magnitude
    local speed = dt > 0 and (dist / dt) or 0

    if speed > HD_SPEED_THRESHOLD then
        self._speedTimers[player] = (self._speedTimers[player] or 0) + dt
    else
        self._speedTimers[player] = 0
    end

    return (self._speedTimers[player] or 0) >= HD_SPEED_WINDOW
end

function HackerDetector:_TagPlayer(player)
    if self._labels[player] then return end

    local lbl = Instance.new("BillboardGui")
    lbl.Size          = UDim2.fromOffset(200, 30)
    lbl.StudsOffset   = Vector3.new(0, 3, 0)
    lbl.AlwaysOnTop   = true

    local txt = Instance.new("TextLabel", lbl)
    txt.Size                   = UDim2.fromScale(1, 1)
    txt.BackgroundTransparency = 1
    txt.Text                   = "⚠ HACKER"
    txt.TextColor3             = self._tagColor
    txt.Font                   = Enum.Font.GothamBold
    txt.TextSize               = 14
    txt.TextStrokeTransparency = 0

    local chr = player.Character
    if chr then
        local hrp = chr:FindFirstChild("HumanoidRootPart")
        if hrp then lbl.Adornee = hrp end
    end

    lbl.Parent          = self._screenGui
    self._labels[player] = lbl

    -- Notify via warn (Library notify may not exist without full lib context)
    local now = os.clock()
    local cooldown = self._notifyCooldown[player] or 0
    if self._shouldNotify and now > cooldown then
        self._notifyCooldown[player] = now + HD_NOTIFY_COOLDOWN
        warn("[HackerDetector] Possible hacker: " .. player.DisplayName)
        -- If Library:Notify exists use it:
        pcall(function()
            Library:Notify(player.DisplayName .. " may be hacking!", 5)
        end)
    end
end

function HackerDetector:Update()
    if not self._enabled then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == lp then continue end

        if self:_IsMovingTooFast(player) then
            self:_TagPlayer(player)
        else
            -- Remove tag if they stopped hacking
            if self._labels[player] then
                self._labels[player]:Destroy()
                self._labels[player] = nil
                self._notified[player] = nil
            end
        end

        -- Keep billboard attached to character
        if self._labels[player] then
            local chr = player.Character
            local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
            self._labels[player].Adornee = hrp or nil
        end
    end

    -- Clean up labels for players who left
    for player, lbl in pairs(self._labels) do
        if not player.Parent then
            lbl:Destroy()
            self._labels[player] = nil
            self._speedTimers[player]   = nil
            self._lastPositions[player] = nil
            self._lastPosTime[player]   = nil
        end
    end
end

function HackerDetector:Destroy()
    self:SetEnabled(false)
    self._trove:Destroy()
end

-- ═══════════════════════════════════════════════════════════════════════
-- NOCLIP
-- ═══════════════════════════════════════════════════════════════════════
local Noclip = {}
Noclip.__index = Noclip

function Noclip.new()
    local self = setmetatable({
        _trove          = Trove.new("Noclip"),
        _collidableParts = {},
        _enabled        = false,
    }, Noclip)

    -- Re-bind on respawn
    self._trove:Connect(lp.CharacterAdded, function(chr)
        self:_BindCharacter(chr)
    end)
    if lp.Character then
        self:_BindCharacter(lp.Character)
    end

    return self
end

function Noclip:_BindCharacter(character)
    table.clear(self._collidableParts)
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            self._collidableParts[part] = true
        end
    end
    self._trove:Connect(character.DescendantAdded, function(child)
        if child:IsA("BasePart") then
            self._collidableParts[child] = true
        end
    end)
    self._trove:Connect(character.DescendantRemoving, function(child)
        if child:IsA("BasePart") then
            self._collidableParts[child] = nil
        end
    end)
end

function Noclip:SetEnabled(state)
    if self._enabled and not state then
        -- Restore collision on disable
        for part in pairs(self._collidableParts) do
            pcall(function() part.CanCollide = true end)
        end
    end
    self._enabled = state
end

function Noclip:Update()
    if not self._enabled then return end
    for part in pairs(self._collidableParts) do
        pcall(function() part.CanCollide = false end)
    end
end

function Noclip:Destroy()
    self:SetEnabled(false)
    self._trove:Destroy()
end

-- ═══════════════════════════════════════════════════════════════════════
-- FOV CHANGER (GuardedInstance wrapping CurrentCamera)
-- ═══════════════════════════════════════════════════════════════════════
local FovChanger = {}
FovChanger.__index = FovChanger

function FovChanger.new()
    local self = setmetatable({
        _trove      = Trove.new("FovChanger"),
        _guard      = nil,
        _enabled    = false,
        _value      = 80,
    }, FovChanger)

    self._trove:Connect(
        Workspace:GetPropertyChangedSignal("CurrentCamera"),
        function() self:_BindCamera() end
    )
    self:_BindCamera()
    return self
end

function FovChanger:_BindCamera()
    if self._guard then
        self._guard:Destroy()
        self._guard = nil
    end
    local c = Workspace.CurrentCamera
    if c then
        self._guard = GuardedInstance.new(c)
        self:_Apply()
    end
end

function FovChanger:_Apply()
    if not self._guard then return end
    if self._enabled then
        self._guard:SetOverride("FieldOfView", self._value)
    else
        self._guard:ClearOverride("FieldOfView")
    end
end

function FovChanger:SetEnabled(state)
    self._enabled = state
    self:_Apply()
end

function FovChanger:SetValue(fov)
    self._value = fov
    self:_Apply()
end

function FovChanger:Destroy()
    if self._guard then self._guard:Destroy() end
    self._trove:Destroy()
end

-- ═══════════════════════════════════════════════════════════════════════
-- ESP MANAGER (orchestrates all per-player visual systems)
-- ═══════════════════════════════════════════════════════════════════════
local ESPManager = {}
ESPManager.__index = ESPManager

function ESPManager.new()
    local self = setmetatable({
        _trove      = Trove.new("ESPManager"),
        _entries    = {},  -- [player] = { box, chams, skeleton, tracer, nameLabel, healthBar }
        _screenGui  = nil,
        _config     = {
            box         = { enabled=false, style="Full",  color=Color3.fromRGB(255,50,50),  outlineColor=Color3.fromRGB(0,0,0) },
            chams       = { enabled=false, innerColor=Color3.fromRGB(255,50,50),  outlineColor=Color3.fromRGB(80,0,0),
                            innerAlpha=0, outlineAlpha=0.5, glowEnabled=false, glowColor=Color3.fromRGB(255,50,50) },
            skeleton    = { enabled=false, color=Color3.fromRGB(255,100,100), transparency=0, thickness=1 },
            tracer      = { enabled=false, color=Color3.fromRGB(255,50,50),  transparency=0, thickness=1.5 },
            name        = { enabled=false, color=Color3.fromRGB(255,255,255) },
            health      = { enabled=false },
            teamCheck   = true,
        },
    }, self)

    -- Build ScreenGui
    local sg = Instance.new("ScreenGui")
    sg.Name             = "RivalsESP"
    sg.ResetOnSpawn     = false
    sg.IgnoreGuiInset   = true
    sg.ZIndexBehavior   = Enum.ZIndexBehavior.Sibling
    sg.Parent           = lp.PlayerGui
    self._screenGui     = sg
    self._trove:Add(sg)

    -- Bind existing players
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then self:_AddPlayer(p) end
    end

    self._trove:Connect(Players.PlayerAdded, function(p)
        if p ~= lp then self:_AddPlayer(p) end
    end)
    self._trove:Connect(Players.PlayerRemoving, function(p)
        self:_RemovePlayer(p)
    end)

    return self
end

function ESPManager:_SameTm(player)
    local ok = false
    pcall(function()
        local a = lp:GetAttribute("TeamID")
        local b = player:GetAttribute("TeamID")
        if a ~= nil and b ~= nil then ok = (a == b) end
    end)
    return ok
end

function ESPManager:_AddPlayer(player)
    if self._entries[player] then return end

    local box      = BoundingBox.new(self._screenGui)
    local chams    = Chams.new()
    local skeleton = Skeleton.new(self._screenGui)
    local tracer   = Tracer.new(self._screenGui)

    -- Name label
    local nameGui = Instance.new("BillboardGui")
    nameGui.Size        = UDim2.fromOffset(200, 20)
    nameGui.StudsOffset = Vector3.new(0, 3.5, 0)
    nameGui.AlwaysOnTop = true
    local nameLbl = Instance.new("TextLabel", nameGui)
    nameLbl.Size                   = UDim2.fromScale(1,1)
    nameLbl.BackgroundTransparency = 1
    nameLbl.Text                   = player.DisplayName
    nameLbl.Font                   = Enum.Font.GothamBold
    nameLbl.TextSize               = 13
    nameLbl.TextColor3             = self._config.name.color
    nameLbl.TextStrokeTransparency = 0
    nameLbl.Visible                = false
    nameGui.Parent = self._screenGui

    -- Health bar (BillboardGui)
    local hpGui = Instance.new("BillboardGui")
    hpGui.Size        = UDim2.fromOffset(4, 80)
    hpGui.StudsOffset = Vector3.new(-3, 0, 0)
    hpGui.AlwaysOnTop = true
    local hpBg = Instance.new("Frame", hpGui)
    hpBg.Size                   = UDim2.fromScale(1,1)
    hpBg.BackgroundColor3       = Color3.fromRGB(0,0,0)
    hpBg.BackgroundTransparency = 0.3
    hpBg.BorderSizePixel        = 0
    local hpBar = Instance.new("Frame", hpBg)
    hpBar.AnchorPoint       = Vector2.new(0, 1)
    hpBar.Position          = UDim2.fromScale(0, 1)
    hpBar.Size              = UDim2.fromScale(1, 1)
    hpBar.BackgroundColor3  = Color3.fromRGB(50, 200, 50)
    hpBar.BorderSizePixel   = 0
    hpGui.Visible = false
    hpGui.Parent  = self._screenGui

    self._entries[player] = {
        box      = box,
        chams    = chams,
        skeleton = skeleton,
        tracer   = tracer,
        nameGui  = nameGui,
        nameLbl  = nameLbl,
        hpGui    = hpGui,
        hpBar    = hpBar,
    }

    -- Bind character
    if player.Character then
        self:_BindCharacter(player, player.Character)
    end

    self._trove:Connect(player.CharacterAdded, function(chr)
        self:_BindCharacter(player, chr)
    end)
    self._trove:Connect(player.CharacterRemoving, function()
        local e = self._entries[player]
        if not e then return end
        e.chams:DeselectModel()
        e.skeleton:DeselectModel()
        e.tracer:ClearTarget()
        e.nameGui.Adornee = nil
        e.hpGui.Adornee   = nil
    end)
end

function ESPManager:_BindCharacter(player, character)
    local e = self._entries[player]
    if not e then return end

    task.wait(0.1) -- wait for character to fully load

    local hrp  = character:WaitForChild("HumanoidRootPart", 5)
    local head = character:WaitForChild("Head", 5)
    local hum  = character:WaitForChild("Humanoid", 5)
    if not hrp then return end

    -- Chams
    if self._config.chams.enabled then
        e.chams:SelectModel(character)
        local c = self._config.chams
        e.chams:SetLook(c.innerColor, c.innerAlpha, c.outlineColor, c.outlineAlpha, c.glowEnabled, c.glowColor)
        e.chams:SetEnabled(true)
    end

    -- Skeleton
    if self._config.skeleton.enabled then
        e.skeleton:SelectModel(character)
        local s = self._config.skeleton
        e.skeleton:SetLook(s.color, s.transparency, s.thickness)
        e.skeleton:SetEnabled(true)
    end

    -- Tracer target
    if self._config.tracer.enabled then
        e.tracer:SetTarget(head or hrp)
        local t = self._config.tracer
        e.tracer:SetLook(t.color, t.transparency, t.thickness)
        e.tracer:SetEnabled(true)
    end

    -- Name / health adorees
    e.nameGui.Adornee = hrp
    e.hpGui.Adornee   = hrp

    -- Health update
    if hum then
        local function updateHP()
            local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            e.hpBar.Size           = UDim2.fromScale(1, pct)
            e.hpBar.BackgroundColor3 = Color3.fromRGB(
                math.floor(255 * (1 - pct)),
                math.floor(255 * pct),
                0
            )
        end
        updateHP()
        self._trove:Connect(hum.HealthChanged, updateHP)
    end
end

function ESPManager:_RemovePlayer(player)
    local e = self._entries[player]
    if not e then return end
    e.box:Destroy()
    e.chams:Destroy()
    e.skeleton:Destroy()
    e.tracer:Destroy()
    e.nameGui:Destroy()
    e.hpGui:Destroy()
    self._entries[player] = nil
end

function ESPManager:Update()
    for player, e in pairs(self._entries) do
        if player == lp then continue end

        -- Team check
        local shouldSkip = self._config.teamCheck and self:_SameTm(player)
        local chr = player.Character
        local hum = chr and chr:FindFirstChildOfClass("Humanoid")
        local alive = hum and hum.Health > 0

        if shouldSkip or not chr or not alive then
            e.box:SetEnabled(false)
            e.nameGui.Enabled = false
            e.hpGui.Enabled   = false
            e.skeleton:SetEnabled(false)
            e.tracer:SetEnabled(false)
            continue
        end

        -- Box
        if self._config.box.enabled then
            e.box:SetEnabled(true)
            e.box:Update(chr)
        else
            e.box:SetEnabled(false)
        end

        -- Name
        e.nameGui.Enabled    = self._config.name.enabled
        e.nameLbl.Visible    = self._config.name.enabled
        e.nameLbl.TextColor3 = self._config.name.color

        -- Health
        e.hpGui.Enabled = self._config.health.enabled

        -- Skeleton
        if self._config.skeleton.enabled then
            e.skeleton:Update()
        end

        -- Tracer
        if self._config.tracer.enabled then
            e.tracer:Update()
        end
    end
end

function ESPManager:ApplyBoxConfig()
    local c = self._config.box
    for _, e in pairs(self._entries) do
        e.box:SetStyle(c.style)
        e.box:SetLook(c.color, LookEnum.None)
        e.box:SetOutlineColor(c.outlineColor)
    end
end

function ESPManager:ApplyChamsConfig()
    local c = self._config.chams
    for player, e in pairs(self._entries) do
        local chr = player.Character
        if chr and c.enabled then
            if not e.chams._enabled then
                e.chams:SelectModel(chr)
            end
            e.chams:SetLook(c.innerColor, c.innerAlpha, c.outlineColor, c.outlineAlpha, c.glowEnabled, c.glowColor)
            e.chams:SetEnabled(true)
        else
            e.chams:SetEnabled(false)
        end
    end
end

function ESPManager:ApplySkeletonConfig()
    local s = self._config.skeleton
    for player, e in pairs(self._entries) do
        local chr = player.Character
        if chr and s.enabled then
            if not e.skeleton._model then
                e.skeleton:SelectModel(chr)
            end
            e.skeleton:SetLook(s.color, s.transparency, s.thickness)
            e.skeleton:SetEnabled(true)
        else
            e.skeleton:SetEnabled(false)
        end
    end
end

function ESPManager:ApplyTracerConfig()
    local t = self._config.tracer
    for player, e in pairs(self._entries) do
        local chr  = player.Character
        local head = chr and chr:FindFirstChild("Head")
        local hrp  = chr and chr:FindFirstChild("HumanoidRootPart")
        if (head or hrp) and t.enabled then
            e.tracer:SetTarget(head or hrp)
            e.tracer:SetLook(t.color, t.transparency, t.thickness)
            e.tracer:SetEnabled(true)
        else
            e.tracer:SetEnabled(false)
        end
    end
end

function ESPManager:Destroy()
    for player in pairs(self._entries) do
        self:_RemovePlayer(player)
    end
    self._trove:Destroy()
end

