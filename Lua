local tpRunning = false

local function doTeleport(targetChar, oid, targetPart)
    if tpRunning then return end
    if not ch or not ch:FindFirstChild("HumanoidRootPart") then return end
    local myHRP   = ch.HumanoidRootPart
    local savedCF = myHRP.CFrame

    local destPos
    local targetHead = targetChar:FindFirstChild("Head")
    local targetHRP2 = targetChar:FindFirstChild("HumanoidRootPart")

    if TP.target == "Head" and targetHead then
        destPos = targetHead.Position + Vector3.new(0, 3, 0)
    elseif TP.target == "Legs" and targetHRP2 then
        destPos = targetHRP2.Position - Vector3.new(0, 2.5, 0)
    else
        destPos = (targetHRP2 and targetHRP2.Position or savedCF.Position) + Vector3.new(0, 3, 0)
    end

    tpRunning = true

    pcall(function() myHRP.CFrame = CFrame.new(destPos) end)
    task.wait(0.05)

    if TP.autoShoot and RG and RG.on and oid and targetPart and targetPart.Parent then
        rgFire(oid, targetPart)
        task.wait(0.08)
    end

    pcall(function() myHRP.CFrame = savedCF end)
    tpRunning = false
end

