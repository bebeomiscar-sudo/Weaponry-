local function saveConfig()
    if not writefile then return end
    pcall(function()
        local cfg={equipped={},favorites=favorites}
        for weapon,cosmetics in pairs(equipped) do
            cfg.equipped[weapon]={}
            for ct,cd in pairs(cosmetics) do
                if cd and cd.Name then
                    cfg.equipped[weapon][ct]={name=cd.Name,seed=cd.Seed,inverted=cd.Inverted}
                end
            end
        end
        makefolder("unlockall"); writefile(saveFile,hts:JSONEncode(cfg))
    end)
end
local function loadConfig()
    if not readfile or not isfile or not isfile(saveFile) then return end
    pcall(function()
        local cfg=hts:JSONDecode(readfile(saveFile))
        if cfg.equipped then
            for weapon,cosmetics in pairs(cfg.equipped) do
                equipped[weapon]={}
                for ct,cd in pairs(cosmetics) do
                    local cl=cloneCosmetic(cd.name,ct,{inverted=cd.inverted})
                    if cl then cl.Seed=cd.seed; equipped[weapon][ct]=cl end
                end
            end
        end
        favorites=cfg.favorites or {}
    end)
end
local function isAllowed(name,cosmetic)
    if not cosmetic then return false end
    local t=cosmetic.Type or ""
    if t=="Finisher" or name:lower():find("finisher") then return false end
    return t=="Skin" or t=="Charm" or t=="Dance" or t=="Emote" or t=="Wrap" or t=="Wrapping"
        or name:lower():find("charm") or name:lower():find("dance")
        or name:lower():find("emote") or name:lower():find("wrap")
end
local function enableSkins()
    if not mCosmetic or not mData then
        Lib:Notify("Enter a match first, then enable Skin Changer",4); return
    end
    mCosmetic.OwnsCosmetic=function(self,inventory,name,weapon)
        if name:find("MISSING_") then return false end
        local cosmetic=mCosmetic.Cosmetics[name]
        if cosmetic and isAllowed(name,cosmetic) then return true end; return false
    end
    mCosmetic.OwnsCosmeticNormally    = mCosmetic.OwnsCosmetic
    mCosmetic.OwnsCosmeticUniversally = mCosmetic.OwnsCosmetic
    mCosmetic.OwnsCosmeticForWeapon   = mCosmetic.OwnsCosmetic
    local origGet=mData.Get
    mData.Get=function(self,key)
        local data=origGet(self,key)
        if key=="CosmeticInventory" then
            local proxy={}
            if data then for k,v in pairs(data) do
                local c=mCosmetic.Cosmetics[k]; if c and isAllowed(k,c) then proxy[k]=v end
            end end
            return setmetatable(proxy,{__index=function(t,k)
                local c=mCosmetic.Cosmetics[k]; if c and isAllowed(k,c) then return true end; return nil
            end})
        end
        if key=="FavoritedCosmetics" then
            local result=data and table.clone(data) or {}
            for weapon,favs in pairs(favorites) do
                result[weapon]=result[weapon] or {}
                for name,isFav in pairs(favs) do
                    local c=mCosmetic.Cosmetics[name]
                    if c and isAllowed(name,c) then result[weapon][name]=isFav end
                end
            end; return result
        end; return data
    end
    local origGWD=mData.GetWeaponData
    mData.GetWeaponData=function(self,weaponName)
        local data=origGWD(self,weaponName); if not data then return nil end
        local merged={}; for k,v in pairs(data) do merged[k]=v end; merged.Name=weaponName
        if equipped[weaponName] then for ct,cd in pairs(equipped[weaponName]) do merged[ct]=cd end end
        return merged
    end
    if not skinHooked and hookmetamethod then
        local remotes=rep:FindFirstChild("Remotes")
        local dataR=remotes and remotes:FindFirstChild("Data")
        local equipR=dataR and dataR:FindFirstChild("EquipCosmetic")
        local favR=dataR and dataR:FindFirstChild("FavoriteCosmetic")
        local repR=remotes and remotes:FindFirstChild("Replication")
        local figR=repR and repR:FindFirstChild("Fighter")
        local useItemR=figR and figR:FindFirstChild("UseItem")
        if equipR then
            local oldNC
            oldNC=hookmetamethod(game,"__namecall",newcclosure(function(self,...)
                local m=getnamecallmethod(); if m~="FireServer" then return oldNC(self,...) end
                local a={...}
                if useItemR and self==useItemR then
                    pcall(function()
                        if mFig then
                            local fighter=mFig:GetFighter(lp)
                            if fighter and fighter.Items then
                                for _,item in pairs(fighter.Items) do
                                    if item:Get("ObjectID")==a[1] then lastUsedWeapon=item.Name; break end
                                end
                            end
                        end
                    end)
                end
                if self==equipR then
                    local wn=a[1]; local ct=a[2]; local cn=a[3]; local opts=a[4] or {}
                    if ct=="Finisher" then return oldNC(self,...) end
                    if cn and cn~="None" and cn~="" then
                        local inv=mData:Get("CosmeticInventory")
                        if inv and rawget(inv,cn) then return oldNC(self,...) end
                    end
                    if ct=="Dance" or ct=="Emote" then
                        equipped.Dances=equipped.Dances or {}
                        if not cn or cn=="None" or cn=="" then equipped.Dances[ct]=nil
                        else
                            local cl=cloneCosmetic(cn,ct,{inverted=opts.IsInverted,favoritesOnly=opts.OnlyUseFavorites})
                            if cl then equipped.Dances[ct]=cl end
                        end
                        task.defer(function()
                            pcall(function() mData.CurrentData:Replicate("CosmeticInventory") end)
                            task.wait(0.2); saveConfig()
                        end); return
                    end
                    equipped[wn]=equipped[wn] or {}
                    if not cn or cn=="None" or cn=="" then
                        equipped[wn][ct]=nil; if not next(equipped[wn]) then equipped[wn]=nil end
                    else
                        local cl=cloneCosmetic(cn,ct,{inverted=opts.IsInverted,favoritesOnly=opts.OnlyUseFavorites})
                        if cl then equipped[wn][ct]=cl end
                    end
                    task.defer(function()
                        pcall(function() mData.CurrentData:Replicate("WeaponInventory") end)
                        task.wait(0.2); saveConfig()
                    end); return
                end
                if self==favR then
                    local c=mCosmetic.Cosmetics[a[2]]
                    if c and isAllowed(a[2],c) then
                        favorites[a[1]]=favorites[a[1]] or {}; favorites[a[1]][a[2]]=a[3] or nil
                        saveConfig()
                        task.spawn(function()
                            pcall(function() mData.CurrentData:Replicate("FavoritedCosmetics") end)
                        end); return
                    end
                end; return oldNC(self,...)
            end)); skinHooked=true
        end
    end
    local CI=nil
    pcall(function() CI=require(psc.Modules.ClientReplicatedClasses.ClientFighter.ClientItem) end)
    if CI and CI._CreateViewModel then
        local origCVM=CI._CreateViewModel
        CI._CreateViewModel=function(self,vmRef)
            local wn=self.Name; local wp=self.ClientFighter and self.ClientFighter.Player
            constructingW=(wp==lp) and wn or nil
            if wp==lp and equipped[wn] and vmRef then
                for _,ct in ipairs({"Skin","Charm","Wrap"}) do
                    if equipped[wn][ct] then
                        local ok1,dk=pcall(function() return self:ToEnum("Data") end)
                        local ok2,ck=pcall(function() return self:ToEnum(ct) end)
                        local ok3,nk=pcall(function() return self:ToEnum("Name") end)
                        if ok1 and ok2 and ok3 and vmRef[dk] then
                            vmRef[dk][ck]=equipped[wn][ct]; vmRef[dk][nk]=equipped[wn][ct].Name
                        elseif vmRef.Data then
                            vmRef.Data[ct]=equipped[wn][ct]; vmRef.Data.Name=equipped[wn][ct].Name
                        end
                    end
                end
            end
            local r=origCVM(self,vmRef); constructingW=nil; return r
        end
    end
    local vmMod=psc.Modules.ClientReplicatedClasses.ClientFighter.ClientItem:FindFirstChild("ClientViewModel")
    if vmMod then
        local CVM=require(vmMod); local origNew=CVM.new
        CVM.new=function(repData,ci)
            local wp=ci.ClientFighter and ci.ClientFighter.Player; local wn=constructingW or ci.Name
            if wp==lp and equipped[wn] then
                local ok,RC=pcall(function() return require(rep.Modules.ReplicatedClass) end)
                if ok and RC then
                    local dk=RC:ToEnum("Data"); repData[dk]=repData[dk] or {}
                    for _,ct in ipairs({"Skin","Charm","Wrap"}) do
                        if equipped[wn][ct] then
                            local ok2,ce=pcall(function() return RC:ToEnum(ct) end)
                            if ok2 then repData[dk][ce]=equipped[wn][ct] end
                        end
                    end
                end
            end
            local r=origNew(repData,ci)
            if wp==lp and equipped[wn] and equipped[wn].Wrap and r and r._UpdateWrap then
                r:_UpdateWrap(); task.delay(0.1,function() if not r._destroyed then r:_UpdateWrap() end end)
            end; return r
        end
        if CVM.GetCharm then local oc=CVM.GetCharm
            CVM.GetCharm=function(self)
                local wn=self.ClientItem and self.ClientItem.Name
                local wp=self.ClientItem and self.ClientItem.ClientFighter and self.ClientItem.ClientFighter.Player
                if wn and wp==lp and equipped[wn] and equipped[wn].Charm then return equipped[wn].Charm end
                return oc(self)
            end
        end
        if CVM.GetWrap then local ow=CVM.GetWrap
            CVM.GetWrap=function(self)
                local wn=self.ClientItem and self.ClientItem.Name
                local wp=self.ClientItem and self.ClientItem.ClientFighter and self.ClientItem.ClientFighter.Player
                if wn and wp==lp and equipped[wn] and equipped[wn].Wrap then return equipped[wn].Wrap end
                return ow(self)
            end
        end
    end
    if mItemLib and mItemLib.GetViewModelImageFromWeaponData then
        local origImg=mItemLib.GetViewModelImageFromWeaponData
        mItemLib.GetViewModelImageFromWeaponData=function(self,weaponData,highRes)
            if not weaponData then return origImg(self,weaponData,highRes) end
            local wn=weaponData.Name
            if equipped[wn] and equipped[wn].Skin then
                local si=self.ViewModels and self.ViewModels[equipped[wn].Skin.Name]
                if si then return si[highRes and "ImageHighResolution" or "Image"] or si.Image end
            end; return origImg(self,weaponData,highRes)
        end
    end
    pcall(function()
        if not ctl then return end
        local EC=require(ctl:WaitForChild("EmoteController",5))
        if EC and EC.GetEmotes then
            local origGE=EC.GetEmotes
            EC.GetEmotes=function(self)
                local emotes=origGE(self)
                for name,cosmetic in pairs(mCosmetic.Cosmetics) do
                    if isAllowed(name,cosmetic) and (cosmetic.Type=="Dance" or cosmetic.Type=="Emote") then
                        if not emotes[name] then
                            emotes[name]={Name=name,Type=cosmetic.Type,ObjectID=cosmetic.ObjectID,Enum=cosmetic.Enum}
                        end
                    end
                end; return emotes
            end
        end
    end)
    pcall(function()
        local VP=require(psc.Modules.Pages.ViewProfile)
        if VP and VP.Fetch then
            local origF=VP.Fetch
            VP.Fetch=function(self,tp) viewingProfile=tp; return origF(self,tp) end
        end
    end)
    loadConfig(); skinEnabled=true; Lib:Notify("Skin Changer ON",4)
end

