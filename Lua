    self._bakedEnd  = Vector3.zAxis
    self._selected  = nil
    self._timer     = 0

    -- keybind: F key starts a flick
    self._trove:Connect(UserInputService.InputBegan, function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.F and Config.Flickbot.Enabled then
            if self._state == "Idle" then self:_StartFlick() end
        end
    end)

    self._trove:Connect(RunService.PreRender, function(dt)
        self:_Update(dt)
    end)

    return self
end

local function partToScreen(part)
    local cam = workspace.CurrentCamera
    local s, visible = cam:WorldToViewportPoint(part.Position)
    if not visible or s.Z <= 0 then return nil end
    return Vector2.new(s.X, s.Y)
end

function FlickbotController:_StartFlick()
    local best = self._aimbot:_GetBestTarget()
    if not best then return end

    local screenTarget = partToScreen(best.part)
    if not screenTarget then return end

    local cam  = workspace.CurrentCamera
    local vp   = cam.ViewportSize
    local cx, cy = vp.X / 2, vp.Y / 2

    -- bake straight trajectory; curvature and humanness bend it
    local durationMs = Config.Flickbot.FlickDuration
    local steps = math.max(2, math.floor(durationMs / 16))
    local traj  = {}

    for i = 1, steps do
        local t     = (i - 1) / (steps - 1)
        -- apply cubic ease-in-out
        local eased = t < 0.5 and 4 * t * t * t or 1 - (-2 * t + 2)^3 / 2
        -- slight curve: arc perpendicular to direction, scaled by curvature
        local curveBend = math.sin(t * math.pi) * Config.Flickbot.Curvature * 40
        local sx = cx + (screenTarget.X - cx) * eased
        local sy = cy + (screenTarget.Y - cy) * eased + curveBend
        -- humanness: small random jitter
        local jitter = Config.Flickbot.Humanness * 4
        sx = sx + (math.random() - 0.5) * jitter
        sy = sy + (math.random() - 0.5) * jitter

        traj[i] = {
            direction = cam:ViewportPointToRay(sx, sy).Direction,
            t         = (i - 1) / (steps - 1) * durationMs,
        }
    end

    self._trajectory        = traj
    self._trajectoryIndex   = 1
    self._elapsedMs         = 0
    self._totalMs           = durationMs
    self._bakedEnd          = traj[#traj].direction
    self._selected          = best
    self._state             = "Flicking"
end

function FlickbotController:_FinishToCooldown()
    self._selected   = nil
    self._trajectory = nil
    local cooldownMs = Config.Flickbot.Cooldown
    if cooldownMs > 0 then
        self._state = "Cooldown"
        self._timer = cooldownMs / 1000
    else
        self._state = "Idle"
    end
end

function FlickbotController:_SampleTrajectory(dt)
    local traj = self._trajectory
    self._elapsedMs = self._elapsedMs + dt * 1000
    local idx = self._trajectoryIndex
    while idx < #traj and traj[idx + 1].t <= self._elapsedMs do
        idx = idx + 1
    end
    self._trajectoryIndex = idx
    local curr = traj[idx]
    local next = traj[idx + 1]
    if not next then return traj[#traj].direction, true end
    local span  = next.t - curr.t
    local alpha = span > 0 and math.clamp((self._elapsedMs - curr.t) / span, 0, 1) or 1
    return curr.direction:Lerp(next.direction, alpha), false
end

function FlickbotController:_FireShot()
    local char = LocalPlayer.Character
    if not char then return end
    -- simulate mouse click via VirtualInputManager if available
    local tool = char:FindFirstChildOfClass("Tool")
    if tool and tool:FindFirstChild("Shoot") then
        tool.Shoot:FireServer()
    end
end

function FlickbotController:_Update(dt)
    if not Config.Flickbot.Enabled then
        self._state = "Idle"
        return
    end

    local state = self._state
    if state == "Flicking" then
        local selected = self._selected
        if not selected or not self._trajectory then self:_FinishToCooldown(); return end
        if selected.part.Parent == nil then self:_FinishToCooldown(); return end

        local dir, finished = self:_SampleTrajectory(dt)

        -- live target correction
        if self._totalMs > 0 then
            local camPos   = workspace.CurrentCamera.CFrame.Position
            local liveUnit = (selected.part.Position - camPos).Unit
            local progress = math.clamp(self._elapsedMs / self._totalMs, 0, 1)
            dir = (dir + (liveUnit - self._bakedEnd) * progress).Unit
        end

        local pitch = math.asin(-dir.Y)
        local yaw   = math.atan2(-dir.X, -dir.Z)
        local cam   = workspace.CurrentCamera
        cam.CFrame  = CFrame.new(cam.CFrame.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)

        if finished then
            if Config.Flickbot.Shoot then
                self._state = "PostShot"
                self._timer = Config.Flickbot.ShotDelay / 1000
            else
                self:_FinishToCooldown()
            end
        end

    elseif state == "PostShot" then
        self._timer = self._timer - dt
        if self._timer <= 0 then
            self:_FireShot()
            self:_FinishToCooldown()
        end

    elseif state == "Cooldown" then
        self._timer = self._timer - dt
        if self._timer <= 0 then self._state = "Idle" end
    end
end

function FlickbotController:Destroy()
    self._trove:Destroy()
end

