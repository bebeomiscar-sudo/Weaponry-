-- FLIGHT
-- ============================================================

local FlightController = {}
FlightController.__index = FlightController

function FlightController.new()
    local self  = setmetatable({}, FlightController)
    self._trove = Trove.new("flight")
    self._mover = nil

    self._trove:Connect(RunService.Heartbeat, function(dt)
        self:_Update(dt)
    end)

    return self
end

function FlightController:_GetDirection()
    if UserInputService:GetFocusedTextBox() then return Vector3.zero end
    local cam    = workspace.CurrentCamera
    local look   = cam.CFrame.LookVector
    local lookH  = Vector3.new(look.X, 0, look.Z)
    if lookH.Magnitude > 0 then lookH = lookH.Unit end
    local right  = cam.CFrame.RightVector
    local result = Vector3.zero

    if UserInputService:IsKeyDown(Enum.KeyCode.W) then result += lookH end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then result -= lookH end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then result += right end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then result -= right end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space)       then result += Vector3.yAxis end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)   then result -= Vector3.yAxis end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then result -= Vector3.yAxis end

    return result.Magnitude > 0 and result.Unit or Vector3.zero
end

function FlightController:_Update(dt)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not Config.Movement.Flight or not root then
        if self._mover then
            self._mover.velocity:Destroy()
            self._mover.attachment:Destroy()
            self._mover = nil
        end
        return
    end

    local dir = self:_GetDirection()
    local vel = dir * Config.Movement.FlightSpeed

    if not self._mover then
        local att = Instance.new("Attachment")
        att.Parent = root
        local lv = Instance.new("LinearVelocity")
        lv.RelativeTo     = Enum.ActuatorRelativeTo.World
        lv.MaxForce       = math.huge
        lv.VectorVelocity = vel
        lv.Attachment0    = att
        lv.Parent         = root
        self._mover = { attachment = att, velocity = lv }
    else
        self._mover.velocity.VectorVelocity = vel
    end

    -- kill gravity while flying
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if humanoid then humanoid.PlatformStand = true end
end

function FlightController:Destroy()
    if self._mover then
        self._mover.velocity:Destroy()
        self._mover.attachment:Destroy()
    end
    self._trove:Destroy()
end

