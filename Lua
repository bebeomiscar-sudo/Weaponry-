-- =============================================
--   PRIORITY CONFIG
-- =============================================

local PriorityCfg = {
    enabled         = false,
    voidWeight      = 500,
    voidDistance    = 2000,
    historyWindow   = 1.0,
    timeDecay       = 0.5,
    outlierZThresh  = 2.0,
    confidenceScale = 10,
}

local playerHistory = {}

local function getOrCreateHistory(p)
    if not playerHistory[p] then
        playerHistory[p] = {
            score      = 0,
            lastSeen   = tick(),
            voidEvents = {},
            inVoid     = false,
            confidence = 0,
            isOutlier  = false,
        }
    end
    return playerHistory[p]
end

local function isInVoid(player)
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local pos = hrp.Position
    return math.sqrt(pos.X^2 + pos.Y^2 + pos.Z^2) > PriorityCfg.voidDistance
end

local function updatePriorityScores()
    local now = tick()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        local hist = getOrCreateHistory(p)
        local dt   = now - hist.lastSeen
        hist.lastSeen = now
        hist.score = math.max(hist.score * (1 - PriorityCfg.timeDecay * dt), 0)
        if isInVoid(p) then
            if not hist.inVoid then
                hist.inVoid = true
                hist.score  = hist.score + PriorityCfg.voidWeight
                table.insert(hist.voidEvents, now)
            else
                hist.score = hist.score + PriorityCfg.voidWeight * 0.01
            end
        else
            hist.inVoid = false
        end
        local newEvents = {}
        for _, t in ipairs(hist.voidEvents) do
            if now - t <= PriorityCfg.historyWindow then table.insert(newEvents, t) end
        end
        hist.voidEvents = newEvents
        hist.confidence = math.clamp(#hist.voidEvents * PriorityCfg.confidenceScale, 0, 100)
        local scores = {}
        for _, ph in pairs(playerHistory) do table.insert(scores, ph.score) end
        local mean, variance = 0, 0
        for _, s in ipairs(scores) do mean += s end
        mean = mean / math.max(#scores, 1)
        for _, s in ipairs(scores) do variance += (s - mean)^2 end
        variance = variance / math.max(#scores, 1)
        local std = math.sqrt(variance)
        hist.isOutlier = std > 0 and ((hist.score - mean) / std) >= PriorityCfg.outlierZThresh
    end
end

local function getVoidPriorityTarget()
    local best, bestScore = nil, -1
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        local hist = playerHistory[p]
        if hist and hist.score > bestScore then
            bestScore = hist.score; best = p
        end
    end
    return best
end

