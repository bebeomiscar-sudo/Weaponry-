-- MODULE: AttackEncoder — Gun + Melee
-- ═══════════════════════════════════════════════════════════════════════
local AttackEncoder = {}
AttackEncoder.__index = AttackEncoder

function AttackEncoder.new(mUtil, mEnum, rUseItem)
    return setmetatable({
        _mUtil    = mUtil,
        _mEnum    = mEnum,
        _rUseItem = rUseItem,
        _shootLock            = ShootLock.new(),
        _hitboxWindowUntil    = 0,
        _attackCooldown       = 0,
        _BACKSTAB_WINDOW      = 0.625,
        _ATTACK_COOLDOWN      = 1.25,
    }, AttackEncoder)
end

function AttackEncoder:Reset()
    self._shootLock:Reset()
    self._hitboxWindowUntil = 0
    self._attackCooldown    = 0
end

function AttackEncoder:_RecordBackstab()
    local now = os.clock()
    self._hitboxWindowUntil = now + self._BACKSTAB_WINDOW
    self._attackCooldown    = now + self._ATTACK_COOLDOWN
end

--[[
    Builds shot data table for FireServer
    Matches Rivals internal format
]]
function AttackEncoder:_BuildShotData(aimCF, hitPart)
    local sd = {}
    pcall(function()
        sd[utf8.char(1)] = {
            [utf8.char(0)] = self._mUtil:EncodeCFrame(aimCF),
            [utf8.char(1)] = self._mUtil:EncodeCFrame(hitPart.CFrame),
            [utf8.char(2)] = hitPart,
            [utf8.char(3)] = self._mUtil:EncodeCFrame(
                hitPart.CFrame:ToObjectSpace(CFrame.new(hitPart.Position))
            ),
        }
    end)
    return sd
end

--[[
    GUN: Plan returns (cframe, weaponAction)
    FIX: ShootLock now receives proper lockDuration (3rd param)
    FIX: nil weapon guard added
    FIX: type fallback returns safe CFrame instead of nil
]]
function AttackEncoder:PlanGun(dt, targetState, item, oid, myHRP)
    -- Guard: nil weapon
    if not item or not oid then
        return CFrame.new(math.huge, math.huge, math.huge), nil
    end

    local hitboxHead = targetState and targetState.hitboxHead
    if not hitboxHead or not hitboxHead.Parent then
        return myHRP.CFrame, nil
    end

    local now = os.clock()

    -- ShootLock gate (FIXED: passing lockDuration as 3rd arg)
    local lockDuration = dt * RagebotConfig.ShootFrames
    if not self._shootLock:ShouldFire(true, lockDuration) then
        -- Return random far miss instead of dangerous random pos
        return CFrame.new(0, -999999, 0), nil
    end

    -- Attack cooldown check
    if now < self._attackCooldown then
        return myHRP.CFrame, nil
    end

    local origin  = myHRP.Position + Vector3.new(0, 1.5, 0)
    local aimCF   = CFrame.lookAt(origin, hitboxHead.Position)
    local sd      = self:_BuildShotData(aimCF, hitboxHead)

    local function weaponAction()
        pcall(function()
            self._rUseItem:FireServer(
                oid,
                self._mEnum:ToEnum("StartShooting"),
                sd, nil
            )
        end)
        task.delay(0.07, function()
            pcall(function()
                self._rUseItem:FireServer(
                    oid,
                    self._mEnum:ToEnum("StopShooting"),
                    {}, nil
                )
            end)
        end)
    end

    return aimCF, weaponAction
end

--[[
    MELEE: Plan returns (cframe, viewAngles, weaponAction)
    Knife gets backstab with window + cooldown
]]
function AttackEncoder:PlanMelee(dt, targetState, item, oid, myHRP, isKnife)
    if not item or not oid then
        return myHRP.CFrame, nil, nil
    end

    local hitboxHead = targetState and targetState.hitboxHead
    if not hitboxHead or not hitboxHead.Parent then
        return myHRP.CFrame, nil, nil
    end

    local now = os.clock()

    -- Backstab heavy-attack window still active
    if now < self._hitboxWindowUntil then
        local origin = myHRP.Position + Vector3.new(0, 1.5, 0)
        local aimCF  = CFrame.lookAt(origin, hitboxHead.Position)
        local sd     = self:_BuildShotData(aimCF, hitboxHead)
        local function heavyAction()
            pcall(function()
                self._rUseItem:FireServer(
                    oid,
                    self._mEnum:ToEnum("HeavyAttack"),
                    sd, nil
                )
            end)
        end
        return aimCF, aimCF, heavyAction
    end

    -- ShootLock gate (FIXED)
    local lockDuration = dt * RagebotConfig.ShootFrames
    if not self._shootLock:ShouldFire(true, lockDuration) then
        return myHRP.CFrame, nil, nil
    end

    if now < self._attackCooldown then
        return myHRP.CFrame, nil, nil
    end

    local origin = myHRP.Position + Vector3.new(0, 1.5, 0)
    local aimCF  = CFrame.lookAt(origin, hitboxHead.Position)
    local sd     = self:_BuildShotData(aimCF, hitboxHead)

    if isKnife then
        -- Record backstab before firing
        self:_RecordBackstab()
        local function knifeAction()
            pcall(function()
                self._rUseItem:FireServer(
                    oid,
                    self._mEnum:ToEnum("HeavyAttack"),
                    sd, nil
                )
            end)
        end
        return aimCF, aimCF, knifeAction
    end

    -- Normal melee
    local function meleeAction()
        pcall(function()
            self._rUseItem:FireServer(
                oid,
                self._mEnum:ToEnum("Attack"),
                sd, nil
            )
        end)
    end

    return aimCF, aimCF, meleeAction
end

-- ═══════════════════════════════════════════════════════════════════════
-- MODULE: RagebotController — Main Controller
-- ═══════════════════════════════════════════════════════════════════════
local RagebotController = {}
RagebotController.__index = RagebotController

function RagebotController.new(mFig, mEnum, mUtil, rUseItem, stateHook)
    local oobKiller = OOBKiller.new()
    local self = setmetatable({
        -- Sub-systems
        _shootLock        = ShootLock.new(),
        _partGlue         = PartGlue.new(),
        _spatialGate      = SpatialLimitGate.new(),
        _targetSelection  = TargetSelection.new(),
        _evasion          = EvasionSystem.new(oobKiller),
        _attackEncoder    = AttackEncoder.new(mUtil, mEnum, rUseItem),
        _weaponAction     = WeaponAction.new(mFig, mEnum, rUseItem),
        _oobKiller        = oobKiller,

        -- References
        _mFig             = mFig,
        _mEnum            = mEnum,
        _mUtil            = mUtil,
        _rUseItem         = rUseItem,
        _stateHook        = stateHook,

        -- State
        _enabled          = false,
        _running          = false,
        _connections      = {},
        _originalFPDH     = Workspace.FallenPartsDestroyHeight,
    }, RagebotController)

    return self
end

--[[
    SetEnabled: NaN trick — PRESERVED from original
    Prevents OOB parts from killing target while ragebot active
]]
function RagebotController:SetEnabled(state)
    if self._enabled == state then return end
    self._enabled = state

    if state then
        -- NaN disables fallen parts destroy height check
        pcall(function()
            Workspace.FallenPartsDestroyHeight = 0/0
        end)
    else
        -- Restore original value
        pcall(function()
            Workspace.FallenPartsDestroyHeight = self._originalFPDH
        end)
    end
end

function RagebotController:_Reset()
    self._targetSelection:Clear()
    self._attackEncoder:Reset()
    self._spatialGate:Reset()
    self._partGlue:ReleaseAll()
    self._running = false
    if self._stateHook then
        pcall(function()
            self._stateHook:ClearForced("IsCrouching")
        end)
    end
end

--[[
    _GetTargetState: builds aliveState table for target
    Contains hitboxHead reference for attack encoder
]]
function RagebotController:_GetTargetState(targetChar)
    if not targetChar then return nil end
    local head = targetChar:FindFirstChild("Head")
    local hrp  = targetChar:FindFirstChild("HumanoidRootPart")
    local hm   = targetChar:FindFirstChildOfClass("Humanoid")

    if not hrp then return nil end

    return {
        hitboxHead   = head or hrp,
        hitboxHRP    = hrp,
        humanoid     = hm,
        hp           = hm and hm.Health or 0,
        character    = targetChar,
    }
end

--[[
    _Plan: Routes to correct strategy based on weapon type
    FIX: Added "Other"/nil type fallback
    FIX: Validates item not nil before calling encoder
]]
function RagebotController:_Plan(dt, item, oid, itemType, targetState, myHRP, evadeMode)
    -- No target → evade plan
    if not targetState then
        return self:_EvadePlan(myHRP, evadeMode)
    end

    if itemType == "Gun" then
        -- Check if reloading → evade while reloading
        local isReloading = false
        pcall(function()
            isReloading = item:IsReloading() or item:Get("IsReloading")
        end)

        if isReloading then
            return self:_EvadePlan(myHRP, evadeMode)
        end

        local cframe, weaponAction = self._attackEncoder:PlanGun(
            dt, targetState, item, oid, myHRP
        )
        return { cframe = cframe, weaponAction = weaponAction }

    elseif itemType == "Melee" then
        local isKnife = false
        pcall(function() isKnife = (item.Name == "Knife") end)

        local cframe, viewAngles, weaponAction = self._attackEncoder:PlanMelee(
            dt, targetState, item, oid, myHRP, isKnife
        )
        return {
            cframe       = cframe,
            viewAngles   = viewAngles,
            weaponAction = weaponAction,
        }

    else
        --[[
            FIX: Unknown type (Grenade/Shield/Other)
            Return safe no-op plan instead of nil
            Prevents f14093 indexing nil error
        ]]
        return {
            cframe       = myHRP.CFrame,
            viewAngles   = nil,
            weaponAction = nil,
        }
    end
end

function RagebotController:_EvadePlan(myHRP, mode)
    local targetHRP = nil
    local targetPlayer = self._targetSelection:GetTarget()
    if targetPlayer and targetPlayer.Character then
        targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    end

    local evasionCF = self._evasion:ComputeEvasionCFrame(myHRP, targetHRP)
    return {
        cframe       = evasionCF,
        viewAngles   = nil,
        weaponAction = nil,
    }
end

--[[
    _ApplyPlan: Applies computed plan to character controller
    Sets CFrame and view angles
]]
function RagebotController:_ApplyPlan(plan, myHRP)
    if not plan then return end

    if plan.cframe then
        pcall(function()
            myHRP.CFrame = plan.cframe
        end)
    end

    if plan.viewAngles then
        pcall(function()
            myHRP.CFrame = plan.viewAngles
        end)
    end
end

--[[
    Update: Main tick — called every Heartbeat
    FIX: p4858 (dt) now properly received from Heartbeat
    FIX: race condition guard on target validation
    FIX: _Plan never receives nil without fallback
]]
function RagebotController:Update(dt)
    if not self._enabled then return end
    if self._running then return end

    local myChar = lp.Character
    if not myChar then return end

    local myHRP  = myChar:FindFirstChild("HumanoidRootPart")
    local myHum  = myChar:FindFirstChildOfClass("Humanoid")
    if not myHRP or not myHum or myHum.Health <= 0 then
        self:_Reset(); return
    end

    -- Spatial gate check
    if not self._spatialGate:Check(myChar) then return end

    -- Get weapon
    local item, oid, itemType = self._weaponAction:GetItem()

    -- Handle empty ammo
    if item and oid then
        local ammo = nil
        pcall(function() ammo = item:Get("CurrentAmmo") end)
        if ammo ~= nil and ammo <= 0 then
            local lf = nil
            pcall(function()
                if self._mFig then lf = self._mFig.LocalFighter end
            end)
            if lf then
                local handled = self._weaponAction:HandleOnEmpty(lf, oid)
                if handled then return end
            end
        end
    end

    -- Get target (validated inside GetTarget)
    local targetPlayer = self._targetSelection:GetTarget()
    local targetChar   = targetPlayer and targetPlayer.Character
    local targetState  = self:_GetTargetState(targetChar)

    --[[
        FIX: Re-validate target after GetTargetState
        Target could die between GetTarget() and _GetTargetState()
    ]]
    if targetState and targetState.hp <= 0 then
        self._targetSelection:Clear()
        targetState = nil
    end

    -- Compute plan
    local evadeMode = RagebotConfig.Evasion.Mode
    local plan = self:_Plan(
        dt, item, oid, itemType,
        targetState, myHRP, evadeMode
    )

    -- Apply position
    self:_ApplyPlan(plan, myHRP)

    -- Execute weapon action
    if plan.weaponAction then
        self._running = true
        task.spawn(function()
            local ok = pcall(plan.weaponAction)
            if not ok then
                -- Weapon action failed — not fatal
            end
            self._running = false
        end)
    end
end

--[[
    Start/Stop: Clean enable/disable with connection management
    FIX: Reset called BEFORE SetEnabled (not after)
    to prevent wiping freshly set state
]]
function RagebotController:Start()
    self:_Reset()        -- reset first
    self:SetEnabled(true) -- then enable

    -- Disconnect old connections
    self:Stop(true) -- silent stop (keep enabled)

    -- Heartbeat connection
    local conn = RunService.Heartbeat:Connect(function(dt)
        if not self._enabled then return end
        self:Update(dt)
    end)
    table.insert(self._connections, conn)
end

function RagebotController:Stop(silent)
    for _, conn in ipairs(self._connections) do
        conn:Disconnect()
    end
    table.clear(self._connections)

    if not silent then
        self:_Reset()
        self:SetEnabled(false)
        self._partGlue:ReleaseAll()
    end
end

function RagebotController:Destroy()
    self:Stop()
    self._partGlue:ReleaseAll()
    self._spatialGate:Reset()
    self._targetSelection:Clear()
    self._attackEncoder:Reset()
end

