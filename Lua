local function tpFindNearest()
    local myHRP = ch and ch:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil, nil end
    local best = nil; local bc = nil; local bd = math.huge
    for _, p in ipairs(plr:GetPlayers()) do
        if p == lp then continue end
        local c2 = p.Character; if not c2 then continue end
        local h2 = c2:FindFirstChildOfClass("Humanoid")
        if not h2 or h2.Health <= 0 then continue end
        local hrp2 = c2:FindFirstChild("HumanoidRootPart"); if not hrp2 then continue end
        local d = (myHRP.Position - hrp2.Position).Magnitude
        if d < bd then bd=d; best=p; bc=c2 end
