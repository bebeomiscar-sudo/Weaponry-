local function FetchWithRetry(url, attempts)
    attempts = attempts or 5
    for i = 1, attempts do
        local ok, result = pcall(game.HttpGet, game, url)
        if ok and type(result) == 'string' and #result > 0 then
            return result
        end
        warn(('[Loader] Fetch failed (%d/%d) for %s'):format(i, attempts, url))
        task.wait(0.6 * i)
    end
    return nil
end

local function FetchFirstWorking(urls, attemptsPerUrl)
    for _, url in next, urls do
        local result = FetchWithRetry(url, attemptsPerUrl)
        if result then return result, url end
    end
    error('[Loader] All URLs failed:\n' .. table.concat(urls, '\n'))
end

local function LoadModule(fullUrlOrList, label)
    local urls   = type(fullUrlOrList) == 'table' and fullUrlOrList or { fullUrlOrList }
    local source, usedUrl = FetchFirstWorking(urls, 3)
    local chunk, err = loadstring(source, label)
    if not chunk then
        error('[Loader] Compile error in ' .. label .. ': ' .. tostring(err))
    end
    return chunk()
end

