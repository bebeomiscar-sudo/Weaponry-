local function updateTracers() local now=tick(); local alive={}; for _,t in ipairs(tracers) do local age=now-t.born; local life=math.max(VIS.tracerDur,0.05); if age>=life then pcall(function() t.line:Remove() end) else local a=1-(age/life); local from=Vector2.new(cam.ViewportSize.X/2,cam.ViewportSize.Y); local to=w2s(t.t); if to then t.line.From=from; t.line.To=to; t.line.Transparency=1-a; t.line.Visible=true else t.line.Visible=false end; table.insert(alive,t) end end; tracers=alive end
