-- MODULE: TargetSelection
-- ═══════════════════════════════════════════════════════════════════════
local TargetSelection = {}
TargetSelection.__index = TargetSelection

function TargetSelection.new()
    return setmetatable({ _current = nil }, TargetSelection)
end

local function sameTm(p)
    local ok = false
    pcall(function()
        local a = lp:GetAttribute("TeamID")
        local b = p:GetAttribute("TeamID")
        if a ~= nil and b ~= nil then ok = (a == b) end
    end)
    return ok
end

local function isAlive(char)
    if not char then return false end
    local hm = char:FindFirstChildOfClass("Humanoid")
    return hm and hm.Health > 0
end

local function isSuspicious(p)
    -- Basic heuristic: has exploit-related attributes or abnormal ping
    local ping = p:GetAttribute("Ping")
    if ping and ping < 5 then return true end
    return false
end

function TargetSelection:GetTarget()
    -- Validate current target still alive
    if self._current then
        local chr = self._current.Character
        if not isAlive(chr) then
            self._current = nil
        end
    end
    if self._current then return self._current end

    -- Find new target
    local myHRP = lp.Character
        and lp.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    local priority   = RagebotConfig.Weapons.Priority
    local candidates = {}

    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        if sameTm(p) then continue end
        local chr = p.Character
        if not isAlive(chr) then continue end
        local hrp2 = chr:FindFirstChild("HumanoidRootPart")
        if not hrp2 then continue end
        local hm  = chr:FindFirstChildOfClass("Humanoid")
        local dist = (myHRP.Position - hrp2.Position).Magnitude
        table.insert(candidates, {
            player     = p,
            char       = chr,
            hrp        = hrp2,
            dist       = dist,
            hp         = hm and hm.Health or 0,
            suspicious = isSuspicious(p),
        })
    end

    if #candidates == 0 then return nil end

    --[[
        FIX: PrioritizeHackers pre-sorts suspicious players
        to front before applying main priority sort
    ]]
    if RagebotConfig.PrioritizeHackers then
        table.sort(candidates, function(a, b)
            if a.suspicious ~= b.suspicious then
                return a.suspicious
            end
            return false
        end)
    end

    if     priority == "Closest" then
        table.sort(candidates, function(a,b) return a.dist < b.dist end)
    elseif priority == "LowHP"   then
        table.sort(candidates, function(a,b) return a.hp   < b.hp   end)
    elseif priority == "HighHP"  then
        table.sort(candidates, function(a,b) return a.hp   > b.hp   end)
    elseif priority == "Random"  then
        for i = #candidates, 2, -1 do
            local j = math.random(i)
            candidates[i], candidates[j] = candidates[j], candidates[i]
        end
    end

    self._current = candidates[1].player
    return self._current
end

function TargetSelection:Clear()
    self._current = nil
end

