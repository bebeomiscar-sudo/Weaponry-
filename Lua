            local sig = kiciaSignatures[p]
            if sig and sig.liftCount > 0 then
                local hist = AntiKiciaCfg.kiciaHistory[p]
                table.insert(lines,
                    p.Name.." | "..(hist and hist.version or "?")
                    .." | YVar:"..string.format("%.0f",sig.yVariance)
