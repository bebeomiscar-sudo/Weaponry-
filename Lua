local function startKiciaCounter()
    if VoidState.kiciaConn then
        VoidState.kiciaConn:Disconnect()
        VoidState.kiciaConn = nil
    end
    VoidState.kiciaConn = RunService.Heartbeat:Connect(function()
        if not KiciaCfg.enabled then return end
        local hrp = getHRP()
