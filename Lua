local function stopAll()
    stopVoidSpam()
    stopAdapt()
    stopTeleDesync()
    stopFireTouch()
    stopKiciaCounter()
    VoidState.enabled = false
    if VoidState.priorityConn then
        VoidState.priorityConn:Disconnect()
        VoidState.priorityConn = nil
    end
    print("[VoidSpam] All stopped")
end

local function startAll()
    VoidState.enabled = true
    startVoidSpam()
    startPrioritySystem()
    if VoidState.adaptEnabled     then startAdapt()        end
    if VoidState.teleDesync       then startTeleDesync()    end
    if VoidState.fireTouchEnabled then startFireTouch()     end
    if KiciaCfg.enabled           then startKiciaCounter()  end
    print("[VoidSpam] All started")
end

