-- ═══════════════════════════════════════════════════════════════════════
-- INIT ALL SYSTEMS
-- ═══════════════════════════════════════════════════════════════════════
local espManager     = ESPManager.new()
local noclip         = Noclip.new()
local fovChanger     = FovChanger.new()
local hackerDetector = HackerDetector.new(espManager._screenGui)
local rgController   = nil
local gameLoop       = GameLoop.new()

local function initRagebot()
    if rgController then return end
    if not (mFig and mEnum and mUtil and rUseItem) then return end
    -- Inline minimal ShootLock for ragebot
    local SL = {}; SL.__index = SL
    function SL.new() return setmetatable({ _until = nil }, SL) end
    function SL:ShouldFire(lock, dur)
        local now = os.clock()
        local locked = self._until ~= nil and now < self._until
        if lock and type(dur) == "number" then self._until = now + dur end
        return locked or lock == true
    end
    function SL:Reset() self._until = nil end

    rgController = {
        _enabled = false,
        _sl      = SL.new(),
        _conn    = nil,
        _running = false,
        _origFPDH= Workspace.FallenPartsDestroyHeight,
    }

    function rgController:SetEnabled(state)
        self._enabled = state
        pcall(function()
            Workspace.FallenPartsDestroyHeight = state and (0/0) or self._origFPDH
        end)
    end

    function rgController:_FindTarget()
        local myHRP = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if not myHRP then return nil, nil end
        local pri  = RagebotConfig.Weapons.Priority
        local cands= {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p == lp then continue end
            local chr = p.Character
            local hm  = chr and chr:FindFirstChildOfClass("Humanoid")
            if not hm or hm.Health <= 0 then continue end
            local hrp2 = chr:FindFirstChild("HumanoidRootPart")
            if not hrp2 then continue end
            local dist = (myHRP.Position - hrp2.Position).Magnitude
            table.insert(cands, { player=p, char=chr, dist=dist, hp=hm.Health })
        end
        if #cands == 0 then return nil, nil end
        if     pri == "Closest" then table.sort(cands, function(a,b) return a.dist < b.dist end)
        elseif pri == "LowHP"   then table.sort(cands, function(a,b) return a.hp   < b.hp   end)
        elseif pri == "HighHP"  then table.sort(cands, function(a,b) return a.hp   > b.hp   end)
        elseif pri == "Random"  then
            for i = #cands, 2, -1 do
                local j = math.random(i)
                cands[i], cands[j] = cands[j], cands[i]
            end
        end
        return cands[1].player, cands[1].char
    end

    function rgController:_Fire(oid, hitPart, myHRP)
        if not mUtil or not mEnum or not rUseItem then return end
        if not hitPart or not hitPart.Parent then return end
        local origin = myHRP.Position + Vector3.new(0,1.5,0)
        local aimCF  = CFrame.lookAt(origin, hitPart.Position)
        local sd     = {}
        pcall(function()
            sd[utf8.char(1)] = {
                [utf8.char(0)] = mUtil:EncodeCFrame(aimCF),
                [utf8.char(1)] = mUtil:EncodeCFrame(hitPart.CFrame),
                [utf8.char(2)] = hitPart,
                [utf8.char(3)] = mUtil:EncodeCFrame(
                    hitPart.CFrame:ToObjectSpace(CFrame.new(hitPart.Position))
                ),
            }
        end)
        pcall(function() rUseItem:FireServer(oid, mEnum:ToEnum("StartShooting"), sd, nil) end)
        task.delay(0.07, function()
            pcall(function() rUseItem:FireServer(oid, mEnum:ToEnum("StopShooting"), {}, nil) end)
        end)
    end

    function rgController:Start()
        self:SetEnabled(true)
        if self._conn then self._conn:Disconnect() end
        self._conn = RunService.Heartbeat:Connect(function(dt)
            if not self._enabled or self._running then return end
            local myChar = lp.Character
            if not myChar then return end
            local myHRP = myChar:FindFirstChild("HumanoidRootPart")
            local myHum = myChar:FindFirstChildOfClass("Humanoid")
            if not myHRP or not myHum or myHum.Health <= 0 then return end

            local lf = nil
            pcall(function() if mFig then lf = mFig.LocalFighter end end)
            if not lf then return end
            local item = lf.EquippedItem; if not item then return end
            local oid  = nil; pcall(function() oid = item:Get("ObjectID") end)
            if not oid then return end

            local ammo = nil
            pcall(function() ammo = item:Get("CurrentAmmo") end)
            if ammo ~= nil and ammo <= 0 then
                if RagebotConfig.Weapons.OnEmpty == "Reload" then
                    pcall(function()
                        rUseItem:FireServer(oid, mEnum:ToEnum("Reload"), {}, nil)
                    end)
                end
                return
            end

            local _, tChar = self:_FindTarget()
            if not tChar then return end

            local PART_PRIO = {"Head","UpperTorso","HumanoidRootPart"}
            local hitPart = nil
            for _, n in ipairs(PART_PRIO) do
                local p = tChar:FindFirstChild(n)
                if p then hitPart = p; break end
            end
            if not hitPart then return end

            local lockDur = dt * RagebotConfig.ShootFrames
            if not self._sl:ShouldFire(true, lockDur) then return end

            self._running = true
            task.spawn(function()
                pcall(function() self:_Fire(oid, hitPart, myHRP) end)
                self._running = false
            end)
        end)
    end

    function rgController:Stop()
        if self._conn then self._conn:Disconnect(); self._conn = nil end
        self._sl:Reset()
        self._running = false
        self:SetEnabled(false)
    end

    function rgController:Destroy()
        self:Stop()
    end
end

pcall(initRagebot)
task.spawn(function()
    while not rgController do
        task.wait(2)
        pcall(initRagebot)
    end
end)

