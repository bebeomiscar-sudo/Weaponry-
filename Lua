local equipped={};local favorites={};local skinEnabled=false;local saveFile="unlockall/config.json"
local function cloneCosmetic(name,cosmeticType,options) if not mCosmetic then return nil end; local base=mCosmetic.Cosmetics[name]; if not base then return nil end; local data={}; for k,v in pairs(base) do data[k]=v end; data.Name=name; data.Type=data.Type or cosmeticType; data.Seed=data.Seed or math.random(1,1000000); if mEnumLib then local ok,eid=pcall(mEnumLib.ToEnum,mEnumLib,name); if ok and eid then data.Enum=eid; data.ObjectID=data.ObjectID or eid end end; if options then if options.inverted~=nil then data.Inverted=options.inverted end end; return data end
local function saveConfig() if not writefile then return end; pcall(function() local cfg={equipped={},favorites=favorites}; for weapon,cosmetics in pairs(equipped) do cfg.equipped[weapon]={}; for ct,cd in pairs(cosmetics) do if cd and cd.Name then cfg.equipped[weapon][ct]={name=cd.Name,seed=cd.Seed,inverted=cd.Inverted} end end end; makefolder("unlockall"); writefile(saveFile,hts:JSONEncode(cfg)) end) end
local function loadConfig() if not readfile or not isfile or not isfile(saveFile) then return end; pcall(function() local cfg=hts:JSONDecode(readfile(saveFile)); if cfg.equipped then for weapon,cosmetics in pairs(cfg.equipped) do equipped[weapon]={}; for ct,cd in pairs(cosmetics) do local cl=cloneCosmetic(cd.name,ct,{inverted=cd.inverted}); if cl then cl.Seed=cd.seed; equipped[weapon][ct]=cl end end end end; favorites=cfg.favorites or {} end) end
local function isAllowed(name,cosmetic) if not cosmetic then return false end; local t=cosmetic.Type or ""; if t=="Finisher" or name:lower():find("finisher") then return false end; return t=="Skin" or t=="Charm" or t=="Dance" or t=="Emote" or t=="Wrap" or t=="Wrapping" or name:lower():find("charm") or name:lower():find("dance") or name:lower():find("emote") or name:lower():find("wrap") end
local function enableSkins() if not mCosmetic or not mData then Lib:Notify("Enter a match first, then enable Skin Changer",4); return end; mCosmetic.OwnsCosmetic=function(self,inventory,name,weapon) if name:find("MISSING_") then return false end; local cosmetic=mCosmetic.Cosmetics[name]; if cosmetic and isAllowed(name,cosmetic) then return true end; return false end; mCosmetic.OwnsCosmeticNormally=mCosmetic.OwnsCosmetic; mCosmetic.OwnsCosmeticUniversally=mCosmetic.OwnsCosmetic; mCosmetic.OwnsCosmeticForWeapon=mCosmetic.OwnsCosmetic; local origGet=mData.Get; mData.Get=function(self,key) local data=origGet(self,key); if key=="CosmeticInventory" then local proxy={}; if data then for k,v in pairs(data) do local c=mCosmetic.Cosmetics[k]; if c and isAllowed(k,c) then proxy[k]=v end end end; return setmetatable(proxy,{__index=function(t,k) local c=mCosmetic.Cosmetics[k]; if c and isAllowed(k,c) then return true end; return nil end}) end; if key=="FavoritedCosmetics" then local result=data and table.clone(data) or {}; for weapon,favs in pairs(favorites) do result[weapon]=result[weapon] or {}; for name,isFav in pairs(favs) do local c=mCosmetic.Cosmetics[name]; if c and isAllowed(name,c) then result[weapon][name]=isFav end end end; return result end; return data end; loadConfig(); skinEnabled=true; Lib:Notify("Skin Changer ON",4) end

