        if (origin - pt.Position).Magnitude > SA.maxDist then continue end
        local sp, on = cam:WorldToViewportPoint(pt.Position); if not on then continue end
        local d = (Vector2.new(sp.X,sp.Y) - center).Magnitude
        if d > SA.fov then continue end
        if SA.vis and not isVis(origin, pt) then continue end
        if SA.mode == "Closest" and d < bd then bd=d; best=pt
        elseif SA.mode == "Furthest" and d > bd then bd=d; best=pt
        elseif SA.mode == "Random" then if not best or math.random()<0.3 then best=pt end end
    end
    saTgt = best; return best
end

local function applySA()
    if saApplied then return end
    if not mUtil then Lib:Notify("SA: Utility not loaded yet",3); return end
    local origRC = mUtil.Raycast
    mUtil.Raycast = function(self, origin, direction, distance, ...)
        if SA.on then
            local target = saGetTarget(origin)
            if target then return origRC(self,origin,target.Position,distance,...) end
        end
        return origRC(self,origin,direction,distance,...)
    end
    saApplied = true; Lib:Notify("SA: Utility.Raycast hooked",3)
end

