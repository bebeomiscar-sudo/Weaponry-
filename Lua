-- ============================================================
-- UTILITY: LookEnum stub (referenced by BoundingBox / outlines)
-- ============================================================

local LookEnum = { None = { kind = "None" } }

-- ============================================================
-- UTILITY: Trove (lightweight cleanup tracker)
-- ============================================================

local Trove = {}
Trove.__index = Trove

function Trove.new(name)
    return setmetatable({ _name = name, _items = {}, _connections = {} }, Trove)
end

function Trove:Add(obj)
    table.insert(self._items, obj)
    return obj
end

function Trove:Connect(signal, fn)
    local conn = signal:Connect(fn)
    table.insert(self._connections, conn)
    return conn
end

function Trove:Clean()
    for _, c in ipairs(self._connections) do pcall(function() c:Disconnect() end) end
    self._connections = {}
    for _, obj in ipairs(self._items) do
        if type(obj) == "table" and obj.Destroy then pcall(obj.Destroy, obj) end
    end
    self._items = {}
end

function Trove:Destroy()
    self:Clean()
end

-- ============================================================
-- CORNER OUTLINE (box ESP with corner-bracket style)
-- ============================================================

local CornerOutline = {}
CornerOutline.__index = CornerOutline

function CornerOutline.new(parent)
    local self = setmetatable({}, CornerOutline)
    self._corners    = {}
    self._enabled    = false
    self._innerColor = Color3.new(1, 1, 1)
    self._look       = LookEnum.None
    self:_Initialize(parent)
    return self
end

function CornerOutline:_Initialize(parent)
    local STROKE = 3
    local INSET  = 1
    local INNER  = STROKE - 2 * INSET

    local function makeCorner()
        local c = {
            horizontalColor  = Instance.new("Frame"),
            verticalColor    = Instance.new("Frame"),
            horizontalBacker = Instance.new("Frame"),
            verticalBacker   = Instance.new("Frame"),
        }
        for _, f in pairs(c) do
            f.Visible              = false
            f.BackgroundColor3     = Color3.new(1, 1, 1)
            f.BorderSizePixel      = 0
            f.Interactable         = false
            f.ZIndex               = 10
            f.Parent               = parent
        end
        return c
    end

    self._corners = { makeCorner(), makeCorner(), makeCorner(), makeCorner() }

    for _, c in ipairs(self._corners) do
        c.horizontalColor.Size  = UDim2.new(INNER / math.max(1, parent.AbsoluteSize.X), 0, 0, INNER)
        c.verticalColor.Size    = UDim2.new(0, INNER, INNER / math.max(1, parent.AbsoluteSize.Y), 0)
        c.horizontalBacker.Size = c.horizontalColor.Size
        c.verticalBacker.Size   = c.verticalColor.Size
    end
end

function CornerOutline:SetEnabled(enabled)
    self._enabled = enabled
    for _, c in ipairs(self._corners) do
        c.horizontalColor.Visible  = enabled
        c.verticalColor.Visible    = enabled
        c.horizontalBacker.Visible = enabled
        c.verticalBacker.Visible   = enabled
    end
end

function CornerOutline:SetOutlineColor(color)
    for _, c in ipairs(self._corners) do
        c.horizontalBacker.BackgroundColor3 = color
        c.verticalBacker.BackgroundColor3   = color
    end
end

function CornerOutline:SetLook(innerColor, look)
    self._innerColor = innerColor
    self._look       = look or LookEnum.None
    for _, c in ipairs(self._corners) do
        c.horizontalColor.BackgroundColor3 = innerColor
        c.verticalColor.BackgroundColor3   = innerColor
    end
end

function CornerOutline:Destroy()
    for _, c in ipairs(self._corners) do
        c.horizontalColor:Destroy()
        c.verticalColor:Destroy()
        c.horizontalBacker:Destroy()
        c.verticalBacker:Destroy()
    end
end

-- ============================================================
-- STROKE OUTLINE (UIStroke-based full box)
-- ============================================================

local StrokeOutline = {}
StrokeOutline.__index = StrokeOutline

function StrokeOutline.new(parent)
    local self       = setmetatable({}, StrokeOutline)
    self._inner      = Instance.new("Frame")
    self._outerStroke = Instance.new("UIStroke")
    self._innerStroke = Instance.new("UIStroke")
    self._enabled    = false
    self._innerColor = Color3.new(1, 1, 1)

    local outer = self._outerStroke
    outer.ApplyStrokeMode      = Enum.ApplyStrokeMode.Border
    outer.LineJoinMode         = Enum.LineJoinMode.Miter
    outer.Thickness            = 3
    outer.Enabled              = false
    outer.Parent               = parent

    local inner = self._inner
    inner.BackgroundTransparency = 1
    inner.BorderSizePixel        = 0
    inner.Interactable           = false
    inner.Size                   = UDim2.fromScale(1, 1)
    inner.Parent                 = parent

    local innerStroke = self._innerStroke
    innerStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    innerStroke.LineJoinMode    = Enum.LineJoinMode.Miter
    innerStroke.Thickness       = 1
    innerStroke.Enabled         = false
    innerStroke.Parent          = inner

    return self
end

function StrokeOutline:SetEnabled(enabled)
    self._enabled              = enabled
    self._outerStroke.Enabled  = enabled
    self._innerStroke.Enabled  = enabled
end

function StrokeOutline:SetOutlineColor(color)
    self._outerStroke.Color = color
end

function StrokeOutline:SetLook(innerColor)
    self._innerColor        = innerColor
    self._innerStroke.Color = innerColor
end

function StrokeOutline:Destroy()
    self._inner:Destroy()
    self._outerStroke:Destroy()
end

-- ============================================================
-- BOUNDING BOX (per-player ESP box wrapper)
-- ============================================================

local BoundingBox = {}
BoundingBox.__index = BoundingBox

function BoundingBox.new(screenGui)
    local self    = setmetatable({}, BoundingBox)
    self._gui     = screenGui
    self._frame   = Instance.new("Frame")
    self._outline = nil
    self._style   = ""
    self._visible = false

    local f = self._frame
    f.BackgroundTransparency = 1
    f.BorderSizePixel        = 0
    f.Interactable           = false
    f.Visible                = false
    f.Parent                 = screenGui

    return self
end

function BoundingBox:SetStyle(style)
    if style == self._style and self._outline ~= nil then return end
    if self._outline then self._outline:Destroy() end
    self._style   = style
    self._outline = style == "Corner"
        and CornerOutline.new(self._frame)
        or  StrokeOutline.new(self._frame)
end

function BoundingBox:SetColors(innerColor, outlineColor)
    if self._outline then
        self._outline:SetLook(innerColor)
        self._outline:SetOutlineColor(outlineColor)
    end
end

function BoundingBox:SetEnabled(enabled)
    self._frame.Visible = enabled
    if self._outline then self._outline:SetEnabled(enabled) end
end

-- Update: position and size the frame to wrap the character on screen.
-- topLeft and bottomRight are Vector2 screen positions.
function BoundingBox:Update(topLeft, bottomRight)
    local f = self._frame
    f.Position = UDim2.fromOffset(topLeft.X, topLeft.Y)
    f.Size     = UDim2.fromOffset(
        math.max(1, bottomRight.X - topLeft.X),
        math.max(1, bottomRight.Y - topLeft.Y)
    )
end

function BoundingBox:Destroy()
    if self._outline then self._outline:Destroy() end
    self._frame:Destroy()
end

-- ============================================================
-- SKELETON (line segments between body parts)
-- ============================================================

local SKELETON_PARTS = {
    Head = true, UpperTorso = true, LowerTorso = true, Torso = true,
    LeftUpperArm = true, LeftLowerArm = true, LeftHand = true,
    RightUpperArm = true, RightLowerArm = true, RightHand = true,
    LeftUpperLeg = true, LeftLowerLeg = true, LeftFoot = true,
    RightUpperLeg = true, RightLowerLeg = true, RightFoot = true,
    LeftArm = true, RightArm = true, LeftLeg = true, RightLeg = true,
}

local BONE_CONNECTIONS = {
    { "Head", "UpperTorso" }, { "Head", "Torso" },
    { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" }, { "LeftUpperArm", "LeftLowerArm" }, { "LeftLowerArm", "LeftHand" },
    { "UpperTorso", "RightUpperArm" }, { "RightUpperArm", "RightLowerArm" }, { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" }, { "LeftUpperLeg", "LeftLowerLeg" }, { "LeftLowerLeg", "LeftFoot" },
    { "LowerTorso", "RightUpperLeg" }, { "RightUpperLeg", "RightLowerLeg" }, { "RightLowerLeg", "RightFoot" },
    { "Torso", "LeftArm" }, { "Torso", "RightArm" }, { "Torso", "LeftLeg" }, { "Torso", "RightLeg" },
}

local Skeleton = {}
Skeleton.__index = Skeleton

function Skeleton.new(screenGui)
    local self = setmetatable({}, Skeleton)
    self._gui   = screenGui
    self._lines = {}
    return self
end

local function makeSkeletonLine(gui, color)
    local f = Instance.new("Frame")
    f.Visible              = false
    f.BorderSizePixel      = 0
    f.AnchorPoint          = Vector2.new(0.5, 0.5)
    f.BackgroundColor3     = color
    f.BackgroundTransparency = 0
    f.ZIndex               = 5
    f.Parent               = gui
    return f
end

local function updateLine(frame, from, to, thickness)
    local dx    = to.X - from.X
    local dy    = to.Y - from.Y
    local len   = math.sqrt(dx * dx + dy * dy)
    local angle = math.atan2(dy, dx)
    frame.Position  = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
    frame.Size      = UDim2.fromOffset(len, thickness or 1)
    frame.Rotation  = math.deg(angle)
    frame.Visible   = true
end

function Skeleton:Update(character, color)
    -- build a name → part lookup
    local parts = {}
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and SKELETON_PARTS[part.Name] then
            parts[part.Name] = part
        end
    end

    local cam = workspace.CurrentCamera
    local lineIdx = 1

    for _, conn in ipairs(BONE_CONNECTIONS) do
        local a = parts[conn[1]]
        local b = parts[conn[2]]
        if a and b then
            local sa, va = cam:WorldToViewportPoint(a.Position)
            local sb, vb = cam:WorldToViewportPoint(b.Position)
            if va and vb and sa.Z > 0 and sb.Z > 0 then
                local line = self._lines[lineIdx]
                if not line then
                    line = makeSkeletonLine(self._gui, color)
                    self._lines[lineIdx] = line
                end
                line.BackgroundColor3 = color
                updateLine(line, Vector2.new(sa.X, sa.Y), Vector2.new(sb.X, sb.Y), 1)
                lineIdx = lineIdx + 1
            end
        end
    end

    -- hide unused lines
    for i = lineIdx, #self._lines do
        self._lines[i].Visible = false
    end
end

function Skeleton:Hide()
    for _, l in ipairs(self._lines) do l.Visible = false end
end

function Skeleton:Destroy()
    for _, l in ipairs(self._lines) do l:Destroy() end
end

-- ============================================================
-- TRACER (line from screen bottom to target)
-- ============================================================

local Tracer = {}
Tracer.__index = Tracer

function Tracer.new(screenGui)
    local self   = setmetatable({}, Tracer)
    self._gui    = screenGui
    self._line   = Instance.new("Frame")
    local f      = self._line
    f.Visible              = false
    f.BorderSizePixel      = 0
    f.AnchorPoint          = Vector2.new(0.5, 0.5)
    f.BackgroundColor3     = Color3.new(1, 1, 1)
    f.ZIndex               = 4
    f.Parent               = screenGui
    return self
end

function Tracer:Update(targetScreenPos, color)
    local cam = workspace.CurrentCamera
    local vp  = cam.ViewportSize
    local originX = vp.X / 2
    local originY = vp.Y
    updateLine(self._line, Vector2.new(originX, originY), targetScreenPos, 1)
    self._line.BackgroundColor3 = color
    self._line.Visible = true
end

function Tracer:Hide()
    self._line.Visible = false
end

function Tracer:Destroy()
    self._line:Destroy()
end

-- ============================================================
-- CHAMS (always-on-top highlight via SelectionBox)
-- ============================================================

local Chams = {}
Chams.__index = Chams

function Chams.new()
    local self = setmetatable({}, Chams)
    self._boxes = {}  -- [character] = SelectionBox
    return self
end

function Chams:Apply(character, color)
    if self._boxes[character] then
        self._boxes[character].Color3 = color
        return
    end
    local folder = Instance.new("Folder")
    folder.Name  = "KiciaChams"
    folder.Parent = workspace

    local box = Instance.new("SelectionBox")
    box.Adornee       = character
    box.Color3        = color
    box.LineThickness = 0.05
    box.SurfaceTransparency = 0.6
    box.SurfaceColor3 = color
    box.Parent        = folder

    self._boxes[character] = box
end

function Chams:Remove(character)
    local box = self._boxes[character]
    if box then
        box.Parent:Destroy()
        self._boxes[character] = nil
    end
end

function Chams:Destroy()
    for char in pairs(self._boxes) do self:Remove(char) end
end

