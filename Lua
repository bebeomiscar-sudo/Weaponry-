            if distToPlayer(p) > KiciaCfg.counterDist then continue end
            KiciaCfg.counterActive = true
            local savedCF = hrp.CFrame
            pcall(function()
                hrp.CFrame = CFrame.new(hrp.Position + KiciaCfg.evadeDir)
            end)
            RunService:BindToRenderStep(
                "__kiciaRestore", Enum.RenderPriority.First.Value,
                function()
                    pcall(function() hrp.CFrame = savedCF end)
                    RunService:UnbindFromRenderStep("__kiciaRestore")
                end
            )

            -- Counter-attack after evade
