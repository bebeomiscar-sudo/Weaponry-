local TriggerbotController = {}
TriggerbotController.__index = TriggerbotController

function TriggerbotController.new()
    local self = setmetatable({}, TriggerbotController)
    self._trove           = Trove.new("triggerbot")
    self._reactionElapsed = nil
    self._releaseRemaining = 0

    self._trove:Connect(RunService.Heartbeat, function(dt)
        self:_Update(dt)
    end)
    return self
end

function TriggerbotController:_CheckCrosshair()
    local cam = workspace.CurrentCamera
    local vp  = cam.ViewportSize
    local ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LocalPlayer.Character }

    local result = workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
    if not result then return false end

    local model = result.Instance:FindFirstAncestorOfClass("Model")
    if not model then return false end

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if player.Character == model then
            if Config.Triggerbot.TeamCheck and player.Team == LocalPlayer.Team then
                return false
            end
            local h = model:FindFirstChildOfClass("Humanoid")
            return h ~= nil and h.Health > 0
        end
    end
    return false
end

local function fireTriggerbotShot()
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    -- use mouse1click via VirtualInputManager
    local success, VIM = pcall(function()
        return game:GetService("VirtualInputManager")
    end)
    if success and VIM then
        VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.defer(function()
            VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end)
    end
end

function TriggerbotController:_Update(dt)
    local cfg = Config.Triggerbot
    if not cfg.Enabled then
        self._reactionElapsed  = nil
        self._releaseRemaining = 0
        return
    end

    local onTarget = self:_CheckCrosshair()
    if onTarget then
        self._reactionElapsed = (self._reactionElapsed or 0) + dt
    else
        self._reactionElapsed = nil
    end

    local reactionMet = self._reactionElapsed ~= nil
                     and cfg.ReactionTime <= self._reactionElapsed

    if onTarget and reactionMet then
        self._releaseRemaining = cfg.ReleaseTime
        fireTriggerbotShot()
        return
    end

    self._releaseRemaining = math.max(0, self._releaseRemaining - dt)
    if self._releaseRemaining > 0 then
        fireTriggerbotShot()
    end
end

function TriggerbotController:Destroy()
    self._trove:Destroy()
end

