RunService.Heartbeat:Connect(function()
    if not PriorityCfg.enabled then return end
    pcall(function()
        local sorted = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p == lp then continue end
            local hist = playerHistory[p]
            if hist then
                table.insert(sorted,{
                    name=p.Name, score=hist.score,
                    inVoid=hist.inVoid, conf=hist.confidence or 0
                })
            end
        end
        table.sort(sorted, function(a,b) return a.score>b.score end)
        local lines = {}
        for i, e in ipairs(sorted) do
            if i>3 then break end
            table.insert(lines,
                "#"..i.." "..e.name
                .." S:"..math.floor(e.score)
                .." V:"..(e.inVoid and "Y" or "n")
                .." C:"..math.floor(e.conf).."%"
            )
        end
        pv_status:UpdateText(#lines>0 and table.concat(lines,"\n") or "No data")
    end)
end)
