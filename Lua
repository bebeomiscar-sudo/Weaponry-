    while not mCam do task.wait(1) end
    if mCam and mCam.Update then
        local oldCamUpdate = mCam.Update
        mCam.Update = function(...)
            if KR.enabled and KR._prevCF then
                pcall(function()
                    local lf = mFig and mFig.LocalFighter
                    if lf and lf.Entity and lf.Entity.RootPart then
                        lf.Entity.RootPart.CFrame = KR._prevCF
                    end
                end)
            end
            return oldCamUpdate(...)
        end
    end
end)

