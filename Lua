-- ANTI-AIM SYSTEM
-- ═══════════════════════════════════════════════════════════
local AA = {
    enabled      = false,
    pitch        = "Off",
    yawBase      = "Local",
    yaw          = "Off",
    yawAngle     = 0,
    underground  = false,
}

local function betterRandom(mi, ma, dmi, dma)
    local val = math.random(mi, ma)
    repeat val = math.random(mi, ma)
    until val < dmi or val > dma
    return val
end

local aaClientCF  = nil
local aaClientLV  = nil
local aaClientAV  = nil
local aaSpinAngle = 0
local aaStutterOn = false
local aaGlitchT   = 0

local function computeAACFrame(dt)
    if not ch then return nil end
    local myHRP = ch:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    local base = aaClientCF or myHRP.CFrame
    local pos  = base.Position

    if AA.underground then
        pos = pos - Vector3.new(0, 5, 0)
    end

    local pitchRad = 0
    if AA.pitch == "Up" then
        pitchRad = math.rad(-89)
    elseif AA.pitch == "Zero" then
        pitchRad = 0
    elseif AA.pitch == "Down" then
        pitchRad = math.rad(89)
    elseif AA.pitch == "Glitch" then
        pitchRad = math.rad(betterRandom(-89, 89, -10, 10))
    elseif AA.pitch == "Random" then
        pitchRad = math.rad(math.random(-89, 89))
    end

    local baseYaw = 0
    if AA.yawBase == "Local" then
        local _, ry, _ = base:ToEulerAnglesYXZ()
        baseYaw = ry
    elseif AA.yawBase == "AtTargets" then
        local myPos = base.Position
        local closest = nil; local cd = math.huge
        for _, p in ipairs(plr:GetPlayers()) do
            if p == lp then continue end
            local ec = p.Character; if not ec then continue end
            local eh = ec:FindFirstChild("HumanoidRootPart"); if not eh then continue end
            local d = (myPos - eh.Position).Magnitude
            if d < cd then cd = d; closest = eh end
        end
        if closest then
            local dir = (closest.Position - myPos) * Vector3.new(1,0,1)
            if dir.Magnitude > 0.01 then
                baseYaw = math.atan2(-dir.X, -dir.Z)
            end
        else
            local _, ry, _ = base:ToEulerAnglesYXZ()
            baseYaw = ry
        end
    end

    local yawOffset = math.rad(AA.yawAngle)

    if AA.yaw == "Forward" then
        yawOffset = yawOffset + 0
    elseif AA.yaw == "Backward" then
        yawOffset = yawOffset + math.rad(180)
    elseif AA.yaw == "Spin" then
        aaSpinAngle = aaSpinAngle + dt * 720
        yawOffset   = yawOffset + math.rad(aaSpinAngle)
    elseif AA.yaw == "GlitchSpin" then
        aaSpinAngle = aaSpinAngle + dt * 1440
        local glitchExtra = math.rad(betterRandom(-180, 180, -10, 10))
        yawOffset   = yawOffset + math.rad(aaSpinAngle) + glitchExtra
    elseif AA.yaw == "StutterSpin" then
        aaStutterOn = not aaStutterOn
        if aaStutterOn then
            aaSpinAngle = aaSpinAngle + dt * 720
        else
            aaSpinAngle = aaSpinAngle - dt * 360
        end
        yawOffset = yawOffset + math.rad(aaSpinAngle)
    end

    local finalYaw = baseYaw + yawOffset

    local newCF = CFrame.new(pos)
        * CFrame.fromEulerAnglesYXZ(pitchRad, finalYaw, 0)

    return newCF
end

local aaHeartConn  = nil
local aaRenderConn = nil

local function stopAntiAim()
    AA.enabled = false
    if aaHeartConn  then aaHeartConn:Disconnect();  aaHeartConn  = nil end
    if aaRenderConn then aaRenderConn:Disconnect(); aaRenderConn = nil end
    aaClientCF = nil; aaClientLV = nil; aaClientAV = nil
    aaSpinAngle = 0; aaStutterOn = false
end

local function startAntiAim()
    stopAntiAim()
    AA.enabled  = true
    aaSpinAngle = 0

    aaHeartConn = rs.Heartbeat:Connect(function(dt)
        if not AA.enabled then stopAntiAim(); return end
        local myHRP = ch and ch:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end

        aaClientCF = myHRP.CFrame
        aaClientLV = myHRP.AssemblyLinearVelocity
        aaClientAV = myHRP.AssemblyAngularVelocity

        local desynced = computeAACFrame(dt)
        if not desynced then return end

        pcall(function()
            myHRP.CFrame = desynced

            if AA.pitch == "Glitch" or AA.yaw == "GlitchSpin" then
                myHRP.CFrame = CFrame.new(
                    betterRandom(-2147483646, 2147483646, -1147483646, 1147483646),
                    betterRandom(-2147483646, 2147483646, -1147483646, 1147483646),
                    betterRandom(-2147483646, 2147483646, -1147483646, 1147483646)
                ) * CFrame.Angles(math.rad(math.pi), math.rad(math.pi), math.rad(math.pi))
                myHRP.AssemblyLinearVelocity = Vector3.new(
                    betterRandom(-2147483646, 2147483646, -1147483646, 1147483646),
                    betterRandom(-2147483646, 2147483646, -1147483646, 1147483646),
                    betterRandom(-2147483646, 2147483646, -1147483646, 1147483646)
                )
                myHRP.AssemblyAngularVelocity = Vector3.new(
                    betterRandom(-2147483646, 2147483646, -1147483646, 1147483646),
                    betterRandom(-2147483646, 2147483646, -1147483646, 1147483646),
                    betterRandom(-2147483646, 2147483646, -1147483646, 1147483646)
                )
            end
        end)
    end)

    rs:BindToRenderStep("AA_Sync", Enum.RenderPriority.First.Value, function()
        if not AA.enabled then return end
        local myHRP = ch and ch:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end
        if aaClientCF then
            pcall(function()
                myHRP.CFrame                  = aaClientCF
                myHRP.AssemblyLinearVelocity  = aaClientLV  or Vector3.zero
                myHRP.AssemblyAngularVelocity = aaClientAV  or Vector3.zero
            end)
        end
    end)
end

