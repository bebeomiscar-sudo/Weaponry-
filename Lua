local function GetClosestPlayer()
    local closest, closestDist = nil, math.huge
    local camera = workspace.CurrentCamera
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
            
            if humanoid and humanoid.Health > 0 and rootPart then
                local screenPos, onScreen = camera:WorldToViewportPoint(rootPart.Position)
                
                if onScreen then
                    local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
                    local distance = (screenCenter - screenPos2D).Magnitude
                    
                    if distance <= Config.Aimbot.FOV and distance < closestDist then
                        closest = player
                        closestDist = distance
                    end
                end
            end
        end
    end
    
    return closest
end

--[[
    ═══════════════════════════════════════════════════════
                    WALLBANG SYSTEM
    ═══════════════════════════════════════════════════════
]]

workspace.Raycast = newcclosure(function(self, origin, direction, params)
    if not Config.Wallbang.Enabled then
        return originalRaycast(self, origin, direction, params)
    end
    
    params = params or RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    
    local ignoreList = params.FilterDescendantsInstances or {}
    
    if Config.Wallbang.IgnoreMap then
        local map = Workspace:FindFirstChild("Map")
        if map then
            table.insert(ignoreList, map)
        end
        
        for _, obj in pairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.CanCollide then
                local name = obj.Name:lower()
                if name:find("wall") or name:find("barrier") or 
                   name:find("fence") or name:find("door") or 
                   name:find("block") then
                    table.insert(ignoreList, obj)
                end
            end
        end
    end
    
    params.FilterDescendantsInstances = ignoreList
    
    return originalRaycast(self, origin, direction, params)
end)

--[[
    ═══════════════════════════════════════════════════════
                    WEAPON MODIFICATION
    ═══════════════════════════════════════════════════════
]]

local function ModifyWeapon(tool)
    if not tool or not tool:IsA("Tool") then return end
    
    pcall(function()
        -- Damage
        if Config.Damage.Enabled then
            if tool:FindFirstChild("Damage") then
                tool.Damage.Value = Config.Damage.OneShotKill and 999 or Config.Damage.Base
            end
            if tool:FindFirstChild("HeadshotMultiplier") then
                tool.HeadshotMultiplier.Value = Config.Damage.Headshot / Config.Damage.Base
            end
        end
        
        -- Fire Rate
        if Config.FireRate.Enabled then
            if tool:FindFirstChild("FireRate") then
                tool.FireRate.Value = Config.FireRate.RapidFire and 0.001 or (60 / Config.FireRate.RPM)
            end
        end
        
        -- Ammo
        if Config.Ammo.InfiniteAmmo then
            if tool:FindFirstChild("Ammo") then
                tool.Ammo.Value = 999
            end
            if tool:FindFirstChild("StoredAmmo") then
                tool.StoredAmmo.Value = 9999
            end
        end
        
        if Config.Ammo.Enabled then
            if tool:FindFirstChild("MagSize") then
                tool.MagSize.Value = Config.Ammo.MagSize
            end
            if tool:FindFirstChild("ReloadTime") then
                tool.ReloadTime.Value = Config.Ammo.InstantReload and 0.001 or tool.ReloadTime.Value
            end
        end
        
        -- Accuracy
        if Config.Accuracy.NoRecoil then
            if tool:FindFirstChild("Recoil") then
                tool.Recoil.Value = 0
            end
            if tool:FindFirstChild("RecoilVertical") then
                tool.RecoilVertical.Value = 0
            end
            if tool:FindFirstChild("RecoilHorizontal") then
                tool.RecoilHorizontal.Value = 0
            end
        end
        
        if Config.Accuracy.NoSpread then
            if tool:FindFirstChild("Spread") then
                tool.Spread.Value = 0
            end
            if tool:FindFirstChild("Accuracy") then
                tool.Accuracy.Value = 100
            end
        end
        
        -- Pellets
        if Config.Pellets.Enabled then
            if tool:FindFirstChild("Pellets") then
                tool.Pellets.Value = Config.Pellets.Count
            end
            if tool:FindFirstChild("PelletSpread") then
                tool.PelletSpread.Value = Config.Pellets.Spread
            end
        end
        
        -- Range
        if Config.Range.Enabled then
            if tool:FindFirstChild("Range") then
                tool.Range.Value = Config.Range.MaxDistance
            end
            if tool:FindFirstChild("MaxDistance") then
                tool.MaxDistance.Value = Config.Range.MaxDistance
            end
        end
    end)
end

--[[
    ═══════════════════════════════════════════════════════
                    AIMBOT SYSTEM
    ═══════════════════════════════════════════════════════
]]

Connections.Aimbot = RunService.RenderStepped:Connect(function()
    if not Config.Aimbot.Enabled then return end
    
    local target = GetClosestPlayer()
    if not target or not target.Character then return end
    
    local targetPart = target.Character:FindFirstChild(Config.Aimbot.TargetPart)
    if not targetPart then return end
    
    local camera = workspace.CurrentCamera
    local targetPos = targetPart.Position
    
    local currentCF = camera.CFrame
    local targetCF = CFrame.new(currentCF.Position, targetPos)
    
    local smoothness = Config.Aimbot.Smoothness / 100
    camera.CFrame = currentCF:Lerp(targetCF, smoothness)
end)

