-- =============================================
--   CALIBRATION ENGINE
-- =============================================

local CalibrationData = {
    samples       = {},
    maxSamples    = 20,
    isCalibrated  = false,
    avgError      = Vector3.zero,
    errorX        = 0,
    errorY        = 0,
    errorZ        = 0,
    corrections   = {x=0, y=0, z=0},
}

local function addCalibrationSample(voidPos, realTargetPos)
    local error = realTargetPos - voidPos
    table.insert(CalibrationData.samples, {
        voidPos   = voidPos,
        targetPos = realTargetPos,
        error     = error,
        time      = tick(),
    })
    if #CalibrationData.samples > CalibrationData.maxSamples then
        table.remove(CalibrationData.samples, 1)
    end
    if #CalibrationData.samples >= 3 then
        local sumX, sumY, sumZ = 0, 0, 0
        for _, s in ipairs(CalibrationData.samples) do
            sumX += s.error.X
            sumY += s.error.Y
            sumZ += s.error.Z
        end
        local n = #CalibrationData.samples
        CalibrationData.avgError = Vector3.new(sumX/n, sumY/n, sumZ/n)
        CalibrationData.errorX   = sumX / n
        CalibrationData.errorY   = sumY / n
        CalibrationData.errorZ   = sumZ / n
        CalibrationData.corrections = {
            x = -CalibrationData.errorX,
            y = -CalibrationData.errorY,
            z = -CalibrationData.errorZ,
        }
        CalibrationData.isCalibrated = true
    end
end

-- =============================================
--   VELOCITY PREDICTION
-- =============================================

local targetVelocityHistory = {}

local function updateVelocityHistory(player)
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if not targetVelocityHistory[player] then
        targetVelocityHistory[player] = {positions={}, times={}}
    end
    local hist = targetVelocityHistory[player]
    table.insert(hist.positions, hrp.Position)
    table.insert(hist.times, tick())
    if #hist.positions > 10 then
        table.remove(hist.positions, 1)
        table.remove(hist.times, 1)
    end
end

local function predictTargetPosition(player, ticksAhead)
    local hist = targetVelocityHistory[player]
    if not hist or #hist.positions < 2 then
        local char = player.Character
        if not char then return Vector3.zero end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return Vector3.zero end
        return hrp.Position
    end
    local velSum = Vector3.zero
    local count  = 0
    local n      = #hist.positions
    for i = math.max(2, n-2), n do
        local dt = hist.times[i] - hist.times[i-1]
        if dt > 0 then
            velSum = velSum + (hist.positions[i] - hist.positions[i-1]) / dt
            count  += 1
        end
    end
    if count == 0 then return hist.positions[n] end
    local avgVel   = velSum / count
    local predTime = ticksAhead * 0.016
    return hist.positions[n] + (avgVel * predTime)
end

-- =============================================
--   CORE CORRECTION MATH
-- =============================================

local function applyXYZCorrection(voidFirePos, targetRealPos)
    local correctedPos = voidFirePos

    if OffsetFixer.correctX then
        correctedPos = Vector3.new(
            (targetRealPos.X * 2) - voidFirePos.X + OffsetFixer.xFineOffset,
            correctedPos.Y,
            correctedPos.Z
        )
    end

    if OffsetFixer.correctY then
        local baseHeight  = voidFirePos.Y - targetRealPos.Y
        local fixedHeight = baseHeight * OffsetFixer.yCorrectionMult
        correctedPos = Vector3.new(
            correctedPos.X,
            targetRealPos.Y + fixedHeight + OffsetFixer.yFineOffset,
            correctedPos.Z
        )
    end

    if OffsetFixer.correctZ then
        correctedPos = Vector3.new(
            correctedPos.X,
            correctedPos.Y,
            (targetRealPos.Z * 2) - voidFirePos.Z + OffsetFixer.zFineOffset
        )
    end

    if OffsetFixer.autoCalibrate and CalibrationData.isCalibrated then
        correctedPos = Vector3.new(
            correctedPos.X + CalibrationData.corrections.x,
            correctedPos.Y + CalibrationData.corrections.y,
            correctedPos.Z + CalibrationData.corrections.z
        )
    end

    return correctedPos
end

-- =============================================
--   HRP CORRECTION APPLIER
-- =============================================

local function applyOffsetFix(userPlayer)
    local char = userPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local absY = math.abs(hrp.Position.Y)
    if absY < OffsetFixer.voidThreshold then return end

    local target = OffsetFixer.targetPlayer
    if not target then
        local best, bd = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p == userPlayer then continue end
            local pChar = p.Character
            if not pChar then continue end
            local pHRP = pChar:FindFirstChild("HumanoidRootPart")
            if not pHRP then continue end
            if math.abs(pHRP.Position.Y) > OffsetFixer.voidThreshold then continue end
            local d = (hrp.Position - pHRP.Position).Magnitude
            if d < bd then bd=d; best=p end
        end
        target = best
    end

    if not target then return end
    local tChar = target.Character
    if not tChar then return end
    local tHRP = tChar:FindFirstChild("HumanoidRootPart")
    if not tHRP then return end

    local targetPos = tHRP.Position
    if OffsetFixer.useVelocityPred then
        targetPos = predictTargetPosition(target, OffsetFixer.predTicks)
    end

    local brokenFirePos = hrp.Position
    local correctedPos  = applyXYZCorrection(brokenFirePos, targetPos)

    OffsetFixer.lastRealPos      = targetPos
    OffsetFixer.lastVoidPos      = brokenFirePos
    OffsetFixer.lastCorrectedPos = correctedPos

    local savedVel  = hrp.AssemblyLinearVelocity
    local savedAVel = hrp.AssemblyAngularVelocity

    pcall(function()
        hrp.CFrame                  = CFrame.new(correctedPos)
        hrp.AssemblyLinearVelocity  = savedVel
        hrp.AssemblyAngularVelocity = savedAVel
    end)

    OffsetFixer.fixCount += 1

    if OffsetFixer.autoCalibrate then
        pcall(function() addCalibrationSample(brokenFirePos, targetPos) end)
    end
end

-- =============================================
--   LOCAL PLAYER FIXER
-- =============================================

local LocalFixer = {
    enabled       = false,
    fixingConn    = nil,
    inVoid        = false,
    fixApplied    = false,
    lastTarget    = nil,
}

local function findMyTarget()
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, bd = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == lp then continue end
        local char = p.Character
        if not char then continue end
        local tHRP = char:FindFirstChild("HumanoidRootPart")
        if not tHRP then continue end
        if math.abs(tHRP.Position.Y) > OffsetFixer.voidThreshold then continue end
        local d = (hrp.Position - tHRP.Position).Magnitude
        if d < bd then bd=d; best=p end
    end
    return best
end

local function startLocalFixer()
    if LocalFixer.fixingConn then
        LocalFixer.fixingConn:Disconnect()
        LocalFixer.fixingConn = nil
    end
    LocalFixer.fixingConn = RunService.Heartbeat:Connect(function()
        if not LocalFixer.enabled then return end
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local absY = math.abs(hrp.Position.Y)

        local myTarget = findMyTarget()
        if myTarget then
            pcall(function() updateVelocityHistory(myTarget) end)
            LocalFixer.lastTarget = myTarget
        end

        if absY > OffsetFixer.voidThreshold then
            if not LocalFixer.inVoid then
                LocalFixer.inVoid = true
                local target = LocalFixer.lastTarget or findMyTarget()
                if not target then return end
                local tChar = target.Character
                if not tChar then return end
                local tHRP = tChar:FindFirstChild("HumanoidRootPart")
                if not tHRP then return end
                local targetPos = OffsetFixer.useVelocityPred
                    and predictTargetPosition(target, OffsetFixer.predTicks)
                    or  tHRP.Position
                local brokenPos    = hrp.Position
                local correctedPos = applyXYZCorrection(brokenPos, targetPos)
                pcall(function() hrp.CFrame = CFrame.new(correctedPos) end)
                LocalFixer.fixApplied = true
                OffsetFixer.fixCount  += 1
                if OffsetFixer.autoCalibrate then
                    pcall(function() addCalibrationSample(brokenPos, targetPos) end)
                end
            end
        else
            if LocalFixer.inVoid then
                LocalFixer.inVoid     = false
                LocalFixer.fixApplied = false
            end
        end
    end)
end

local function stopLocalFixer()
    LocalFixer.enabled    = false
    LocalFixer.inVoid     = false
    LocalFixer.fixApplied = false
    if LocalFixer.fixingConn then
        LocalFixer.fixingConn:Disconnect()
        LocalFixer.fixingConn = nil
    end
end

-- =============================================
--   FRIEND FIXER
-- =============================================

local FriendFixer = {
    enabled      = false,
    friends      = {},
    autoDetect   = true,
    fixedPlayers = {},
}

local friendFixConn = nil

local function isFriendOrV3Free(player)
    for _, name in ipairs(FriendFixer.friends) do
        if player.Name:lower() == name:lower() then return true end
    end
    if FriendFixer.autoDetect then
        local char = player.Character
        if not char then return false end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        if math.abs(hrp.Position.Y) > OffsetFixer.voidThreshold then
            return true
        end
    end
    return false
end

local function startFriendFixer()
    if friendFixConn then friendFixConn:Disconnect(); friendFixConn=nil end
    friendFixConn = RunService.Heartbeat:Connect(function()
        if not FriendFixer.enabled then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p == lp then continue end
            if isFriendOrV3Free(p) then
                pcall(function()
                    updateVelocityHistory(p)
                    applyOffsetFix(p)
                    if not FriendFixer.fixedPlayers[p] then
                        FriendFixer.fixedPlayers[p] = 0
                    end
                    FriendFixer.fixedPlayers[p] += 1
                end)
            end
        end
    end)
end

local function stopFriendFixer()
    FriendFixer.enabled = false
    if friendFixConn then friendFixConn:Disconnect(); friendFixConn=nil end
end

