local MinimizeCfg = {
    enabled      = false,
    mode         = "HeadOnly",
    scale        = 0.1,
    restoreOnDie = true,
    savedSizes   = {},
    connections  = {},
}

local function getCharParts(char)
    if not char then return {} end
    local parts = {}
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            table.insert(parts, part)
        end
    end
    return parts
end

local function saveOriginalSizes(char)
    MinimizeCfg.savedSizes = {}
    for _, part in ipairs(getCharParts(char)) do
        MinimizeCfg.savedSizes[part] = {
            Size         = part.Size,
            Transparency = part.Transparency,
            CanCollide   = part.CanCollide,
            CastShadow   = part.CastShadow,
        }
    end
end

local function restoreOriginalSizes(char)
    if not char then return end
    for _, part in ipairs(getCharParts(char)) do
        local saved = MinimizeCfg.savedSizes[part]
        if saved then
            pcall(function()
                part.Size         = saved.Size
                part.Transparency = saved.Transparency
                part.CanCollide   = saved.CanCollide
                part.CastShadow   = saved.CastShadow
            end)
        end
    end
end

local function applyHeadOnly(char)
    if not char then return end
    for _, part in ipairs(getCharParts(char)) do
        pcall(function()
            if part.Name == "Head" then
                part.Transparency = 0
                part.Size         = Vector3.new(2, 2, 2)
                part.CastShadow   = true
                return
            end
            if part.Name == "HumanoidRootPart" then
                part.Transparency = 1
                part.Size         = Vector3.new(0.1, 0.1, 0.1)
                part.CanCollide   = false
                return
            end
            part.Size         = Vector3.new(0.05, 0.05, 0.05)
            part.Transparency = 1
            part.CanCollide   = false
            part.CastShadow   = false
        end)
    end
    for _, acc in ipairs(char:GetChildren()) do
        if acc:IsA("Accessory") then
            local handle = acc:FindFirstChild("Handle")
            if handle then
                pcall(function()
                    handle.Transparency = 1
                    handle.CastShadow   = false
                end)
            end
        end
    end
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Shirt") or item:IsA("Pants") then
            pcall(function() item:Destroy() end)
        end
    end
end

local function applyInvisible(char)
    if not char then return end
    for _, part in ipairs(getCharParts(char)) do
        pcall(function()
            part.Transparency = 1
            part.CastShadow   = false
            if part.Name ~= "HumanoidRootPart" then
                part.Size = Vector3.new(0.05, 0.05, 0.05)
            end
        end)
    end
    for _, acc in ipairs(char:GetChildren()) do
        if acc:IsA("Accessory") then
            local handle = acc:FindFirstChild("Handle")
            if handle then
                pcall(function()
                    handle.Transparency = 1
                    handle.CastShadow   = false
                end)
            end
        end
    end
end

local function applyTinyScale(char, scale)
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local description = humanoid:FindFirstChildOfClass("HumanoidDescription")
    if description then
        pcall(function()
            description.BodyDepthScale  = scale
            description.BodyHeightScale = scale
            description.BodyWidthScale  = scale
            description.HeadScale       = scale
        end)
    end
    for _, part in ipairs(getCharParts(char)) do
        if part.Name ~= "HumanoidRootPart" and part.Name ~= "Head" then
            pcall(function()
                local saved = MinimizeCfg.savedSizes[part]
                if saved then part.Size = saved.Size * scale end
            end)
        end
    end
end

local function applyMinimize()
    local char = lp.Character
    if not char then return end
    saveOriginalSizes(char)
    if MinimizeCfg.mode == "HeadOnly" then
        applyHeadOnly(char)
    elseif MinimizeCfg.mode == "Invisible" then
