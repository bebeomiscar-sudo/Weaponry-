local LureCfg = {
    enabled=false, baitEnabled=false, snapEnabled=false, phantomEnabled=false,
    baitOffsetX=0, baitOffsetY=0, baitOffsetZ=0,
    snapRadius=15, snapDelay=0.05,
    lureTarget=nil, snapTriggered=false, snapCount=0, lastSnapTick=0,
    baitPosition=Vector3.zero,
    lureConn=nil, snapConn=nil, phantomConn=nil,
}

local realPosition = Vector3.zero
local baitPart     = nil

local function createBaitPart()
    if baitPart then pcall(function() baitPart:Destroy() end) end
    local part = Instance.new("Part")
    part.Name=".VoidBait"; part.Size=Vector3.new(0.1,0.1,0.1)
    part.Transparency=1; part.CanCollide=false
    part.Anchored=true; part.CastShadow=false
    part.Parent=Workspace
    baitPart = part
end

local function updateBaitPosition()
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    realPosition = hrp.Position
    LureCfg.baitPosition = realPosition + Vector3.new(
        LureCfg.baitOffsetX, LureCfg.baitOffsetY, LureCfg.baitOffsetZ
    )
    if baitPart then
        pcall(function() baitPart.CFrame = CFrame.new(LureCfg.baitPosition) end)
    end
end

local function startPhantomBeacon()
    if LureCfg.phantomConn then LureCfg.phantomConn:Disconnect(); LureCfg.phantomConn=nil end
    LureCfg.phantomConn = RunService.Heartbeat:Connect(function()
        if not LureCfg.phantomEnabled then return end
        local tgt = LureCfg.lureTarget
        if not tgt then return end
        local tChar = tgt.Character
        if not tChar then return end
        local tHRP = tChar:FindFirstChild("HumanoidRootPart")
        if not tHRP then return end
        pcall(function() tHRP.CFrame = CFrame.new(LureCfg.baitPosition) end)
    end)
end

local function stopPhantomBeacon()
    LureCfg.phantomEnabled = false
    if LureCfg.phantomConn then LureCfg.phantomConn:Disconnect(); LureCfg.phantomConn=nil end
end

local function startSnapTrap()
    if LureCfg.snapConn then LureCfg.snapConn:Disconnect(); LureCfg.snapConn=nil end
    LureCfg.snapConn = RunService.Heartbeat:Connect(function()
        if not LureCfg.snapEnabled then return end
        local now = tick()
        if now - LureCfg.lastSnapTick < 0.5 then return end
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        for _, p in ipairs(Players:GetPlayers()) do
            if p == lp then continue end
            local char = p.Character
            if not char then continue end
            local tHRP = char:FindFirstChild("HumanoidRootPart")
            if not tHRP then continue end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local distReal = (tHRP.Position - realPosition).Magnitude
            local distBait = (tHRP.Position - LureCfg.baitPosition).Magnitude
            if distReal < LureCfg.snapRadius or distBait < LureCfg.snapRadius then
                LureCfg.snapTriggered = true
                LureCfg.snapCount    += 1
                LureCfg.lastSnapTick  = now
                LureCfg.lureTarget    = p
                notify("SNAP TRAP","TRIGGERED on "..p.Name.."!",2)
                task.spawn(function()
                    local savedCF = hrp.CFrame
                    local savedLV = hrp.AssemblyLinearVelocity
                    local savedAV = hrp.AssemblyAngularVelocity
                    pcall(function() hrp.CFrame = tHRP.CFrame end)
                    task.wait(LureCfg.snapDelay)
                    pcall(function()
                        hrp.CFrame = CFrame.new(tHRP.Position.X, VOID_HEIGHT, tHRP.Position.Z)
                    end)
                    task.wait(0.05)
                    if firetouchinterest then
                        local projs = {}
                        for _, v in ipairs(Workspace:GetChildren()) do
                            if v.Name == "CoreProjectile" then table.insert(projs, v) end
                        end
                        local hitboxes = {}
                        for _, name in ipairs({"HitBoxHeadSmall","HitBoxHead","HitBoxBody","Head","UpperTorso"}) do
                            local part = char:FindFirstChild(name)
                            if part then table.insert(hitboxes, part) end
                        end
                        for attempt = 1, 3 do
                            for _, proj in ipairs(projs) do
                                for _, hbox in ipairs(hitboxes) do
                                    pcall(function()
                                        local ti = nil
                                        for _, child in ipairs(proj:GetChildren()) do
                                            if child.ClassName=="TouchTransmitter"
                                            or child.ClassName=="TouchInterest" then
                                                ti=child; break
                                            end
                                        end
                                        if ti then
                                            pcall(firetouchinterest, hbox, ti, 0)
                                            pcall(firetouchinterest, hbox, ti, 1)
                                        end
                                    end)
                                end
                            end
                            if attempt < 3 then task.wait(0.02) end
                        end
                    end
                    pcall(function()
                        hrp.CFrame=savedCF
                        hrp.AssemblyLinearVelocity=savedLV
                        hrp.AssemblyAngularVelocity=savedAV
                    end)
                end)
            end
        end
    end)
end

local function stopSnapTrap()
    LureCfg.snapEnabled = false
    if LureCfg.snapConn then LureCfg.snapConn:Disconnect(); LureCfg.snapConn=nil end
end

local function startLureLoop()
    if LureCfg.lureConn then LureCfg.lureConn:Disconnect(); LureCfg.lureConn=nil end
    createBaitPart()
    LureCfg.lureConn = RunService.Heartbeat:Connect(function()
        if not LureCfg.enabled then return end
        pcall(updateBaitPosition)
        if not LureCfg.lureTarget or not LureCfg.lureTarget.Character then
            LureCfg.lureTarget = nil
            local best, bd = nil, math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p == lp then continue end
                local char = p.Character
                if not char then continue end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum or hum.Health <= 0 then continue end
                local tHRP = char:FindFirstChild("HumanoidRootPart")
                if not tHRP then continue end
                local near = (realPosition - tHRP.Position).Magnitude
                if near < bd then bd=near; best=p end
            end
            LureCfg.lureTarget = best
        end
    end)
end

local function stopLureLoop()
    if LureCfg.lureConn then LureCfg.lureConn:Disconnect(); LureCfg.lureConn=nil end
    stopPhantomBeacon(); stopSnapTrap()
    if baitPart then pcall(function() baitPart:Destroy() end); baitPart=nil end
    LureCfg.enabled = false
end

