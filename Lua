-- =============================================
--   KICIA SIGNATURES
-- =============================================

local kiciaSignatures = {}
local v3FreeSig       = {detected = {}}

local function getOrCreateSig(p)
    if not kiciaSignatures[p] then
        kiciaSignatures[p] = {
            lastHRPY        = 0,
            liftCount       = 0,
            liftTimes       = {},
            avgLiftInterval = 0,
            maxLiftHeight   = 0,
            isPremium       = false,
            isV3Free        = false,
            isV3Premium     = false,
            lastPos         = Vector3.zero,
            posChanges      = {},
            yVariance       = 0,
        }
    end
    return kiciaSignatures[p]
end

local function updateKiciaSignature(p)
    local char = p.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local sig  = getOrCreateSig(p)
    local pos  = hrp.Position
    local absY = math.abs(pos.Y)
    local now  = tick()

    if absY > 50000 and sig.lastHRPY < 50000 then
        sig.liftCount += 1
        table.insert(sig.liftTimes, now)
        if #sig.liftTimes > 10 then table.remove(sig.liftTimes, 1) end
        sig.maxLiftHeight = math.max(sig.maxLiftHeight, absY)
        if #sig.liftTimes >= 2 then
            local total = 0
            for i = 2, #sig.liftTimes do
                total += sig.liftTimes[i] - sig.liftTimes[i-1]
            end
            sig.avgLiftInterval = total / (#sig.liftTimes - 1)
        end
        table.insert(sig.posChanges, absY)
        if #sig.posChanges > 8 then table.remove(sig.posChanges, 1) end
        if #sig.posChanges >= 4 then
            local mean = 0
            for _, v in ipairs(sig.posChanges) do mean += v end
            mean = mean / #sig.posChanges
            local variance = 0
            for _, v in ipairs(sig.posChanges) do variance += (v-mean)^2 end
            sig.yVariance = math.sqrt(variance / #sig.posChanges)
        end
        local isV3Free    = sig.yVariance > 8000 and sig.avgLiftInterval > 0.08
        local isV3Premium = sig.yVariance < 5000 and sig.avgLiftInterval < 0.06 and sig.liftCount >= 5
        local isPremium   = sig.avgLiftInterval < 0.08 or sig.maxLiftHeight > 200000
        sig.isV3Free    = isV3Free
        sig.isV3Premium = isV3Premium
        sig.isPremium   = isPremium
        local versionStr = "Unknown"
        if isV3Premium      then versionStr = "v3 Premium"; AntiKiciaCfg.v3PremDetected = true
        elseif isV3Free     then versionStr = "v3 Free";    AntiKiciaCfg.v3FreeDetected = true
        elseif isPremium    then versionStr = "v2 Premium"
        else                     versionStr = "v2 Free" end
        if sig.liftCount >= 3 then
            AntiKiciaCfg.detectedKicia = true
            AntiKiciaCfg.kiciaTarget   = p
            AntiKiciaCfg.detectedTick  = now
            AntiKiciaCfg.kiciaVersion  = versionStr
            if not AntiKiciaCfg.kiciaHistory[p] then
                AntiKiciaCfg.kiciaHistory[p] = {
                    voidLifts=0, lastLift=0, isKicia=true,
                    isPremium=isPremium, isV3Free=isV3Free,
                    isV3Prem=isV3Premium, version=versionStr,
                }
            end
            AntiKiciaCfg.kiciaHistory[p].voidLifts += 1
            AntiKiciaCfg.kiciaHistory[p].lastLift   = now
            AntiKiciaCfg.kiciaHistory[p].version    = versionStr
        end
    end
    sig.lastHRPY = absY
    sig.lastPos  = pos
end

local function analyzeV3FreeOffset(p)
    local char = p.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local pos  = hrp.Position
    local absY = math.abs(pos.Y)
    if not v3FreeSig.detected[p] then
        v3FreeSig.detected[p] = {
            liftPositions = {},
            liftCount     = 0,
            isV3Free      = false,
        }
    end
    local sig = v3FreeSig.detected[p]
    if absY > 50000 then
        sig.liftCount += 1
        table.insert(sig.liftPositions, {pos=pos, time=tick(), absY=absY})
        if #sig.liftPositions > 10 then table.remove(sig.liftPositions, 1) end
        if #sig.liftPositions >= 3 then
            local yValues, xOffsets, zOffsets = {}, {}, {}
            for i = 2, #sig.liftPositions do
                local prev = sig.liftPositions[i-1]
                local curr = sig.liftPositions[i]
                table.insert(yValues, curr.absY)
                table.insert(xOffsets, math.abs(curr.pos.X - prev.pos.X))
                table.insert(zOffsets, math.abs(curr.pos.Z - prev.pos.Z))
            end
            local yMean = 0
            for _, v in ipairs(yValues) do yMean += v end
            yMean = yMean / #yValues
            local yVariance = 0
            for _, v in ipairs(yValues) do yVariance += (v-yMean)^2 end
            yVariance = yVariance / #yValues
            local xMean = 0
            for _, v in ipairs(xOffsets) do xMean += v end
            xMean = xMean / math.max(#xOffsets,1)
            local zMean = 0
            for _, v in ipairs(zOffsets) do zMean += v end
            zMean = zMean / math.max(#zOffsets,1)
            sig.isV3Free = math.sqrt(yVariance) > 10000 or (xMean > 50000 and zMean > 50000)
        end
    end
end

