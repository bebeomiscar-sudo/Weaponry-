-- ═══════════════════════════════════════════
-- UPDATE UI STATE
-- ═══════════════════════════════════════════
local function updateUI()
    local isOn = autoDunkEnabled

    -- Status box
    tween(StatusDot,   {BackgroundColor3 = isOn and THEME.ON or THEME.OFF},    0.2)
    tween(StatusLabel, {TextColor3       = isOn and THEME.ON or THEME.OFF},    0.2)
    StatusLabel.Text = "Auto Dunk: " .. (isOn and "ON" or "OFF")

    -- Toggle button pill (PC only)
    if not isMobile and ToggleButton then
        local pill  = ToggleButton:FindFirstChild("Pill")
        local knob  = pill and pill:FindFirstChild("Knob")
        if pill then
            tween(pill, {BackgroundColor3 = isOn and THEME.ON or THEME.OFF}, 0.2)
        end
        if knob then
            tween(knob, {Position = isOn
                and UDim2.new(1, -19, 0.5, -8)
                or  UDim2.new(0, 3,   0.5, -8)
            }, 0.2)
        end
        if ToggleLabel then
            ToggleLabel.Text = isOn and "Disable Auto Dunk" or "Enable Auto Dunk"
        end
    end
end

-- ═══════════════════════════════════════════
-- GAME LOGIC HELPERS
-- ═══════════════════════════════════════════
local function getCharacter()
    if Player_Client and Player_Client.GetLocalPlayerCharacter then
        return Player_Client.GetLocalPlayerCharacter()
    end
    return LocalPlayer.Character
end

local function getHumanoid()
    local char = getCharacter()
    if not char then return nil end
    return char:FindFirstChildOfClass("Humanoid")
end

local function getMoveVector()
    if Controls and Controls.GetMoveVector then
        return Controls:GetMoveVector()
    end
    return Vector3.new(0, 0, 0)
end

-- ═══════════════════════════════════════════
-- CANCEL AUTO
-- ═══════════════════════════════════════════
local function CancelAuto()
    local char = getCharacter()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hum and hrp then
        hum:MoveTo(hrp.Position + Vector3.new(0, 0, 0.5))
    end
end

-- ═══════════════════════════════════════════
-- AUTO DUNK
-- ═══════════════════════════════════════════
local function Auto()
    if not autoDunkEnabled then return end
    totalAttempts = totalAttempts + 1
    updateStats()

    local ok, zone = pcall(function()
        return Network:InvokeServer("Jump.FindClosestZone")
    end)
    if not ok or not zone then return end

    local hum = getHumanoid()
    if not hum then return end

    if Player_Client and Player_Client.WalkLocalPlayerCharacterToPart then
        pcall(function()
            Player_Client.WalkLocalPlayerCharacterToPart(zone.PrimaryPart)
        end)
    else
        if zone.PrimaryPart then
            hum:MoveTo(zone.PrimaryPart.Position)
        end
    end

    hum.MoveToFinished:Wait()
    task.wait(0.5)

    if autoDunkEnabled then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        totalDunks = totalDunks + 1
        updateStats()

        -- Flash status green briefly
        tween(StatusBox, {BackgroundColor3 = Color3.fromRGB(30, 60, 40)}, 0.1)
        task.delay(0.3, function()
            tween(StatusBox, {BackgroundColor3 = THEME.PanelAlt}, 0.3)
        end)
    end
end

-- ═══════════════════════════════════════════
-- SETUP HUMANOID STATE LISTENER
-- ═══════════════════════════════════════════
local function SetupHumanoid(char)
    if humanoidStateConn then
        humanoidStateConn:Disconnect()
        humanoidStateConn = nil
    end

    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end

    humanoidStateConn = hum.StateChanged:Connect(function(oldState, newState)
        if oldState == Enum.HumanoidStateType.Freefall
        and newState == Enum.HumanoidStateType.Landed
        and autoDunkEnabled then
            task.spawn(Auto)
        end
    end)
end

-- ═══════════════════════════════════════════
-- TOGGLE (PC)
-- ═══════════════════════════════════════════
local function Toggle()
    if isMobile then return end  -- mobile is always on, no toggle
    autoDunkEnabled = not autoDunkEnabled

    if autoDunkEnabled then
        task.spawn(Auto)
    else
        task.spawn(CancelAuto)
    end

    updateUI()

    pcall(function()
        Network:FireServer("Player.ToggleAutoDunk", autoDunkEnabled)
    end)
end

-- ═══════════════════════════════════════════
-- WIRE TOGGLE BUTTON
-- ═══════════════════════════════════════════
if not isMobile and ToggleButton then
    ToggleButton.MouseButton1Click:Connect(Toggle)
end

-- ═══════════════════════════════════════════
-- PC KEYBIND — F to toggle
-- ═══════════════════════════════════════════
if not isMobile then
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.F then
            Toggle()
        end
    end)
end

-- ═══════════════════════════════════════════
-- MOVE WATCHER — cancel if player moves (PC)
-- ═══════════════════════════════════════════
if not isMobile then
    RunService.Heartbeat:Connect(function()
        if not autoDunkEnabled then return end
        local mv = getMoveVector()
        if math.abs(mv.X) > 0.1 or math.abs(mv.Z) > 0.1 then
            Toggle()
        end
    end)
end

-- ═══════════════════════════════════════════
-- INIT
-- ═══════════════════════════════════════════
local function Init()
    local char = LocalPlayer.Character
    if char then SetupHumanoid(char) end

    LocalPlayer.CharacterAdded:Connect(function(newChar)
        task.wait(0.1)
        SetupHumanoid(newChar)
    end)

    -- Mobile: always enable and keep enabled
    if isMobile then
        autoDunkEnabled = true
        updateUI()
        pcall(function()
            Network:FireServer("Player.ToggleAutoDunk", true)
        end)
        task.spawn(Auto)

        -- Make sure it stays on after respawn
        LocalPlayer.CharacterAdded:Connect(function()
            task.wait(0.5)
            if not autoDunkEnabled then
                autoDunkEnabled = true
                updateUI()
            end
            task.spawn(Auto)
        end)
    end

    updateUI()
    updateStats()
    print("[AutoDunk] Initialized |", isMobile and "Mobile (always on)" or "PC (toggle with F)")
end

task.spawn(Init)

return {}
